+    let addr = listener.local_addr().expect("fixture listener address");
+    let app = Router::new()
+        .route("/ws/chat", get(crate::ws::handle_ws_chat))
+        .with_state(state);
+    let handle = ::zeroclaw_spawn::spawn!(async move {
+        let _ = axum::serve(listener, app).await;
+    });
