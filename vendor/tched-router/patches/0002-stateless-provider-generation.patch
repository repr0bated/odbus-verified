+        )?;
+        self.binding.admit(&self.security)?;
+        let identity = sled_identity::current()?;
+        identity.reverify().await?;
+        let fresh = helper(
+            &self.binding,
+            &self.security,
+            self.sandbox.as_ref(),
+            "describe",
+            None,
+            None,
+            false,
+        )
+        .await?;
+        ensure!(
+            fresh
+                .get("methods")
+                .and_then(Value::as_array)
+                .is_some_and(|methods| methods.iter().any(|item| item
+                    .get("path")
+                    .and_then(Value::as_str)
+                    == Some(&self.path)
+                    && item.get("declaration") == Some(&self.declaration))),
+            "mounted operation contract changed; rediscover before calling"
+        );
+        let mutation = self.declaration.get("side_effect").and_then(Value::as_str) != Some("read");
+        self.security
+            .enforce_tool_operation(
+                if mutation {
+                    ToolOperation::Act
+                } else {
+                    ToolOperation::Read
+                },
+                &self.name,
+            )
+            .map_err(anyhow::Error::msg)?;
+        let receipt = helper(
+            &self.binding,
+            &self.security,
+            self.sandbox.as_ref(),
+            "invoke",
+            Some(&self.path),
+            Some(&args),
+            mutation,
+        )
+        .await?;
+        identity.reverify().await.context(
+            "mounted invocation produced a receipt but caller verification failed; do not retry",
+        )?;
+        Ok(ToolResult {
+            success: true,
+            output: ToolOutput::json(receipt),
+            error: None,
+        })
+    }
+}
+async fn helper(
+    binding: &Binding,
+    security: &SecurityPolicy,
+    sandbox: &dyn Sandbox,
+    command: &str,
+    path: Option<&str>,
+    args: Option<&Value>,
+    mutation: bool,
+) -> Result<Value> {
+    binding.admit(security)?;
+    // Explicit opt-in for this protected fixed executable, not generic shell.
+    // Describe is read-only; invoke gets Read only from the fresh mounted method.
+    if std::env::var(READ_HELPER).as_deref() == Ok("1") && !mutation {
+        ensure!(
+            command == "describe" || command == "invoke",
+            "unsupported read helper operation"
+        );
