+            selected_tools.push((
+                name.clone(),
+                Arc::new(FilesystemTool {
+                    binding: self.binding.clone(),
+                    security: self.security.clone(),
+                    sandbox: self.sandbox.clone(),
+                    name,
+                    path,
+                    declaration: declaration.clone(),
+                    description: format!(
+                        "{plugin}.{method}: execute through your identity-bound 3tchedFS mount."
+                    ),
+                }) as Arc<dyn Tool>,
