+fn request(url: &str, authenticated: bool) -> tokio_tungstenite::tungstenite::http::Request<()> {
+    let mut request = url
+        .into_client_request()
+        .expect("valid fixture websocket URL");
+    request.headers_mut().insert(
+        "sec-websocket-protocol",
+        "tched_router.generation.v1"
+            .parse()
+            .expect("valid websocket protocol"),
+    );
+    if authenticated {
+        request.headers_mut().insert(
+            "authorization",
+            format!("Bearer {TEST_TOKEN}")
+                .parse()
+                .expect("valid test bearer header"),
+        );
+        request.headers_mut().insert(
+            zeroclaw_providers::sled_identity::SEALED_ID_HEADER,
+            TEST_SEALED_ID.parse().expect("valid fixture SID1 header"),
+        );
+    }
+    request
+}
+
+async fn connect(url: &str) -> ClientSocket {
+    let (socket, response) = timeout(FRAME_TIMEOUT, connect_async(request(url, true)))
+        .await
+        .expect("websocket upgrade must not hang")
+        .expect("fixture websocket upgrade must succeed");
+    assert_eq!(
+        response
+            .headers()
+            .get("sec-websocket-protocol")
+            .and_then(|value| value.to_str().ok()),
+        Some("tched_router.generation.v1"),
+        "the gateway must acknowledge the required protocol"
+    );
+    socket
+}
+
+async fn receive_json<S>(socket: &mut S) -> Value
+where
+    S: Stream<Item = Result<Message, WsError>> + Unpin,
+{
+    let message = timeout(FRAME_TIMEOUT, socket.next())
+        .await
+        .expect("server frame must not hang")
+        .expect("server must send a frame")
+        .expect("server websocket frame must be valid");
+    let Message::Text(text) = message else {
+        panic!("expected JSON text frame, received {message:?}");
+    };
+    serde_json::from_str(&text).expect("server frame must be JSON")
+}
+
+async fn send_json(socket: &mut ClientSocket, value: Value) {
+    timeout(
+        FRAME_TIMEOUT,
+        socket.send(Message::Text(value.to_string().into())),
+    )
+    .await
+    .expect("client send must not hang")
+    .expect("client websocket send must succeed");
+}
+
+async fn assert_rejected(url: &str, expected_status: u16) {
+    match timeout(FRAME_TIMEOUT, connect_async(request(url, true)))
+        .await
+        .expect("rejected websocket handshake must not hang")
+    {
+        Err(WsError::Http(response)) => assert_eq!(response.status().as_u16(), expected_status),
+        other => panic!("expected HTTP rejection, got {other:?}"),
+    }
+}
