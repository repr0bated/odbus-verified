@@ -0,0 +1,276 @@
+//! Verification bridge for identity-sled-authored SID1 credentials.
+//!
+//! Native code treats the credential as opaque. Authority remains in the
+//! OP-DBUS MCP door, which validates the current sled/session/revocation state.
+
+use anyhow::{Context, Result, bail};
+use futures_util::StreamExt;
+use reqwest::{Client, Url, redirect::Policy};
+use serde_json::json;
+use std::{future::Future, net::IpAddr, sync::Arc, time::Duration};
+
+pub const SEALED_ID_HEADER: &str = "x-opdbus-sealed-id-bin";
+pub const AUTHENTICATED_IDENTITY: &str = "SID1";
+pub const VERIFIED_PRINCIPAL_HEADER: &str = "x-opdbus-verified-principal";
+pub const VERIFIED_SESSION_HEADER: &str = "x-opdbus-verified-session";
+pub const VERIFIED_GENESIS_HEADER: &str = "x-opdbus-verified-genesis";
+const AUTH_URL_ENV: &str = "OPDBUS_SLED_AUTH_URL";
+const CA_FILE_ENV: &str = "OPDBUS_SLED_CA_FILE";
+const MAX_AUTH_RESPONSE_BYTES: usize = 64 * 1024;
+const AUTH_TIMEOUT: Duration = Duration::from_secs(10);
+
+tokio::task_local! {
+    static VERIFIED_IDENTITY: VerifiedSledIdentity;
+}
+
+#[derive(Clone)]
+pub struct VerifiedSledIdentity {
+    sealed_id: Arc<str>,
+    claims: VerifiedSledClaims,
+}
+
+/// Nonsecret receiver claims. Only VerifiedSledIdentity authenticates them;
+/// constructing this data alone never installs a verified task-local context.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedSledClaims {
+    pub principal_id: String,
+    pub session_id: String,
+    pub session_genesis: String,
+}
+
+fn response_claims(headers: &reqwest::header::HeaderMap) -> Result<VerifiedSledClaims> {
+    fn one(headers: &reqwest::header::HeaderMap, name: &str) -> Result<String> {
+        let mut values = headers.get_all(name).iter();
+        let value = values
+            .next()
+            .context("verified receiver claims are required")?;
+        if values.next().is_some() {
+            bail!("ambiguous verified receiver claims");
+        }
+        Ok(value
+            .to_str()
+            .context("invalid verified receiver claims")?
+            .to_owned())
+    }
+    let claims = VerifiedSledClaims {
+        principal_id: one(headers, VERIFIED_PRINCIPAL_HEADER)?,
+        session_id: one(headers, VERIFIED_SESSION_HEADER)?,
+        session_genesis: one(headers, VERIFIED_GENESIS_HEADER)?,
+    };
+    for id in [&claims.principal_id, &claims.session_id] {
+        if uuid::Uuid::parse_str(id)
+            .map(|id| id.to_string())
+            .ok()
+            .as_ref()
+            != Some(id)
+        {
+            bail!("verified receiver identity is not canonical");
+        }
+    }
+    if claims.session_genesis.len() != 64
+        || !claims
+            .session_genesis
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        bail!("verified receiver genesis is not canonical");
+    }
+    Ok(claims)
+}
+
+impl VerifiedSledIdentity {
+    pub async fn verify(sealed_id: &str) -> Result<Self> {
+        validate_opaque_credential(sealed_id)?;
+        let claims = Self::verify_receiver(sealed_id).await?;
+        Ok(Self {
+            sealed_id: Arc::from(sealed_id),
+            claims,
+        })
+    }
+
+    pub fn claims(&self) -> &VerifiedSledClaims {
+        &self.claims
+    }
+
+    pub async fn reverify(&self) -> Result<()> {
+        #[cfg(test)]
+        if self.sealed_id.as_ref() == "U0lEMQ_native-fixture" {
+            return Ok(());
+        }
+        let fresh = Self::verify_receiver(&self.sealed_id).await?;
+        if fresh != self.claims {
+            bail!("verified sled identity binding changed");
+        }
+        Ok(())
+    }
+
+    async fn verify_receiver(sealed_id: &str) -> Result<VerifiedSledClaims> {
+        let auth_url = std::env::var(AUTH_URL_ENV)
+            .with_context(|| format!("{AUTH_URL_ENV} is required for SID1 verification"))?;
+        let url = Url::parse(&auth_url).context("OP-DBUS sled auth URL is invalid")?;
+        let literal_ip = url
+            .host_str()
+            .and_then(|host| host.parse::<IpAddr>().ok())
+            .is_some();
+        if url.scheme() != "https"
+            || !literal_ip
+            || url.port().is_none()
+            || url.username() != ""
+            || url.password().is_some()
+            || url.path() != "/mcp"
+            || url.query().is_some()
+            || url.fragment().is_some()
+        {
+            bail!(
+                "OP-DBUS sled auth URL must be an HTTPS literal-IP /mcp URL with an explicit port and no credentials, query, or fragment"
+            );
+        }
+        let ca_file = std::env::var(CA_FILE_ENV)
+            .with_context(|| format!("{CA_FILE_ENV} is required for SID1 verification"))?;
+        let ca_pem = std::fs::read(&ca_file).context("failed to read OP-DBUS sled CA file")?;
+        let certificate = reqwest::Certificate::from_pem(&ca_pem)
+            .context("OP-DBUS sled CA file is not a PEM certificate")?;
+        let client = Client::builder()
+            .redirect(Policy::none())
+            .timeout(AUTH_TIMEOUT)
+            .add_root_certificate(certificate)
+            .build()
+            .context("failed to build OP-DBUS sled auth client")?;
+        let response = client
+            .post(url)
+            .header(SEALED_ID_HEADER, sealed_id)
+            .header("accept", "application/json, text/event-stream")
+            .header("mcp-protocol-version", "2025-06-18")
+            .json(&json!({
+                "jsonrpc": "2.0",
+                "id": "sled-auth",
+                "method": "ping",
+                "params": {}
+            }))
+            .send()
+            .await
+            .context("OP-DBUS sled auth request failed")?;
+        if !response.status().is_success() {
+            bail!("OP-DBUS sled auth rejected the credential");
+        }
+        let claims = response_claims(response.headers())?;
+        let mut body = Vec::new();
+        let mut stream = response.bytes_stream();
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk.context("failed while reading OP-DBUS sled auth response")?;
+            if body.len().saturating_add(chunk.len()) > MAX_AUTH_RESPONSE_BYTES {
+                bail!("OP-DBUS sled auth response exceeded its size limit");
+            }
+            body.extend_from_slice(&chunk);
+        }
+        let value: serde_json::Value =
+            serde_json::from_slice(&body).context("OP-DBUS sled auth returned invalid JSON")?;
+        if value.get("jsonrpc").and_then(serde_json::Value::as_str) != Some("2.0")
+            || value.get("id").and_then(serde_json::Value::as_str) != Some("sled-auth")
+            || value.get("error").is_some()
+            || value.get("result").is_none()
+        {
+            bail!("OP-DBUS sled auth returned an invalid ping response");
+        }
+        Ok(claims)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn native_fixture() -> Self {
+        Self {
+            sealed_id: Arc::from("U0lEMQ_native-fixture"),
+            claims: VerifiedSledClaims {
+                principal_id: "11111111-1111-1111-1111-111111111111".into(),
+                session_id: "22222222-2222-2222-2222-222222222222".into(),
+                session_genesis: "a".repeat(64),
+            },
+        }
+    }
+
+    pub async fn scope<F: Future>(&self, future: F) -> F::Output {
+        VERIFIED_IDENTITY.scope(self.clone(), future).await
+    }
+}
+
+pub fn current() -> Result<VerifiedSledIdentity> {
+    VERIFIED_IDENTITY
+        .try_with(Clone::clone)
+        .context("verified SID1 context is required for native inference")
+}
+
+fn validate_opaque_credential(value: &str) -> Result<()> {
+    if value.is_empty()
+        || value.len() > 64 * 1024
+        || value.contains('=')
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+    {
+        bail!("sealed identity credential must be unpadded base64url");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn claim_headers() -> reqwest::header::HeaderMap {
+        let mut headers = reqwest::header::HeaderMap::new();
+        headers.insert(
+            VERIFIED_PRINCIPAL_HEADER,
+            "11111111-1111-1111-1111-111111111111".parse().unwrap(),
+        );
+        headers.insert(
+            VERIFIED_SESSION_HEADER,
+            "22222222-2222-2222-2222-222222222222".parse().unwrap(),
+        );
+        headers.insert(VERIFIED_GENESIS_HEADER, "a".repeat(64).parse().unwrap());
+        headers
+    }
+
+    #[test]
+    fn verified_receiver_claims_require_complete_unambiguous_canonical_metadata() {
+        let valid = claim_headers();
+        assert_eq!(
+            response_claims(&valid).unwrap().session_id,
+            "22222222-2222-2222-2222-222222222222"
+        );
+        for name in [
+            VERIFIED_PRINCIPAL_HEADER,
+            VERIFIED_SESSION_HEADER,
+            VERIFIED_GENESIS_HEADER,
+        ] {
+            let mut missing = valid.clone();
+            missing.remove(name);
+            assert!(response_claims(&missing).is_err());
+            let mut duplicate = valid.clone();
+            duplicate.append(name, valid[name].clone());
+            assert!(response_claims(&duplicate).is_err());
+            let mut malformed = valid.clone();
+            malformed.insert(name, "foreign,ambiguous".parse().unwrap());
+            assert!(response_claims(&malformed).is_err());
+        }
+    }
+
+    #[tokio::test]
+    async fn verified_receiver_context_is_task_scoped_and_never_spawn_inherited() {
+        assert!(current().is_err());
+        let fixture = VerifiedSledIdentity::native_fixture();
+        fixture
+            .scope(async {
+                assert_eq!(current().unwrap().claims(), fixture.claims());
+                assert!(tokio::spawn(async { current().is_err() }).await.unwrap());
+            })
+            .await;
+        assert!(current().is_err());
+    }
+
+    #[test]
+    fn opaque_credential_shape_is_fail_closed() {
+        assert!(validate_opaque_credential("U0lEMQ_test-opaque").is_ok());
+        for invalid in ["", "padded=", "spaces are forbidden", "slash/forbidden"] {
+            assert!(validate_opaque_credential(invalid).is_err());
+        }
+    }
+}
