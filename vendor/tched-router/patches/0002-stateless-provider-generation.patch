--- a/crates/zeroclaw-providers/src/opencode_session.rs
+++ b/crates/zeroclaw-providers/src/opencode_session.rs
@@ -0,0 +1,1092 @@
+//! Local OpenCode server transport for inference authenticated by OpenCode's
+//! own provider/OAuth store. Each call uses a disposable, deny-all session.
+
+use crate::{ChatMessage, ChatRequest, ChatResponse, ModelProvider};
+use anyhow::{Context, Result, bail};
+use async_trait::async_trait;
+use futures_util::StreamExt;
+use reqwest::{Client, Response, Url, redirect::Policy};
+use serde::{Deserialize, Serialize, de::DeserializeOwned};
+use std::{collections::HashSet, net::IpAddr, time::Duration};
+use zeroclaw_api::{
+    attribution::{Attributable, ModelProviderKind, ProviderKind, Role},
+    model_provider::{ModelInfo, ModelPricing},
+};
+
+const OPENCODE_USERNAME: &str = "opencode";
+const SESSION_TITLE: &str = "OP-DBUS completion";
+const COMPLETION_AGENT: &str = "opdbus-completion";
+const MAX_RESPONSE_BYTES: usize = 1024 * 1024;
+const MAX_CATALOG_RESPONSE_BYTES: usize = 16 * 1024 * 1024;
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(600);
+
+#[derive(Clone)]
+pub struct OpenCodeSessionModelProvider {
+    alias: String,
+    base_url: Url,
+    password: String,
+    client: Client,
+}
+
+impl OpenCodeSessionModelProvider {
+    pub fn new(alias: &str, base_url: &str, password: &str) -> Result<Self> {
+        let mut parsed = Url::parse(base_url).context("OpenCode session URI is invalid")?;
+        let host = parsed
+            .host_str()
+            .and_then(|value| value.parse::<IpAddr>().ok())
+            .filter(IpAddr::is_loopback)
+            .context("OpenCode session URI must use a literal loopback address")?;
+        if parsed.scheme() != "http"
+            || parsed.port().is_none()
+            || !host.is_loopback()
+            || parsed.username() != ""
+            || parsed.password().is_some()
+            || parsed.query().is_some()
+            || parsed.fragment().is_some()
+            || !matches!(parsed.path(), "" | "/")
+        {
+            bail!(
+                "OpenCode session URI must be an http:// loopback address with an explicit port and no path, credentials, query, or fragment"
+            );
+        }
+        let password = password.trim();
+        if password.is_empty() {
+            bail!("OpenCode session transport requires the local server password in api_key");
+        }
+        parsed.set_path("/");
+        let client = Client::builder()
+            .redirect(Policy::none())
+            .timeout(REQUEST_TIMEOUT)
+            .build()
+            .context("failed to build OpenCode session HTTP client")?;
+        Ok(Self {
+            alias: alias.to_string(),
+            base_url: parsed,
+            password: password.to_string(),
+            client,
+        })
+    }
+
+    fn endpoint(&self, segments: &[&str]) -> Result<Url> {
+        let mut url = self.base_url.clone();
+        {
+            let mut path = url
+                .path_segments_mut()
+                .map_err(|()| anyhow::Error::msg("OpenCode session URI cannot be a base URL"))?;
+            path.clear();
+            for segment in segments {
+                path.push(segment);
+            }
+        }
+        Ok(url)
+    }
+
+    fn authenticated(&self, request: reqwest::RequestBuilder) -> reqwest::RequestBuilder {
+        request.basic_auth(OPENCODE_USERNAME, Some(&self.password))
+    }
+
+    async fn bounded_json<T: DeserializeOwned>(response: Response) -> Result<T> {
+        Self::bounded_json_with_limit(response, MAX_RESPONSE_BYTES).await
+    }
+
+    async fn bounded_json_with_limit<T: DeserializeOwned>(
+        response: Response,
+        limit: usize,
+    ) -> Result<T> {
+        let status = response.status();
+        if response
+            .content_length()
+            .is_some_and(|length| length > limit as u64)
+        {
+            bail!(
+                "OpenCode response exceeds the {} MiB limit",
+                limit / (1024 * 1024)
+            );
+        }
+        let mut stream = response.bytes_stream();
+        let mut bytes = Vec::new();
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk.context("failed while reading OpenCode response")?;
+            if bytes.len().saturating_add(chunk.len()) > limit {
+                bail!(
+                    "OpenCode response exceeds the {} MiB limit",
+                    limit / (1024 * 1024)
+                );
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        if !status.is_success() {
+            let detail = serde_json::from_slice::<serde_json::Value>(&bytes)
+                .ok()
+                .and_then(|value| {
+                    value
+                        .pointer("/data/message")
+                        .or_else(|| value.get("message"))
+                        .and_then(serde_json::Value::as_str)
+                        .map(str::to_string)
+                })
+                .unwrap_or_else(|| "request failed".to_string());
+            bail!("OpenCode request failed with {status}: {detail}");
+        }
+        serde_json::from_slice(&bytes).context("OpenCode returned invalid JSON")
+    }
+
+    async fn create_session(
+        &self,
+        identity: &crate::sled_identity::VerifiedSledIdentity,
+    ) -> Result<SessionLease> {
+        let url = self.endpoint(&["session"])?;
+        let request = SessionCreateRequest {
+            title: SESSION_TITLE,
+            permission: vec![PermissionRule {
+                permission: "*",
+                pattern: "*",
+                action: "deny",
+            }],
+        };
+        identity.reverify().await?;
+        let response = self
+            .authenticated(self.client.post(url))
+            .json(&request)
+            .send()
+            .await
+            .context("failed to create OpenCode session")?;
+        let session: SessionResponse = Self::bounded_json(response).await?;
+        if !valid_session_id(&session.id) {
+            bail!("OpenCode returned an invalid session id");
+        }
+        Ok(SessionLease {
+            provider: self.clone(),
+            session_id: session.id,
+            cleaned: false,
+        })
+    }
+
+    async fn generate_owned(
+        self,
+        identity: crate::sled_identity::VerifiedSledIdentity,
+        messages: Vec<ChatMessage>,
+        model: String,
+    ) -> Result<ChatResponse> {
+        let (provider_id, model_id) = split_model(&model)?;
+        let (system, prompt) = encode_messages(&messages)?;
+        let mut lease = self.create_session(&identity).await?;
+        let url = self.endpoint(&["session", &lease.session_id, "message"])?;
+        let request = MessageRequest {
+            model: MessageModel {
+                provider_id,
+                model_id,
+            },
+            agent: COMPLETION_AGENT,
+            system,
+            tools: serde_json::json!({"*": false}),
+            parts: vec![TextPartInput {
+                part_type: "text",
+                text: prompt,
+            }],
+        };
+        let result = async {
+            identity.reverify().await?;
+            let response = self
+                .authenticated(self.client.post(url))
+                .json(&request)
+                .send()
+                .await
+                .context("failed to send OpenCode message")?;
+            let output: MessageResponse = Self::bounded_json(response).await?;
+            validate_message_response(output, provider_id, model_id)
+        }
+        .await;
+        let cleanup = lease.cleanup(false).await;
+        match (result, cleanup) {
+            (Ok(response), Ok(())) => Ok(response),
+            (Err(error), _) => Err(error),
+            (Ok(_), Err(error)) => Err(error.context("OpenCode session cleanup failed")),
+        }
+    }
+
+    async fn list_model_info(&self) -> Result<Vec<ModelInfo>> {
+        crate::sled_identity::current()?.reverify().await?;
+        let response = self
+            .authenticated(self.client.get(self.endpoint(&["provider"])?))
+            .send()
+            .await
+            .context("failed to list OpenCode providers")?;
+        let catalog: ProviderCatalog =
+            Self::bounded_json_with_limit(response, MAX_CATALOG_RESPONSE_BYTES).await?;
+        let connected: HashSet<&str> = catalog.connected.iter().map(String::as_str).collect();
+        let mut models = Vec::new();
+        for provider in catalog.all {
+            if provider.id == "openrouter" || !connected.contains(provider.id.as_str()) {
+                continue;
+            }
+            for (model_id, model) in provider.models {
+                if model.provider_id != provider.id
+                    || model.id != model_id
+                    || invalid_provider_id(&provider.id)
+                    || invalid_model_id(&model_id)
+                {
+                    continue;
+                }
+                models.push(ModelInfo {
+                    id: format!("{}/{}", provider.id, model_id),
+                    pricing: Some(ModelPricing {
+                        prompt: rate_per_token(model.cost.input),
+                        completion: rate_per_token(model.cost.output),
+                        input_cache_read: rate_per_token(model.cost.cache.read),
+                        input_cache_write: rate_per_token(model.cost.cache.write),
+                    }),
+                    context_window: model
+                        .limit
+                        .context
+                        .and_then(|value| usize::try_from(value).ok()),
+                });
+            }
+        }
+        models.sort_by(|left, right| left.id.cmp(&right.id));
+        models.dedup_by(|left, right| left.id == right.id);
+        Ok(models)
+    }
+}
+
+fn invalid_provider_id(value: &str) -> bool {
+    value.trim().is_empty() || value.contains('/') || value.chars().any(char::is_control)
+}
+
+fn invalid_model_id(value: &str) -> bool {
+    value.trim().is_empty() || value.chars().any(char::is_control)
+}
+
+fn rate_per_token(value: Option<f64>) -> Option<String> {
+    value
+        .filter(|rate| rate.is_finite() && *rate >= 0.0)
+        .map(|rate| {
+            let rendered = format!("{:.12}", rate / 1_000_000.0);
+            let trimmed = rendered
+                .trim_end_matches('0')
+                .trim_end_matches('.')
+                .to_string();
+            if trimmed.is_empty() {
+                "0".to_string()
+            } else {
+                trimmed
+            }
+        })
+}
+
+fn split_model(model: &str) -> Result<(&str, &str)> {
+    let (provider_id, model_id) = model
+        .split_once('/')
+        .context("OpenCode model must be providerID/modelID")?;
+    if invalid_provider_id(provider_id) || invalid_model_id(model_id) {
+        bail!("OpenCode model must be providerID/modelID");
+    }
+    Ok((provider_id, model_id))
+}
+
+fn encode_messages(messages: &[ChatMessage]) -> Result<(Option<String>, String)> {
+    let system = messages
+        .iter()
+        .filter(|message| message.role == "system")
+        .map(|message| message.content.as_str())
+        .filter(|content| !content.is_empty())
+        .collect::<Vec<_>>()
+        .join("\n\n");
+    let turns: Vec<&ChatMessage> = messages
+        .iter()
+        .filter(|message| message.role != "system")
+        .collect();
+    if turns.is_empty() {
+        bail!("OpenCode request requires at least one non-system message");
+    }
+    let prompt = if turns.len() == 1 && turns[0].role == "user" {
+        turns[0].content.clone()
+    } else {
+        turns
+            .iter()
+            .map(|message| format!("{}:\n{}", message.role.to_uppercase(), message.content))
+            .collect::<Vec<_>>()
+            .join("\n\n")
+    };
+    if prompt.trim().is_empty() {
+        bail!("OpenCode request prompt is empty");
+    }
+    Ok(((!system.is_empty()).then_some(system), prompt))
+}
+
+fn validate_message_response(
+    response: MessageResponse,
+    provider_id: &str,
+    model_id: &str,
+) -> Result<ChatResponse> {
+    if response.info.provider_id != provider_id || response.info.model_id != model_id {
+        bail!("OpenCode response model attribution did not match the request");
+    }
+    if response.info.error.is_some() {
+        bail!("OpenCode reported an inference error");
+    }
+    if response
+        .parts
+        .iter()
+        .any(|part| matches!(part.part_type.as_str(), "tool" | "subtask" | "agent"))
+    {
+        bail!("OpenCode response attempted tool or agent execution");
+    }
+    let text = response
+        .parts
+        .into_iter()
+        .filter(|part| part.part_type == "text")
+        .filter_map(|part| part.text)
+        .collect::<Vec<_>>()
+        .join("");
+    if text.trim().is_empty() {
+        bail!("OpenCode response contained no text");
+    }
+    let usage = response
+        .info
+        .tokens
+        .map(|tokens| zeroclaw_api::model_provider::TokenUsage {
+            input_tokens: number_to_u64(tokens.input),
+            output_tokens: number_to_u64(tokens.output),
+            cached_input_tokens: tokens.cache.and_then(|cache| number_to_u64(cache.read)),
+        });
+    Ok(ChatResponse {
+        text: Some(text),
+        tool_calls: Vec::new(),
+        usage,
+        reasoning_content: None,
+    })
+}
+
+fn number_to_u64(value: f64) -> Option<u64> {
+    (value.is_finite() && value >= 0.0 && value <= u64::MAX as f64).then_some(value as u64)
+}
+
+fn valid_session_id(value: &str) -> bool {
+    value.starts_with("ses")
+        && value.len() <= 256
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+}
+
+struct SessionLease {
+    provider: OpenCodeSessionModelProvider,
+    session_id: String,
+    cleaned: bool,
+}
+
+impl SessionLease {
+    async fn cleanup(&mut self, abort: bool) -> Result<()> {
+        if self.cleaned {
+            return Ok(());
+        }
+        self.provider
+            .cleanup_session(&self.session_id, abort)
+            .await?;
+        self.cleaned = true;
+        Ok(())
+    }
+}
+
+impl OpenCodeSessionModelProvider {
+    async fn cleanup_session(&self, session_id: &str, abort: bool) -> Result<()> {
+        if abort {
+            let _ = self
+                .authenticated(
+                    self.client
+                        .post(self.endpoint(&["session", session_id, "abort"])?),
+                )
+                .send()
+                .await;
+        }
+        let response = self
+            .authenticated(self.client.delete(self.endpoint(&["session", session_id])?))
+            .send()
+            .await
+            .context("failed to delete OpenCode session")?;
+        if !response.status().is_success() {
+            bail!("OpenCode session delete failed with {}", response.status());
+        }
+        Ok(())
+    }
+}
+
+impl Drop for SessionLease {
+    fn drop(&mut self) {
+        if self.cleaned {
+            return;
+        }
+        self.cleaned = true;
+        let provider = self.provider.clone();
+        let session_id = self.session_id.clone();
+        ::zeroclaw_spawn::spawn!(async move {
+            let _ = provider.cleanup_session(&session_id, true).await;
+        });
+    }
+}
+
+#[async_trait]
+impl ModelProvider for OpenCodeSessionModelProvider {
+    fn supports_stateless_generation(&self) -> bool {
+        true
+    }
+
+    async fn chat_with_system(
+        &self,
+        system_prompt: Option<&str>,
+        message: &str,
+        model: &str,
+        _temperature: Option<f64>,
+    ) -> Result<String> {
+        let mut messages = Vec::new();
+        if let Some(system) = system_prompt {
+            messages.push(ChatMessage::system(system));
+        }
+        messages.push(ChatMessage::user(message));
+        Ok(self
+            .run_owned(messages, model.to_string())
+            .await?
+            .text
+            .unwrap_or_default())
+    }
+
+    async fn chat_with_history(
+        &self,
+        messages: &[ChatMessage],
+        model: &str,
+        _temperature: Option<f64>,
+    ) -> Result<String> {
+        Ok(self
+            .run_owned(messages.to_vec(), model.to_string())
+            .await?
+            .text
+            .unwrap_or_default())
+    }
+
+    async fn chat(
+        &self,
+        request: ChatRequest<'_>,
+        model: &str,
+        _temperature: Option<f64>,
+    ) -> Result<ChatResponse> {
+        if request.tools.is_some_and(|tools| !tools.is_empty()) {
+            bail!("OpenCode session transport is inference-only and rejects tools");
+        }
+        self.run_owned(request.messages.to_vec(), model.to_string())
+            .await
+    }
+
+    async fn list_models(&self) -> Result<Vec<String>> {
+        Ok(self
+            .list_model_info()
+            .await?
+            .into_iter()
+            .map(|model| model.id)
+            .collect())
+    }
+
+    async fn list_models_with_pricing(&self) -> Result<Vec<ModelInfo>> {
+        self.list_model_info().await
+    }
+}
+
+impl OpenCodeSessionModelProvider {
+    async fn run_owned(&self, messages: Vec<ChatMessage>, model: String) -> Result<ChatResponse> {
+        let provider = self.clone();
+        let identity = crate::sled_identity::current()?;
+        let scoped_identity = identity.clone();
+        let handle = ::zeroclaw_spawn::spawn!(async move {
+            scoped_identity
+                .scope(provider.generate_owned(identity, messages, model))
+                .await
+        });
+        let guard = crate::stream_guard::AbortOnDrop::new(handle.abort_handle());
+        let result = handle
+            .await
+            .context("OpenCode inference task was cancelled or failed")?;
+        drop(guard);
+        result
+    }
+}
+
+impl Attributable for OpenCodeSessionModelProvider {
+    fn role(&self) -> Role {
+        Role::Provider(ProviderKind::Model(ModelProviderKind::Plugin))
+    }
+
+    fn alias(&self) -> &str {
+        &self.alias
+    }
+}
