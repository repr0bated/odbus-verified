+#[tokio::test]
+async fn ws_stateless_uses_only_the_one_user_prompt_and_reports_terminal_done() {
+    let provider = provider_fixture().await;
+    let tmp = tempfile::tempdir().expect("temporary workspace");
+    let state = stateless_state(&tmp, format!("{}/v1", provider.uri()));
+    let workspace = state.config.read().agent_workspace_dir(AGENT);
+    std::fs::create_dir_all(&workspace).expect("seed workspace directory");
+    for (path, contents) in [
+        (workspace.join("AGENTS.md"), "workspace instructions"),
+        (workspace.join("SOUL.md"), "agent persona"),
+        (workspace.join("MEMORY.md"), "prior memory"),
+        (
+            workspace.join("skills").join("fixture").join("SKILL.md"),
+            "skill instructions",
+        ),
+    ] {
+        std::fs::create_dir_all(path.parent().expect("workspace fixture parent"))
+            .expect("seed workspace fixture parent");
+        std::fs::write(path, contents).expect("seed recognized workspace fixture");
+    }
+    let (base, _server) = start_gateway(state).await;
+    let mut socket = connect(&stateless_url(&base)).await;
+
+    let error = receive_json(&mut socket).await;
+    assert_eq!(
+        error,
+        json!({
+            "type": "session_start",
+            "session_id": SESSION,
+            "resumed": false,
+            "message_count": 0,
+            "stateless_generation": 1
+        })
+    );
+    send_json(
+        &mut socket,
+        json!({"type": "connect", "session_id": SESSION}),
+    )
+    .await;
+    let connected = receive_json(&mut socket).await;
+    assert_eq!(connected["type"], "connected");
+    assert_eq!(connected["provider"], PROVIDER);
+    assert_eq!(connected["model"], MODEL);
+    assert_eq!(connected["identity_authenticated"], "SID1");
+    assert_no_provider_effect(&provider).await;
+
+    send_json(
+        &mut socket,
+        json!({"type": "message", "content": "one user prompt"}),
+    )
+    .await;
+    let error = receive_json(&mut socket).await;
+    assert_eq!(error, json!({"type": "chunk", "content": "provider reply"}));
+    let done = receive_json(&mut socket).await;
+    assert_eq!(done["type"], "done");
+    assert_eq!(done["full_response"], "provider reply");
+    assert_eq!(done["provider"], PROVIDER);
+    assert_eq!(done["model"], MODEL);
+    assert_eq!(done["input_tokens"], 7);
+    assert_eq!(done["output_tokens"], 3);
+    assert_eq!(done["tokens_used"], 10);
+
+    let received = provider
+        .received_requests()
+        .await
+        .expect("provider fixture records requests");
+    assert_eq!(received.len(), 1, "exactly one provider turn is admitted");
+    let request: Value = serde_json::from_slice(&received[0].body).expect("provider request JSON");
+    assert_eq!(request["model"], MODEL);
+    assert_eq!(
+        request["messages"],
+        json!([{"role": "user", "content": "one user prompt"}])
+    );
+    assert!(
+        request.get("tools").is_none(),
+        "stateless turn must not expose tools"
+    );
+    assert!(
+        request["messages"]
+            .as_array()
+            .expect("messages array")
+            .iter()
+            .all(|message| message["role"] == "user"),
+        "workspace, system prompt, and history must not become provider messages"
+    );
+}
