+    assert_eq!(once["messages"][1], extra["messages"][0]);
+    for key in ["model", "max_tokens", "tool_choice", "tools"] {
+        assert_eq!(once[key], extra[key]);
+    }
+    assert_eq!(extra["messages"].as_array().unwrap().len(), 1);
+    let multipart = serde_json::json!({"messages": [{"role": "system", "content": [{"type": "text", "text": "existing instructions"}]}]});
+    let reminded = extra_body_with_reminder(Some(&multipart), false).unwrap();
+    assert_eq!(
+        reminded["messages"][0]["content"][0]["text"],
+        GRAPH_TURN_REMINDER
+    );
+    assert_eq!(
+        reminded["messages"][0]["content"][1],
+        multipart["messages"][0]["content"][0]
+    );
+    assert_eq!(
+        extra_body_with_reminder(Some(&reminded), false).unwrap(),
+        reminded
+    );
+    let settings = serde_json::json!({"reasoning": {"effort": "high"}, "max_tokens": 0});
+    assert_eq!(
+        extra_body_with_reminder(Some(&settings), false).unwrap(),
+        settings
+    );
+}
+
+#[test]
+fn graph_turn_reminder_message_override_respects_system_merge_models() {
+    let extra = serde_json::json!({"messages": [{"role": "user", "content": GRAPH_TURN_REMINDER}], "tool_choice": "auto"});
+    let reminded = extra_body_with_reminder(Some(&extra), true).unwrap();
+    assert_eq!(reminded["messages"].as_array().unwrap().len(), 1);
+    assert_eq!(reminded["messages"][0]["role"], "user");
+    // A user-supplied matching line cannot suppress the trusted added line.
+    assert_eq!(
+        reminded["messages"][0]["content"],
+        format!("{GRAPH_TURN_REMINDER}\n{GRAPH_TURN_REMINDER}")
+    );
+    assert_eq!(reminded["tool_choice"], extra["tool_choice"]);
+}
