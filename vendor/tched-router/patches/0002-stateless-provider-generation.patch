@@ -0,0 +1,178 @@
+//! Bounded transport for one explicitly admitted provider-only turn. This
+//! module never constructs an Agent or accesses session/history/workspace data.
+use axum::extract::ws::{Message, WebSocket};
+use futures_util::{SinkExt, StreamExt};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::time::Duration;
+use zeroclaw_providers::stateless::{
+    GenerationError, GenerationEvent, ProviderErrorKind, StatelessGeneration,
+};
+
+#[derive(Debug)]
+struct StatelessError {
+    code: &'static str,
+    provider_error: Option<ProviderErrorKind>,
+}
+
+impl StatelessError {
+    fn new(code: &'static str) -> Self {
+        Self {
+            code,
+            provider_error: None,
+        }
+    }
+
+    fn provider(kind: ProviderErrorKind) -> Self {
+        Self {
+            code: "PROVIDER_ERROR",
+            provider_error: Some(kind),
+        }
+    }
+}
+
+impl From<&'static str> for StatelessError {
+    fn from(code: &'static str) -> Self {
+        Self::new(code)
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Connect {
+    #[serde(rename = "type")]
+    kind: String,
+    session_id: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Prompt {
+    #[serde(rename = "type")]
+    kind: String,
+    content: String,
+}
+
+pub(crate) fn valid_session_id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 256
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+}
+
+pub(crate) async fn serve(
+    mut socket: WebSocket,
+    generation: StatelessGeneration,
+    session_id: String,
+    identity: zeroclaw_providers::sled_identity::VerifiedSledIdentity,
+) {
+    let result = identity
+        .scope(tokio::time::timeout(
+            Duration::from_secs(600),
+            run(&mut socket, generation, session_id),
+        ))
+        .await;
+    let error = match result {
+        Ok(Ok(())) => None,
+        Ok(Err(error)) => Some(error),
+        Err(_) => Some(StatelessError::new("TIMEOUT")),
+    };
+    if let Some(error) = error {
+        let mut frame = json!({"type":"error","code":error.code});
+        if let Some(kind) = error.provider_error {
+            let (kind, status) = kind.wire_parts();
+            frame["provider_error"] = if let Some(status) = status {
+                json!({"kind":kind,"status":status})
+            } else {
+                json!({"kind":kind})
+            };
+        }
+        let _ = tokio::time::timeout(Duration::from_secs(1), send(&mut socket, frame)).await;
+    }
+    let _ = tokio::time::timeout(Duration::from_secs(1), socket.close()).await;
+}
+
+async fn receive(socket: &mut WebSocket) -> Result<Value, &'static str> {
+    loop {
+        match socket.recv().await {
+            Some(Ok(Message::Text(text))) => {
+                return serde_json::from_str(&text).map_err(|_| "PROTOCOL");
+            }
+            Some(Ok(Message::Ping(_) | Message::Pong(_))) => continue,
+            _ => return Err("PROTOCOL"),
+        }
+    }
+}
+async fn send(socket: &mut WebSocket, value: Value) -> Result<(), &'static str> {
+    socket
+        .send(Message::Text(value.to_string().into()))
+        .await
+        .map_err(|_| "TRANSPORT")
+}
+
+async fn run(
+    socket: &mut WebSocket,
+    generation: StatelessGeneration,
+    session_id: String,
+) -> Result<(), StatelessError> {
+    let provider = generation.provider_ref.clone();
+    let model = generation.model.clone();
+    send(socket,json!({"type":"session_start","session_id":session_id,"resumed":false,"message_count":0,"stateless_generation":1})).await?;
+    let connect: Connect =
+        serde_json::from_value(receive(socket).await?).map_err(|_| "PROTOCOL")?;
+    if connect.kind != "connect" || connect.session_id != session_id {
+        return Err(StatelessError::new("PROTOCOL"));
+    }
+    // This exact marker is emitted only by the provider-only branch. The bound
+    // provider/model belong to the same consumed one-turn Config resolution.
+    send(
+        socket,
+        json!({"type":"connected","stateless_generation":1,"provider":provider,"model":model,"identity_authenticated":"SID1"}),
+    )
+    .await?;
+    let prompt: Prompt = serde_json::from_value(receive(socket).await?).map_err(|_| "PROTOCOL")?;
+    if prompt.kind != "message" {
+        return Err(StatelessError::new("PROTOCOL"));
+    }
+    let mut events = generation.start(prompt.content).map_err(|_| "PROTOCOL")?;
+    loop {
+        tokio::select! {
+            biased;
+            incoming = socket.recv() => match incoming {
+                Some(Ok(Message::Ping(_)|Message::Pong(_))) => {},
+                // Drop the owned provider stream on disconnect or another
+                // request. A remote provider may already have accepted input.
+                Some(Ok(Message::Close(_))) | None => return Ok(()),
+                _ => return Err(StatelessError::new("PROTOCOL")),
+            },
+            event = events.next() => match event {
+                Some(Ok(GenerationEvent::Delta(delta))) => {
+                    let mut remaining = delta.as_str();
+                    while !remaining.is_empty() {
+                        let mut end = remaining.len().min(16 * 1024);
+                        while !remaining.is_char_boundary(end) { end -= 1; }
+                        send(socket,json!({"type":"chunk","content":&remaining[..end]})).await?;
+                        remaining = &remaining[end..];
+                    }
+                }
+                Some(Ok(GenerationEvent::Done{response,usage})) => {
+                    let mut done = json!({"type":"done","full_response":response,"provider":provider,"model":model});
+                    if let Some(usage) = usage {
+                        if let Some(input) = usage.input_tokens { done["input_tokens"] = json!(input); }
+                        if let Some(output) = usage.output_tokens { done["output_tokens"] = json!(output); }
+                        if let (Some(input),Some(output)) = (usage.input_tokens,usage.output_tokens) {
+                            done["tokens_used"] = json!(input.checked_add(output).ok_or("PROTOCOL")?);
+                        }
+                    }
+                    send(socket,done).await?;
+                    return Ok(());
+                }
+                Some(Err(GenerationError::Bounds)) => return Err(StatelessError::new("BOUNDS")),
+                Some(Err(GenerationError::Protocol | GenerationError::InvalidRequest)) => return Err(StatelessError::new("PROTOCOL")),
+                Some(Err(GenerationError::Provider(kind))) => return Err(StatelessError::provider(kind)),
+                Some(Err(GenerationError::Unavailable)) => return Err(StatelessError::provider(ProviderErrorKind::Configuration)),
+                None => return Err(StatelessError::new("PROTOCOL")),
+            }
+        }
+    }
+}
