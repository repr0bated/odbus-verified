+        .map(serde_json::to_vec)
+        .transpose()?
+        .unwrap_or_default();
+    ensure!(input.len() <= MAX, "mounted arguments exceed size bound");
+    let mut child = cmd.spawn().context("mounted helper unavailable")?;
+    let mut outcome = InvokeOutcome {
+        invoking: command == "invoke",
+        settled: false,
+    };
+    let mut stdin = child.stdin.take().context("helper stdin missing")?;
+    let mut stdout = child.stdout.take().context("helper stdout missing")?;
+    let mut stderr = child.stderr.take().context("helper stderr missing")?;
+    let io = async {
+        let write = async {
+            stdin.write_all(&input).await?;
+            drop(stdin);
+            Ok::<(), std::io::Error>(())
+        };
+        let out = async {
+            let mut bytes = Vec::new();
+            (&mut stdout)
+                .take(MAX as u64 + 1)
+                .read_to_end(&mut bytes)
+                .await?;
+            ensure!(bytes.len() <= MAX, "mounted receipt exceeded size bound");
+            Ok::<_, anyhow::Error>(bytes)
+        };
+        let err = async {
+            let mut bytes = Vec::new();
+            (&mut stderr).take(65537).read_to_end(&mut bytes).await?;
+            ensure!(bytes.len() <= 65536, "mounted error exceeded size bound");
+            Ok::<_, anyhow::Error>(bytes)
+        };
+        let (_, out, err) =
+            tokio::try_join!(async { write.await.map_err(anyhow::Error::from) }, out, err)?;
+        let status = child.wait().await?;
+        ensure!(
+            status.success(),
+            "mounted operation failed: {}",
+            String::from_utf8_lossy(&err)
+        );
+        serde_json::from_slice(&out).context("mounted helper returned invalid JSON")
+    };
+    match tokio::time::timeout(Duration::from_secs(90), io).await {
+        Ok(Ok(value)) => {
+            outcome.settled = true;
+            Ok(value)
+        }
+        result => {
+            let _ = child.kill().await;
+            let _ = child.wait().await;
+            match result {
+                Ok(Err(error)) => Err(error.context(if command == "invoke" {
+                    "mounted invoke failed after spawn; completion unknown, do not retry"
+                } else {
+                    "mounted discovery failed"
+                })),
+                _ => anyhow::bail!(
+                    "mounted operation deadline exceeded; completion unknown, do not retry"
+                ),
+            }
+        }
+    }
+}
+
+// Killing the helper cannot roll back an already dispatched durable operation.
+// Cancellation drops this guard and Child (kill_on_drop); never imply rollback.
+struct InvokeOutcome {
+    invoking: bool,
+    settled: bool,
+}
+impl Drop for InvokeOutcome {
+    fn drop(&mut self) {
+        if self.invoking && !self.settled {
+            ::zeroclaw_log::record!(
+                WARN,
+                ::zeroclaw_log::Event::new(module_path!(), ::zeroclaw_log::Action::Fail),
+                "mounted invocation interrupted; durable completion unknown, do not retry"
+            );
+        }
+    }
+}
