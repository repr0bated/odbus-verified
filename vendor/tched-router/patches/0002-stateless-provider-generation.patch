+            success: true,
+            output: ToolOutput::json(
+                serde_json::json!({"methods":declarations,"total_matches":total_matches,"more_matches":total_matches>limit as usize,"active_filesystem_tools":selected.len(),"capacity":5}),
+            ),
+            error: None,
+        })
+    }
+}
+// The native object envelope is a calling convention, not another plugin schema.
+// Local refs must retain their original root when nested under `arguments`.
+fn native_schema(schema: &Value) -> Result<Value> {
+    if schema.get("type").and_then(Value::as_str) == Some("object") {
+        return Ok(schema.clone());
+    }
+    let mut nested = schema.clone();
+    rebase_refs(&mut nested)?;
+    Ok(
+        serde_json::json!({"type":"object", "properties":{"arguments":nested}, "required":["arguments"], "additionalProperties":false}),
+    )
+}
+fn rebase_refs(value: &mut Value) -> Result<()> {
+    match value {
+        Value::Object(object) => {
+            ensure!(
+                !object.contains_key("$id")
+                    && !object.contains_key("$anchor")
+                    && !object.contains_key("$dynamicAnchor")
+                    && !object.contains_key("$dynamicRef"),
+                "schema resource/anchor rebinding is unsupported"
+            );
+            if let Some(reference) = object.get_mut("$ref") {
+                let original = reference.as_str().context("schema ref must be a string")?;
+                let rebased = if original == "#" {
+                    "#/properties/arguments".to_owned()
+                } else if let Some(pointer) = original.strip_prefix("#/") {
+                    format!("#/properties/arguments/{pointer}")
+                } else {
+                    anyhow::bail!(
+                        "external or anchor schema refs are unsupported in native envelope"
+                    )
+                };
+                *reference = Value::String(rebased);
+            }
+            // Traverse schema positions only: a const/enum/default may contain
+            // literal $ref/$id keys that must remain untouched.
+            for (keyword, child) in object.iter_mut() {
+                match keyword.as_str() {
+                    "$defs" | "definitions" | "properties" | "patternProperties"
+                    | "dependentSchemas" => {
+                        for schema in child
+                            .as_object_mut()
+                            .context("schema map required")?
+                            .values_mut()
+                        {
+                            rebase_refs(schema)?;
+                        }
+                    }
+                    "allOf" | "anyOf" | "oneOf" | "prefixItems" => {
+                        for schema in child.as_array_mut().context("schema array required")? {
+                            rebase_refs(schema)?;
+                        }
+                    }
+                    "items"
+                    | "additionalItems"
+                    | "additionalProperties"
+                    | "unevaluatedItems"
+                    | "unevaluatedProperties"
+                    | "not"
+                    | "if"
+                    | "then"
+                    | "else"
+                    | "propertyNames"
+                    | "contains"
+                    | "contentSchema" => rebase_refs(child)?,
+                    "dependencies" => {
+                        for schema in child
+                            .as_object_mut()
+                            .context("schema dependencies required")?
+                            .values_mut()
+                        {
+                            if !schema.is_array() {
+                                rebase_refs(schema)?;
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Value::Array(values) => {
+            for child in values {
+                rebase_refs(child)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+fn unwrap_arguments(schema: &Value, value: Value) -> Result<Value> {
+    if schema.get("type").and_then(Value::as_str) == Some("object") {
+        return Ok(value);
+    }
+    let mut object = value
+        .as_object()
+        .context("native arguments envelope required")?
+        .clone();
+    ensure!(object.len() == 1, "native envelope accepts only arguments");
+    object
+        .remove("arguments")
+        .context("native arguments missing")
+}
+
+fn encode_name(value: &str) -> String {
+    value
+        .bytes()
+        .map(|b| {
+            if b.is_ascii_alphanumeric() || b == b"_"[0] {
+                (b as char).to_string()
+            } else {
+                format!("_{b:02x}")
+            }
+        })
+        .collect()
+}
+struct FilesystemTool {
+    binding: Binding,
+    security: Arc<SecurityPolicy>,
+    sandbox: Arc<dyn Sandbox>,
+    name: String,
+    path: String,
+    declaration: Value,
+    description: String,
+}
+zeroclaw_api::tool_attribution!(FilesystemTool, zeroclaw_api::attribution::ToolKind::Plugin);
+#[async_trait]
+impl Tool for FilesystemTool {
+    fn name(&self) -> &str {
+        &self.name
+    }
+    fn description(&self) -> &str {
+        &self.description
+    }
+    fn parameters_schema(&self) -> Value {
+        native_schema(
+            self.declaration
+                .get("args")
+                .expect("validated mounted schema"),
+        )
