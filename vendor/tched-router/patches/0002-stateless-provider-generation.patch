@@ -0,0 +1,154 @@
+//! Verification bridge for identity-sled-authored SID1 credentials.
+//!
+//! Native code treats the credential as opaque. Authority remains in the
+//! OP-DBUS MCP door, which validates the current sled/session/revocation state.
+
+use anyhow::{Context, Result, bail};
+use futures_util::StreamExt;
+use reqwest::{Client, Url, redirect::Policy};
+use serde_json::json;
+use std::{future::Future, net::IpAddr, sync::Arc, time::Duration};
+
+pub const SEALED_ID_HEADER: &str = "x-opdbus-sealed-id-bin";
+pub const AUTHENTICATED_IDENTITY: &str = "SID1";
+const AUTH_URL_ENV: &str = "OPDBUS_SLED_AUTH_URL";
+const CA_FILE_ENV: &str = "OPDBUS_SLED_CA_FILE";
+const MAX_AUTH_RESPONSE_BYTES: usize = 64 * 1024;
+const AUTH_TIMEOUT: Duration = Duration::from_secs(10);
+
+tokio::task_local! {
+    static VERIFIED_IDENTITY: VerifiedSledIdentity;
+}
+
+#[derive(Clone)]
+pub struct VerifiedSledIdentity {
+    sealed_id: Arc<str>,
+}
+
+impl VerifiedSledIdentity {
+    pub async fn verify(sealed_id: &str) -> Result<Self> {
+        validate_opaque_credential(sealed_id)?;
+        let identity = Self {
+            sealed_id: Arc::from(sealed_id),
+        };
+        identity.reverify().await?;
+        Ok(identity)
+    }
+
+    pub async fn reverify(&self) -> Result<()> {
+        #[cfg(test)]
+        if self.sealed_id.as_ref() == "U0lEMQ_native-fixture" {
+            return Ok(());
+        }
+        let auth_url = std::env::var(AUTH_URL_ENV)
+            .with_context(|| format!("{AUTH_URL_ENV} is required for SID1 verification"))?;
+        let url = Url::parse(&auth_url).context("OP-DBUS sled auth URL is invalid")?;
+        let literal_ip = url
+            .host_str()
+            .and_then(|host| host.parse::<IpAddr>().ok())
+            .is_some();
+        if url.scheme() != "https"
+            || !literal_ip
+            || url.port().is_none()
+            || url.username() != ""
+            || url.password().is_some()
+            || url.path() != "/mcp"
+            || url.query().is_some()
+            || url.fragment().is_some()
+        {
+            bail!(
+                "OP-DBUS sled auth URL must be an HTTPS literal-IP /mcp URL with an explicit port and no credentials, query, or fragment"
+            );
+        }
+        let ca_file = std::env::var(CA_FILE_ENV)
+            .with_context(|| format!("{CA_FILE_ENV} is required for SID1 verification"))?;
+        let ca_pem = std::fs::read(&ca_file).context("failed to read OP-DBUS sled CA file")?;
+        let certificate = reqwest::Certificate::from_pem(&ca_pem)
+            .context("OP-DBUS sled CA file is not a PEM certificate")?;
+        let client = Client::builder()
+            .redirect(Policy::none())
+            .timeout(AUTH_TIMEOUT)
+            .add_root_certificate(certificate)
+            .build()
+            .context("failed to build OP-DBUS sled auth client")?;
+        let response = client
+            .post(url)
+            .header(SEALED_ID_HEADER, self.sealed_id.as_ref())
+            .header("accept", "application/json, text/event-stream")
+            .header("mcp-protocol-version", "2025-06-18")
+            .json(&json!({
+                "jsonrpc": "2.0",
+                "id": "sled-auth",
+                "method": "ping",
+                "params": {}
+            }))
+            .send()
+            .await
+            .context("OP-DBUS sled auth request failed")?;
+        if !response.status().is_success() {
+            bail!("OP-DBUS sled auth rejected the credential");
+        }
+        let mut body = Vec::new();
+        let mut stream = response.bytes_stream();
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk.context("failed while reading OP-DBUS sled auth response")?;
+            if body.len().saturating_add(chunk.len()) > MAX_AUTH_RESPONSE_BYTES {
+                bail!("OP-DBUS sled auth response exceeded its size limit");
+            }
+            body.extend_from_slice(&chunk);
+        }
+        let value: serde_json::Value =
+            serde_json::from_slice(&body).context("OP-DBUS sled auth returned invalid JSON")?;
+        if value.get("jsonrpc").and_then(serde_json::Value::as_str) != Some("2.0")
+            || value.get("id").and_then(serde_json::Value::as_str) != Some("sled-auth")
+            || value.get("error").is_some()
+            || value.get("result").is_none()
+        {
+            bail!("OP-DBUS sled auth returned an invalid ping response");
+        }
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn native_fixture() -> Self {
+        Self {
+            sealed_id: Arc::from("U0lEMQ_native-fixture"),
+        }
+    }
+
+    pub async fn scope<F: Future>(&self, future: F) -> F::Output {
+        VERIFIED_IDENTITY.scope(self.clone(), future).await
+    }
+}
+
+pub fn current() -> Result<VerifiedSledIdentity> {
+    VERIFIED_IDENTITY
+        .try_with(Clone::clone)
+        .context("verified SID1 context is required for native inference")
+}
+
+fn validate_opaque_credential(value: &str) -> Result<()> {
+    if value.is_empty()
+        || value.len() > 64 * 1024
+        || value.contains('=')
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+    {
+        bail!("sealed identity credential must be unpadded base64url");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::validate_opaque_credential;
+
+    #[test]
+    fn opaque_credential_shape_is_fail_closed() {
+        assert!(validate_opaque_credential("U0lEMQ_test-opaque").is_ok());
+        for invalid in ["", "padded=", "spaces are forbidden", "slash/forbidden"] {
+            assert!(validate_opaque_credential(invalid).is_err());
+        }
+    }
+}
