+        let persisted = crate::ModelProviderRuntimeOptions {
+            provider_api_url: Some("http://127.0.0.1:4096".to_string()),
+            provider_extra: Some(json!(r#"{"opdbus_transport":"opencode_session"}"#)),
+            ..Default::default()
+        };
+        let selected = crate::create_model_provider_with_options(
+            "custom",
+            Some("fixture-password"),
+            &persisted,
+        )
+        .expect("select OpenCode session adapter from persisted JSON text");
+        assert!(selected.supports_stateless_generation());
+
+        for extra in [
+            json!(r#"{"opdbus_transport":"opencode_session","messages":[]}"#),
+            json!(r#"{"opdbus_transport":"unexpected"}"#),
+            json!(r#"{"opdbus_transport":"opencode_session""#),
+        ] {
+            let invalid = crate::ModelProviderRuntimeOptions {
+                provider_api_url: Some("http://127.0.0.1:4096".to_string()),
+                provider_extra: Some(extra),
+                ..Default::default()
+            };
+            assert!(
+                crate::create_model_provider_with_options(
+                    "custom",
+                    Some("fixture-password"),
+                    &invalid,
+                )
+                .is_err(),
+                "invalid encoded marker must not reach generic dispatch"
+            );
+        }
+
+        for extra in [json!({"temperature": 0.2}), json!("plain text")] {
+            assert!(!crate::opencode_session_marker(Some(&extra)).unwrap());
+        }
+    }
