+async fn assert_provider_failure(
+    provider_uri: String,
+    expected: Value,
+    prompt: &str,
+    sentinels: &[&str],
+) {
+    let tmp = tempfile::tempdir().expect("temporary workspace");
+    let state = stateless_state(&tmp, provider_uri);
+    let (base, _server) = start_gateway(state).await;
+    let mut socket = connect(&stateless_url(&base)).await;
+    assert_eq!(receive_json(&mut socket).await["type"], "session_start");
+    send_json(&mut socket, json!({"type":"connect","session_id":SESSION})).await;
+    assert_eq!(receive_json(&mut socket).await["type"], "connected");
+    send_json(&mut socket, json!({"type":"message","content":prompt})).await;
+    let error = receive_json(&mut socket).await;
+    assert_eq!(error, expected);
+    let serialized = error.to_string();
+    for sentinel in sentinels {
+        assert!(
+            !serialized.contains(sentinel),
+            "provider diagnostic leaked sentinel {sentinel:?}"
+        );
+    }
+}
