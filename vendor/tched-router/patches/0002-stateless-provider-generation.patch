+#[derive(Clone)]
+struct Binding {
+    root: PathBuf,
+    session: String,
+}
+impl Binding {
+    fn from_env() -> Result<Self> {
+        let root = PathBuf::from(std::env::var(ROOT).context("filesystem root binding required")?);
+        let session = std::env::var(SESSION).context("filesystem session binding required")?;
+        ensure!(
+            root.is_absolute()
+                && root != std::path::Path::new("/")
+                && root.components().all(|c| matches!(
+                    c,
+                    std::path::Component::RootDir | std::path::Component::Normal(_)
+                )),
+            "filesystem root must be an exact absolute path"
+        );
+        ensure!(
+            uuid::Uuid::parse_str(&session)?.to_string() == session,
+            "filesystem session must be canonical"
+        );
+        Ok(Self { root, session })
+    }
+    fn admit(&self, security: &SecurityPolicy) -> Result<()> {
+        let identity = sled_identity::current()?;
+        ensure!(
+            identity.claims().session_id == self.session,
+            "filesystem is unavailable for this verified caller"
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            for path in self.root.ancestors() {
+                let metadata = std::fs::symlink_metadata(path)?;
+                ensure!(
+                    metadata.is_dir() && metadata.uid() == 0 && metadata.mode() & 0o022 == 0,
+                    "filesystem mount requires protected root-owned nonsymlink ancestors"
+                );
+            }
+            let executable = std::fs::metadata(HELPER)?;
+            ensure!(
+                executable.is_file() && executable.uid() == 0 && executable.mode() & 0o022 == 0,
+                "mounted helper must be root-owned and protected"
+            );
+        }
+        ensure!(
+            security.is_path_allowed(self.root.to_str().context("invalid filesystem root")?)
+                && security.is_resolved_path_readable(&self.root)
+                && security.approved_read_root(&self.root).is_some(),
+            "filesystem root is not admitted by native path policy"
+        );
+
+        Ok(())
+    }
+}
