+//! Identity-bound native tools; schemas and receipts belong to the mounted helper.
+//!
+//! Operator configuration: OPDBUS_FILESYSTEM_ROOT is the exact protected mount,
+//! OPDBUS_FILESYSTEM_SESSION is the receiver-verified session it serves.
+//! OPDBUS_FILESYSTEM_READ_HELPER=1 explicitly permits only this fixed protected
+//! helper's describe/read transport under native readonly policy. It does not
+//! enable generic shell or mutations, alter path policy, or grant local FUSE
+//! access. Missing/other values retain the ordinary command gate. No default
+//! activation: these public settings require deliberate operator configuration.
+use crate::security::{Sandbox, SecurityPolicy, policy::ToolOperation};
+use anyhow::{Context, Result, ensure};
+use async_trait::async_trait;
+use serde_json::Value;
+use std::{path::PathBuf, process::Stdio, sync::Arc, time::Duration};
