+struct SledAuthFixture {
+    uri: String,
+    ca: tempfile::NamedTempFile,
+}
+
+static SLED_AUTH_FIXTURE: tokio::sync::OnceCell<SledAuthFixture> =
+    tokio::sync::OnceCell::const_new();
+
+#[allow(clippy::disallowed_methods)] // The fixture owns a dedicated test runtime thread.
+async fn sled_auth_fixture() -> &'static SledAuthFixture {
+    SLED_AUTH_FIXTURE
+        .get_or_init(|| async {
+            let _ = rustls::crypto::ring::default_provider().install_default();
+            let ca_key = rcgen::KeyPair::generate().expect("generate fixture CA key");
+            let mut ca_params = rcgen::CertificateParams::new(vec!["OP-DBUS test CA".to_string()])
+                .expect("fixture CA parameters");
+            ca_params.is_ca = rcgen::IsCa::Ca(rcgen::BasicConstraints::Unconstrained);
+            let ca_cert = ca_params
+                .self_signed(&ca_key)
+                .expect("self-sign fixture CA");
+            let mut server_params = rcgen::CertificateParams::new(vec!["127.0.0.1".to_string()])
+                .expect("fixture server parameters");
+            server_params.is_ca = rcgen::IsCa::NoCa;
+            let server_key = rcgen::KeyPair::generate().expect("generate fixture server key");
+            let server_cert = server_params
+                .signed_by(&server_key, &ca_cert, &ca_key)
+                .expect("sign fixture server certificate");
+
+            let mut cert_reader = Cursor::new(server_cert.pem());
+            let certs = rustls_pemfile::certs(&mut cert_reader)
+                .collect::<Result<Vec<_>, _>>()
+                .expect("parse fixture server certificate");
+            let mut key_reader = Cursor::new(server_key.serialize_pem());
+            let key = rustls_pemfile::private_key(&mut key_reader)
+                .expect("parse fixture server key")
+                .expect("fixture server key exists");
+            let tls = TlsAcceptor::from(Arc::new(
+                rustls::ServerConfig::builder()
+                    .with_no_client_auth()
+                    .with_single_cert(certs, key)
+                    .expect("build fixture TLS configuration"),
+            ));
+            let listener =
+                std::net::TcpListener::bind("127.0.0.1:0").expect("bind sled auth fixture");
+            listener
+                .set_nonblocking(true)
+                .expect("configure sled auth fixture listener");
+            let address = listener.local_addr().expect("sled auth fixture address");
+            std::thread::spawn(move || {
+                let runtime = tokio::runtime::Builder::new_current_thread()
+                    .enable_all()
+                    .build()
+                    .expect("build sled auth fixture runtime");
+                runtime.block_on(async move {
+                    let listener =
+                        TcpListener::from_std(listener).expect("adopt sled auth fixture listener");
+                    while let Ok((stream, _)) = listener.accept().await {
+                        let tls = tls.clone();
+                        tokio::spawn(async move {
+                            let Ok(stream) = tls.accept(stream).await else {
+                                return;
+                            };
+                            let service = service_fn(|request: Request<Incoming>| async move {
+                                let header_ok = request
+                                    .headers()
+                                    .get(zeroclaw_providers::sled_identity::SEALED_ID_HEADER)
+                                    .and_then(|value| value.to_str().ok())
+                                    == Some(TEST_SEALED_ID);
+                                let body = request
+                                    .into_body()
+                                    .collect()
+                                    .await
+                                    .ok()
+                                    .map(|b| b.to_bytes());
+                                let ping_ok = body
+                                    .as_deref()
+                                    .and_then(|bytes| serde_json::from_slice::<Value>(bytes).ok())
+                                    .is_some_and(|value| {
+                                        value.get("jsonrpc").and_then(Value::as_str) == Some("2.0")
+                                            && value.get("id").and_then(Value::as_str)
+                                                == Some("sled-auth")
+                                            && value.get("method").and_then(Value::as_str)
+                                                == Some("ping")
+                                    });
+                                let (status, body) = if header_ok && ping_ok {
+                                    (
+                                        StatusCode::OK,
+                                        r#"{"jsonrpc":"2.0","id":"sled-auth","result":{}}"#,
+                                    )
+                                } else {
+                                    (StatusCode::UNAUTHORIZED, r#"{"error":"unauthorized"}"#)
+                                };
+                                Ok::<_, Infallible>(
+                                    Response::builder()
+                                        .status(status)
+                                        .header("content-type", "application/json")
+                                        .body(Full::new(Bytes::from_static(body.as_bytes())))
+                                        .expect("fixture auth response"),
+                                )
+                            });
+                            let _ = http1::Builder::new()
+                                .serve_connection(TokioIo::new(stream), service)
+                                .await;
+                        });
+                    }
+                });
+            });
+            let mut ca = tempfile::NamedTempFile::new().expect("create fixture CA file");
+            std::io::Write::write_all(&mut ca, ca_cert.pem().as_bytes()).expect("write fixture CA");
+            let fixture = SledAuthFixture {
+                uri: format!("https://{address}/mcp"),
+                ca,
+            };
+            // OnceCell serializes these process-global test settings before it
+            // publishes the fixture to concurrent test tasks.
+            unsafe {
+                std::env::set_var("OPDBUS_SLED_AUTH_URL", &fixture.uri);
+                std::env::set_var("OPDBUS_SLED_CA_FILE", fixture.ca.path());
+            }
+            fixture
+        })
+        .await
+}
