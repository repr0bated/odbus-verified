+#[derive(Clone)]
+struct StreamingResponsesState {
+    requests: Arc<parking_lot::Mutex<Vec<Value>>>,
+    release: Arc<AsyncMutex<Option<oneshot::Receiver<()>>>>,
+}
+
+struct StreamingResponsesFixture {
+    uri: String,
+    requests: Arc<parking_lot::Mutex<Vec<Value>>>,
+    release: Option<oneshot::Sender<()>>,
+    _server: AbortOnDrop,
+}
+
+impl StreamingResponsesFixture {
+    fn release_completion(&mut self) {
+        self.release
+            .take()
+            .expect("completion has not yet been released")
+            .send(())
+            .expect("SSE completion receiver must remain attached");
+    }
+}
+
+async fn streaming_responses_handler(
+    State(state): State<StreamingResponsesState>,
+    Json(request): Json<Value>,
+) -> impl IntoResponse {
+    state.requests.lock().push(request);
+    let release = state
+        .release
+        .lock()
+        .await
+        .take()
+        .expect("the stateless fixture accepts exactly one provider request");
+    let delta = stream::once(async {
+        Ok::<_, Infallible>(Bytes::from_static(
+            b"data: {\"type\":\"response.output_text.delta\",\"delta\":\"streamed delta\"}\n\n",
+        ))
+    });
+    let completion = stream::once(async move {
+        let _ = release.await;
+        Ok::<_, Infallible>(Bytes::from_static(
+            b"data: {\"type\":\"response.completed\",\"response\":{\"output_text\":\"streamed delta\",\"usage\":{\"input_tokens\":11,\"output_tokens\":4}}}\n\n",
+        ))
+    });
+    (
+        [(header::CONTENT_TYPE, "text/event-stream")],
+        Body::from_stream(delta.chain(completion)),
+    )
+        .into_response()
+}
+
+async fn streaming_responses_fixture() -> StreamingResponsesFixture {
+    let (release, completion) = oneshot::channel();
+    let requests = Arc::new(parking_lot::Mutex::new(Vec::new()));
+    let state = StreamingResponsesState {
+        requests: Arc::clone(&requests),
+        release: Arc::new(AsyncMutex::new(Some(completion))),
+    };
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind loopback SSE fixture");
+    let addr = listener.local_addr().expect("SSE fixture listener address");
+    let app = Router::new()
+        .route("/v1/responses", post(streaming_responses_handler))
+        .with_state(state);
+    let handle = ::zeroclaw_spawn::spawn!(async move {
+        let _ = axum::serve(listener, app).await;
+    });
+    StreamingResponsesFixture {
+        uri: format!("http://{addr}/v1/responses"),
+        requests,
+        release: Some(release),
+        _server: AbortOnDrop(Some(handle)),
+    }
+}
