+async fn assert_no_provider_effect(provider: &MockServer) {
+    assert!(
+        provider
+            .received_requests()
+            .await
+            .expect("provider fixture records requests")
+            .is_empty(),
+        "rejected stateless traffic must not reach the provider"
+    );
+}
