+/// Recognize the dedicated transport marker in both native object config and
+/// legacy JSON text persisted by the config property setter. Other arbitrary
+/// provider extras retain their existing shape and dispatch behavior.
+pub fn opencode_session_marker(extra: Option<&serde_json::Value>) -> anyhow::Result<bool> {
+    fn classify(map: &serde_json::Map<String, serde_json::Value>) -> anyhow::Result<bool> {
+        let Some(marker) = map.get("opdbus_transport") else {
+            return Ok(false);
+        };
+        if map.len() != 1 || marker.as_str() != Some("opencode_session") {
+            anyhow::bail!(
+                "OpenCode session provider_extra requires only opdbus_transport = opencode_session; request overrides are forbidden"
+            );
+        }
+        Ok(true)
+    }
+
+    match extra {
+        None => Ok(false),
+        Some(serde_json::Value::Object(map)) => classify(map),
+        Some(serde_json::Value::String(raw)) => {
+            let parsed = match serde_json::from_str::<serde_json::Value>(raw) {
+                Ok(parsed) => parsed,
+                Err(_) if raw.contains("opdbus_transport") => {
+                    anyhow::bail!("malformed OpenCode session provider_extra marker")
+                }
+                Err(_) => return Ok(false),
+            };
