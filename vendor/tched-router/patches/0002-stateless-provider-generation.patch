+const HELPER: &str = "/usr/local/bin/threetched-fs";
+const ROOT: &str = "OPDBUS_FILESYSTEM_ROOT";
+const SESSION: &str = "OPDBUS_FILESYSTEM_SESSION";
+const READ_HELPER: &str = "OPDBUS_FILESYSTEM_READ_HELPER";
+const MAX: usize = 16 * 1024 * 1024;
