+//! Trusted reminder at each native provider request, independent of stored history.
+//! No graph lookup, credentials, identity changes or additional authorization.
+use super::ModelProvider;
+use super::dispatch::ProviderDispatch;
+use super::traits::{
+    ChatMessage, ChatRequest, ChatResponse, StreamChunk, StreamEvent, StreamOptions, StreamResult,
+};
+use async_trait::async_trait;
+use futures_util::stream::BoxStream;
+use zeroclaw_api::model_provider::ModelInfo;
+
+pub const GRAPH_TURN_REMINDER: &str = "System graph: discover cozo.list_system_graphs through identity-bound 3tchedFS; check provenance and coverage; grants apply.";
+
+fn system_prompt_with_reminder(prompt: Option<&str>) -> String {
+    let prompt = prompt.unwrap_or_default();
+    // Only a complete, known system line is trusted. A marker or user/tool
+    // content cannot suppress this reminder or replace it with arbitrary text.
+    if prompt == GRAPH_TURN_REMINDER
+        || prompt
+            .strip_prefix(GRAPH_TURN_REMINDER)
+            .is_some_and(|rest| rest.starts_with("\n"))
+    {
+        return prompt.to_owned();
+    }
+    if prompt.is_empty() {
+        GRAPH_TURN_REMINDER.to_owned()
+    } else {
+        format!("{GRAPH_TURN_REMINDER}\n{prompt}")
+    }
+}
+
+fn messages_with_reminder(messages: &[ChatMessage]) -> Vec<ChatMessage> {
+    let mut messages = messages.to_vec();
+    // Prepend to the first system message: some providers consume only that
+    // message. Preserve every other message, role, tool payload and ordering.
+    if let Some(system) = messages.iter_mut().find(|message| message.is_system()) {
+        system.content = system_prompt_with_reminder(Some(&system.content));
+    } else {
+        messages.insert(0, ChatMessage::system(GRAPH_TURN_REMINDER));
+    }
+    messages
+}
+
+/// Applied to every leaf provider constructed by the native factory. Routed
+/// and reliable providers retain their native dispatch/retry behavior; every
+/// chosen leaf gets the line at the last local inference boundary, including
+/// tool iterations, summarization and requests following context compaction.
+pub struct GraphTurnReminderProvider {
+    inner: Box<dyn ModelProvider>,
+}
+impl GraphTurnReminderProvider {
+    pub fn new(inner: Box<dyn ModelProvider>) -> Self {
+        Self { inner }
+    }
+}
+
+impl zeroclaw_api::attribution::Attributable for GraphTurnReminderProvider {
+    fn role(&self) -> zeroclaw_api::attribution::Role {
+        self.inner.role()
+    }
+    fn alias(&self) -> &str {
+        self.inner.alias()
+    }
+}
+
+#[async_trait]
+impl ModelProvider for GraphTurnReminderProvider {
+    fn supports_stateless_generation(&self) -> bool {
+        self.inner.supports_stateless_generation()
+    }
+    fn capabilities(&self) -> super::traits::ProviderCapabilities {
+        self.inner.capabilities()
+    }
+    fn capabilities_for_model(&self, model: &str) -> super::traits::ProviderCapabilities {
+        self.inner.capabilities_for_model(model)
+    }
+    fn default_temperature(&self) -> f64 {
+        self.inner.default_temperature()
+    }
+    fn default_max_tokens(&self) -> u32 {
+        self.inner.default_max_tokens()
+    }
+    fn default_timeout_secs(&self) -> u64 {
+        self.inner.default_timeout_secs()
+    }
+    fn default_base_url(&self) -> Option<&str> {
+        self.inner.default_base_url()
+    }
+    fn default_wire_api(&self) -> &str {
+        self.inner.default_wire_api()
+    }
+    fn convert_tools(&self, tools: &[zeroclaw_api::tool::ToolSpec]) -> super::traits::ToolsPayload {
+        self.inner.convert_tools(tools)
+    }
+    fn supports_native_tools(&self) -> bool {
+        self.inner.supports_native_tools()
+    }
+    fn supports_vision(&self) -> bool {
+        self.inner.supports_vision()
+    }
+    fn supports_streaming(&self) -> bool {
+        self.inner.supports_streaming()
+    }
+    fn supports_streaming_tool_events(&self) -> bool {
+        self.inner.supports_streaming_tool_events()
+    }
+    async fn list_models(&self) -> anyhow::Result<Vec<String>> {
+        ProviderDispatch::from_ref(&*self.inner).list_models().await
+    }
+    async fn list_models_with_pricing(&self) -> anyhow::Result<Vec<ModelInfo>> {
+        ProviderDispatch::from_ref(&*self.inner)
+            .list_models_with_pricing()
+            .await
+    }
+    async fn warmup(&self) -> anyhow::Result<()> {
+        ProviderDispatch::from_ref(&*self.inner).warmup().await
+    }
+
+    async fn simple_chat(
+        &self,
+        message: &str,
+        model: &str,
+        temperature: Option<f64>,
+    ) -> anyhow::Result<String> {
+        self.chat_with_system(None, message, model, temperature)
+            .await
+    }
+    async fn chat_with_system(
+        &self,
+        system_prompt: Option<&str>,
+        message: &str,
+        model: &str,
+        temperature: Option<f64>,
+    ) -> anyhow::Result<String> {
+        let system = system_prompt_with_reminder(system_prompt);
+        ProviderDispatch::from_ref(&*self.inner)
+            .chat_with_system(Some(&system), message, model, temperature)
+            .await
+    }
+    async fn chat_with_history(
+        &self,
+        messages: &[ChatMessage],
+        model: &str,
+        temperature: Option<f64>,
+    ) -> anyhow::Result<String> {
+        let messages = messages_with_reminder(messages);
+        ProviderDispatch::from_ref(&*self.inner)
+            .chat_with_history(&messages, model, temperature)
+            .await
+    }
+    async fn chat(
+        &self,
+        request: ChatRequest<'_>,
+        model: &str,
+        temperature: Option<f64>,
+    ) -> anyhow::Result<ChatResponse> {
+        let messages = messages_with_reminder(request.messages);
+        ProviderDispatch::from_ref(&*self.inner)
+            .chat(
+                ChatRequest {
+                    messages: &messages,
+                    ..request
+                },
+                model,
+                temperature,
+            )
+            .await
+    }
+    async fn chat_with_tools(
+        &self,
+        messages: &[ChatMessage],
+        tools: &[serde_json::Value],
+        model: &str,
+        temperature: Option<f64>,
+    ) -> anyhow::Result<ChatResponse> {
+        let messages = messages_with_reminder(messages);
+        ProviderDispatch::from_ref(&*self.inner)
+            .chat_with_tools(&messages, tools, model, temperature)
+            .await
+    }
+    fn stream_chat_with_system(
+        &self,
+        system_prompt: Option<&str>,
+        message: &str,
+        model: &str,
+        temperature: Option<f64>,
+        options: StreamOptions,
+    ) -> BoxStream<'static, StreamResult<StreamChunk>> {
+        let system = system_prompt_with_reminder(system_prompt);
+        self.inner
+            .stream_chat_with_system(Some(&system), message, model, temperature, options)
+    }
+    fn stream_chat_with_history(
+        &self,
+        messages: &[ChatMessage],
+        model: &str,
+        temperature: Option<f64>,
+        options: StreamOptions,
+    ) -> BoxStream<'static, StreamResult<StreamChunk>> {
+        let messages = messages_with_reminder(messages);
+        self.inner
+            .stream_chat_with_history(&messages, model, temperature, options)
+    }
+    fn stream_chat(
+        &self,
+        request: ChatRequest<'_>,
+        model: &str,
+        temperature: Option<f64>,
+        options: StreamOptions,
+    ) -> BoxStream<'static, StreamResult<StreamEvent>> {
+        let messages = messages_with_reminder(request.messages);
+        ProviderDispatch::from_ref(&*self.inner).stream_chat(
+            ChatRequest {
+                messages: &messages,
+                ..request
+            },
+            model,
+            temperature,
+            options,
+        )
+    }
+}
+
+/// Preserve an explicitly configured messages override and all other extra
+/// fields while reattaching the trusted line to its final messages. Compatible
+/// native-tool requests flatten these overrides last; OpenRouter merges them
+/// last. Looking only at system-role content prevents user text from deduping.
+pub(crate) fn extra_body_with_reminder(
+    extra: Option<&serde_json::Value>,
+    merge_system: bool,
+) -> Option<serde_json::Value> {
+    let mut extra = extra?.clone();
+    let Some(messages) = extra
+        .get_mut("messages")
+        .and_then(serde_json::Value::as_array_mut)
+    else {
+        return Some(extra);
+    };
+    let role = if merge_system { "user" } else { "system" };
+    if let Some(system) = messages
+        .iter_mut()
+        .find(|message| message.get("role").and_then(serde_json::Value::as_str) == Some(role))
+        && let Some(content) = system.get_mut("content")
+    {
+        if let Some(text) = content.as_str() {
+            *content = serde_json::Value::String(if merge_system {
+                format!("{GRAPH_TURN_REMINDER}\n{text}")
+            } else {
+                system_prompt_with_reminder(Some(text))
+            });
+            return Some(extra);
+        }
+        if let Some(parts) = content.as_array_mut() {
+            let has_reminder = !merge_system
+                && parts.first().is_some_and(|part| {
+                    part.get("type").and_then(serde_json::Value::as_str) == Some("text")
+                        && part.get("text").and_then(serde_json::Value::as_str)
+                            == Some(GRAPH_TURN_REMINDER)
+                });
+            if !has_reminder {
+                parts.insert(
+                    0,
+                    serde_json::json!({"type": "text", "text": GRAPH_TURN_REMINDER}),
+                );
+            }
+            return Some(extra);
+        }
+    }
+    messages.insert(
+        0,
+        serde_json::json!({"role": role, "content": GRAPH_TURN_REMINDER}),
+    );
+    Some(extra)
+}
