+//! Transport-boundary fixtures for the deliberately narrow stateless WS path.
+//!
+//! These tests use a real Axum upgrade plus a loopback OpenAI-compatible HTTP
+//! fixture. They prove that the path reaches only the admitted provider turn;
+//! it must not reconstruct agent/session state around the provider call.
+
+use axum::{
+    Router,
+    body::{Body, Bytes},
+    extract::{Json, State},
+    http::header,
+    response::IntoResponse,
+    routing::{get, post},
+};
+use futures_util::{SinkExt, Stream, StreamExt, stream};
+use http_body_util::{BodyExt, Full};
+use hyper::{
+    Request, Response, StatusCode, body::Incoming, server::conn::http1, service::service_fn,
+};
+use hyper_util::rt::TokioIo;
+use serde_json::{Value, json};
+use std::{convert::Infallible, io::Cursor, sync::Arc, time::Duration};
+use tokio::{
+    net::TcpListener,
+    sync::{Mutex as AsyncMutex, oneshot},
+    task::JoinHandle,
+    time::timeout,
+};
+use tokio_rustls::TlsAcceptor;
+use tokio_tungstenite::{
+    MaybeTlsStream, WebSocketStream, connect_async,
+    tungstenite::{Error as WsError, Message, client::IntoClientRequest},
+};
+use wiremock::{
+    Mock, MockServer, ResponseTemplate,
+    matchers::{method, path},
+};
+use zeroclaw_config::schema::{
+    AliasedAgentConfig, ModelProviderConfig, OpenAIModelProviderConfig, WireApi,
+};
+use zeroclaw_providers::stateless::MAX_PROMPT_BYTES;
+
+const TEST_TOKEN: &str = "zc_test_token";
+const AGENT: &str = "fixture";
+const PROVIDER: &str = "openai.fixture";
+const MODEL: &str = "fixture-model";
+const SESSION: &str = "stateless-session";
+const FRAME_TIMEOUT: Duration = Duration::from_secs(3);
+const TEST_SEALED_ID: &str = "U0lEMQ_native-fixture";
+
+type ClientSocket = WebSocketStream<MaybeTlsStream<tokio::net::TcpStream>>;
+
+/// Cancels the test-only listener if an assertion exits early.
+struct AbortOnDrop(Option<JoinHandle<()>>);
+
+impl Drop for AbortOnDrop {
+    fn drop(&mut self) {
+        if let Some(handle) = self.0.take() {
+            handle.abort();
+        }
+    }
+}
+
+struct SledAuthFixture {
+    uri: String,
+    ca: tempfile::NamedTempFile,
+}
+
+static SLED_AUTH_FIXTURE: tokio::sync::OnceCell<SledAuthFixture> =
+    tokio::sync::OnceCell::const_new();
+
+#[allow(clippy::disallowed_methods)] // The fixture owns a dedicated test runtime thread.
+async fn sled_auth_fixture() -> &'static SledAuthFixture {
+    SLED_AUTH_FIXTURE
+        .get_or_init(|| async {
+            let _ = rustls::crypto::ring::default_provider().install_default();
+            let ca_key = rcgen::KeyPair::generate().expect("generate fixture CA key");
+            let mut ca_params = rcgen::CertificateParams::new(vec!["OP-DBUS test CA".to_string()])
+                .expect("fixture CA parameters");
+            ca_params.is_ca = rcgen::IsCa::Ca(rcgen::BasicConstraints::Unconstrained);
+            let ca_cert = ca_params
+                .self_signed(&ca_key)
+                .expect("self-sign fixture CA");
+            let mut server_params = rcgen::CertificateParams::new(vec!["127.0.0.1".to_string()])
+                .expect("fixture server parameters");
+            server_params.is_ca = rcgen::IsCa::NoCa;
+            let server_key = rcgen::KeyPair::generate().expect("generate fixture server key");
+            let server_cert = server_params
+                .signed_by(&server_key, &ca_cert, &ca_key)
+                .expect("sign fixture server certificate");
+
+            let mut cert_reader = Cursor::new(server_cert.pem());
+            let certs = rustls_pemfile::certs(&mut cert_reader)
+                .collect::<Result<Vec<_>, _>>()
+                .expect("parse fixture server certificate");
+            let mut key_reader = Cursor::new(server_key.serialize_pem());
+            let key = rustls_pemfile::private_key(&mut key_reader)
+                .expect("parse fixture server key")
+                .expect("fixture server key exists");
+            let tls = TlsAcceptor::from(Arc::new(
+                rustls::ServerConfig::builder()
+                    .with_no_client_auth()
+                    .with_single_cert(certs, key)
+                    .expect("build fixture TLS configuration"),
+            ));
+            let listener =
+                std::net::TcpListener::bind("127.0.0.1:0").expect("bind sled auth fixture");
+            listener
+                .set_nonblocking(true)
+                .expect("configure sled auth fixture listener");
+            let address = listener.local_addr().expect("sled auth fixture address");
+            std::thread::spawn(move || {
+                let runtime = tokio::runtime::Builder::new_current_thread()
+                    .enable_all()
+                    .build()
+                    .expect("build sled auth fixture runtime");
+                runtime.block_on(async move {
+                    let listener =
+                        TcpListener::from_std(listener).expect("adopt sled auth fixture listener");
+                    while let Ok((stream, _)) = listener.accept().await {
+                        let tls = tls.clone();
+                        tokio::spawn(async move {
+                            let Ok(stream) = tls.accept(stream).await else {
+                                return;
+                            };
+                            let service = service_fn(|request: Request<Incoming>| async move {
+                                let header_ok = request
+                                    .headers()
+                                    .get(zeroclaw_providers::sled_identity::SEALED_ID_HEADER)
+                                    .and_then(|value| value.to_str().ok())
+                                    == Some(TEST_SEALED_ID);
+                                let body = request
+                                    .into_body()
+                                    .collect()
+                                    .await
+                                    .ok()
+                                    .map(|b| b.to_bytes());
+                                let ping_ok = body
+                                    .as_deref()
+                                    .and_then(|bytes| serde_json::from_slice::<Value>(bytes).ok())
+                                    .is_some_and(|value| {
+                                        value.get("jsonrpc").and_then(Value::as_str) == Some("2.0")
+                                            && value.get("id").and_then(Value::as_str)
+                                                == Some("sled-auth")
+                                            && value.get("method").and_then(Value::as_str)
+                                                == Some("ping")
+                                    });
+                                let (status, body) = if header_ok && ping_ok {
+                                    (
+                                        StatusCode::OK,
+                                        r#"{"jsonrpc":"2.0","id":"sled-auth","result":{}}"#,
+                                    )
+                                } else {
+                                    (StatusCode::UNAUTHORIZED, r#"{"error":"unauthorized"}"#)
+                                };
+                                Ok::<_, Infallible>(
+                                    Response::builder()
+                                        .status(status)
+                                        .header("content-type", "application/json")
+                                        .body(Full::new(Bytes::from_static(body.as_bytes())))
+                                        .expect("fixture auth response"),
+                                )
+                            });
+                            let _ = http1::Builder::new()
+                                .serve_connection(TokioIo::new(stream), service)
+                                .await;
+                        });
+                    }
+                });
+            });
+            let mut ca = tempfile::NamedTempFile::new().expect("create fixture CA file");
+            std::io::Write::write_all(&mut ca, ca_cert.pem().as_bytes()).expect("write fixture CA");
+            let fixture = SledAuthFixture {
+                uri: format!("https://{address}/mcp"),
+                ca,
+            };
+            // OnceCell serializes these process-global test settings before it
+            // publishes the fixture to concurrent test tasks.
+            unsafe {
+                std::env::set_var("OPDBUS_SLED_AUTH_URL", &fixture.uri);
+                std::env::set_var("OPDBUS_SLED_CA_FILE", fixture.ca.path());
+            }
+            fixture
+        })
+        .await
+}
+
+async fn configure_sled_auth_fixture() {
+    let _ = sled_auth_fixture().await;
+}
+
+async fn provider_fixture() -> MockServer {
+    let provider = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/chat/completions"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "choices": [{"message": {"content": "provider reply"}}],
+            "usage": {"prompt_tokens": 7, "completion_tokens": 3}
+        })))
+        .mount(&provider)
+        .await;
+    provider
+}
+
+#[derive(Clone)]
+struct StreamingResponsesState {
+    requests: Arc<parking_lot::Mutex<Vec<Value>>>,
+    release: Arc<AsyncMutex<Option<oneshot::Receiver<()>>>>,
+}
+
+struct StreamingResponsesFixture {
+    uri: String,
+    requests: Arc<parking_lot::Mutex<Vec<Value>>>,
+    release: Option<oneshot::Sender<()>>,
+    _server: AbortOnDrop,
+}
+
+impl StreamingResponsesFixture {
+    fn release_completion(&mut self) {
+        self.release
+            .take()
+            .expect("completion has not yet been released")
+            .send(())
+            .expect("SSE completion receiver must remain attached");
+    }
+}
+
+async fn streaming_responses_handler(
+    State(state): State<StreamingResponsesState>,
+    Json(request): Json<Value>,
+) -> impl IntoResponse {
+    state.requests.lock().push(request);
+    let release = state
+        .release
+        .lock()
+        .await
+        .take()
+        .expect("the stateless fixture accepts exactly one provider request");
+    let delta = stream::once(async {
+        Ok::<_, Infallible>(Bytes::from_static(
+            b"data: {\"type\":\"response.output_text.delta\",\"delta\":\"streamed delta\"}\n\n",
+        ))
+    });
+    let completion = stream::once(async move {
+        let _ = release.await;
+        Ok::<_, Infallible>(Bytes::from_static(
+            b"data: {\"type\":\"response.completed\",\"response\":{\"output_text\":\"streamed delta\",\"usage\":{\"input_tokens\":11,\"output_tokens\":4}}}\n\n",
+        ))
+    });
+    (
+        [(header::CONTENT_TYPE, "text/event-stream")],
+        Body::from_stream(delta.chain(completion)),
+    )
+        .into_response()
+}
+
+async fn streaming_responses_fixture() -> StreamingResponsesFixture {
+    let (release, completion) = oneshot::channel();
+    let requests = Arc::new(parking_lot::Mutex::new(Vec::new()));
+    let state = StreamingResponsesState {
+        requests: Arc::clone(&requests),
+        release: Arc::new(AsyncMutex::new(Some(completion))),
+    };
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind loopback SSE fixture");
+    let addr = listener.local_addr().expect("SSE fixture listener address");
+    let app = Router::new()
+        .route("/v1/responses", post(streaming_responses_handler))
+        .with_state(state);
+    let handle = ::zeroclaw_spawn::spawn!(async move {
+        let _ = axum::serve(listener, app).await;
+    });
+    StreamingResponsesFixture {
+        uri: format!("http://{addr}/v1/responses"),
+        requests,
+        release: Some(release),
+        _server: AbortOnDrop(Some(handle)),
+    }
+}
