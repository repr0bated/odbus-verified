+++ b/tests/threetched_branding.rs
@@ -0,0 +1,76 @@
+//! Exercise the distribution's threetched introspection boundary with no live data.
+
+use std::process::Command;
+
+#[test]
+fn branded_introspection_does_not_initialize_a_runtime_installation() {
+    let canonical = tempfile::tempdir().unwrap();
+    let legacy = tempfile::tempdir().unwrap();
+    let binary = env!("CARGO_BIN_EXE_threetched");
+    for args in [
+        vec!["--version"],
+        vec!["--help"],
+        vec!["skills", "bundle", "--help"],
+        vec!["config", "schema"],
+        vec!["config", "schema", "--path", "agents"],
+    ] {
+        let output = Command::new(binary)
+            .args(&args)
+            .env_clear()
+            .env("THREETCHED_CONFIG_DIR", canonical.path())
+            .env("ZEROCLAW_CONFIG_DIR", legacy.path())
+            .env("LANGUAGE", "en")
+            .env("LC_ALL", "C")
+            .env("LANG", "C")
+            .env("NO_COLOR", "1")
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{args:?}: {:?}", output.stderr);
+        let text = std::str::from_utf8(&output.stdout).unwrap();
+        if args == ["--version"] {
+            assert_eq!(text.trim(), concat!("threetched ", env!("CARGO_PKG_VERSION")));
+        } else if args.contains(&"--help") {
+            assert!(text.contains("Usage: threetched"), "{args:?}");
+            assert!(!text.contains("Usage: zeroclaw"), "{args:?}");
+        } else {
+            let schema: serde_json::Value = serde_json::from_str(text).unwrap();
+            assert!(schema.is_object());
+            if args.contains(&"--path") {
+                assert_eq!(schema["x-zeroclaw-requested-path"], "agents");
+            }
+        }
+        assert_eq!(std::fs::read_dir(canonical.path()).unwrap().count(), 0);
+        assert_eq!(std::fs::read_dir(legacy.path()).unwrap().count(), 0);
+    }
+}
+
+#[test]
+fn host_managed_update_rejects_checks_and_installs_without_creating_files() {
+    let canonical = tempfile::tempdir().unwrap();
+    let legacy = tempfile::tempdir().unwrap();
+    for args in [
+        vec!["update", "--check", "--json"],
+        vec!["update", "--force"],
+    ] {
+        let output = Command::new(env!("CARGO_BIN_EXE_threetched"))
+            .args(&args)
+            .env_clear()
+            .env("THREETCHED_CONFIG_DIR", canonical.path())
+            .env("ZEROCLAW_CONFIG_DIR", legacy.path())
+            .env("LANGUAGE", "en")
+            .env("LC_ALL", "C")
+            .env("LANG", "C")
+            .env("NO_COLOR", "1")
+            .output()
+            .unwrap();
+        assert!(!output.status.success(), "{args:?}");
+        assert!(output.stdout.is_empty(), "{args:?}: {:?}", output.stdout);
+        let error = std::str::from_utf8(&output.stderr).unwrap();
+        assert!(
+            error.contains(zeroclaw_config::HOST_RELEASE_UPDATE_MESSAGE),
+            "{args:?}: {error}"
+        );
+        assert_eq!(std::fs::read_dir(canonical.path()).unwrap().count(), 0);
+        assert_eq!(std::fs::read_dir(legacy.path()).unwrap().count(), 0);
+    }
+}
