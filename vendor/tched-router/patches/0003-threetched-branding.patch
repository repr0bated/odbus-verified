+/// Emit the upstream-owned static schema without loading, creating, migrating,
+/// or decrypting a runtime installation. The normal config dispatch shares
+/// this renderer so introspection never grows a second schema definition.
+fn print_config_schema(path: Option<&str>) -> Result<()> {
+    #[cfg(feature = "schema-export")]
+    {
+        let schema = schemars::schema_for!(config::Config);
+        let value = match path {
+            None => serde_json::to_value(&schema)
+                .context("failed to serialize JSON Schema")?,
+            Some(prop_path) => {
+                let full = serde_json::to_value(&schema)
+                    .context("failed to serialize JSON Schema")?;
+                let mut out = full;
+                if let serde_json::Value::Object(ref mut map) = out {
+                    // Preserve the existing upstream schema metadata key.
+                    map.insert(
+                        "x-zeroclaw-requested-path".into(),
+                        serde_json::Value::String(prop_path.into()),
+                    );
+                }
+                out
+            }
+        };
+        println!("{}", serde_json::to_string_pretty(&value)?);
+        Ok(())
+    }
+    #[cfg(not(feature = "schema-export"))]
+    {
+        let _ = path;
+        anyhow::bail!("threetched was built without the 'schema-export' feature")
+    }
+}
