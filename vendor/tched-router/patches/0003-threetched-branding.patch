@@ -0,0 +1,45 @@
+//! threetched executable compatibility for the lowercase threetched distribution.
+//!
+//! The pinned upstream implementation still consumes ZEROCLAW_* variables.
+//! Canonical THREETCHED_* variables override matching legacy names without
+//! changing credentials, configuration contents, or existing selected paths.
+
+use std::ffi::{OsStr, OsString};
+
+fn compatibility_name(name: &OsStr) -> Option<OsString> {
+    let suffix = name.to_str()?.strip_prefix("THREETCHED_")?;
+    (!suffix.is_empty()).then(|| OsString::from(format!("ZEROCLAW_{suffix}")))
+}
+
+/// Run before constructing the CLI or Tokio worker threads. Values stay opaque
+/// OS strings and are never logged, copied into files, or interpreted here.
+pub(crate) fn install_environment_aliases() {
+    let aliases: Vec<_> = std::env::vars_os()
+        .filter_map(|(name, value)| compatibility_name(&name).map(|name| (name, value)))
+        .collect();
+    for (name, value) in aliases {
+        // SAFETY: the executable calls this from synchronous main before any
+        // framework runtime, worker thread, or environment consumer starts.
+        unsafe { std::env::set_var(name, value) };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn canonical_environment_aliases_preserve_suffix_and_legacy_names() {
+        assert_eq!(
+            compatibility_name(OsStr::new("THREETCHED_CONFIG_DIR")),
+            Some(OsString::from("ZEROCLAW_CONFIG_DIR"))
+        );
+        assert_eq!(
+            compatibility_name(OsStr::new("THREETCHED_providers__models__test__api_key")),
+            Some(OsString::from("ZEROCLAW_providers__models__test__api_key"))
+        );
+        assert_eq!(compatibility_name(OsStr::new("ZEROCLAW_CONFIG_DIR")), None);
+        assert_eq!(compatibility_name(OsStr::new("THREETCHED_")), None);
+        assert_eq!(compatibility_name(OsStr::new("OTHER_CONFIG_DIR")), None);
+    }
+}
