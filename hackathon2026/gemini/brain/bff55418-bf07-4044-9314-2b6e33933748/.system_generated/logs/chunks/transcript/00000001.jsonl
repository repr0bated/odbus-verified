{"step_index":111,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-27T01:58:41Z","content":"Created At: 2026-10-27T01:58:41Z\nCompleted At: 2026-10-27T01:58:41Z\nShowing lines 71-140 of 281\n71:     (\"agents\", \"software\"),\n72: ];\n73: \n74: /// Resolve a possibly-aliased category to the OSCAL category it means.\n75: ///\n76: /// Non-aliased values pass through untouched, so this is safe to call on any\n77: /// category — including internal ones, which have no OSCAL equivalent and are\n78: /// deliberately returned as-is rather than forced into the standard vocabulary.\n79: pub fn canonical_category(category: &str) -> &str {\n80:     CATEGORY_ALIASES\n81:         .iter()\n82:         .find(|(alias, _)| *alias == category)\n83:         .map(|(_, oscal)| *oscal)\n84:         .unwrap_or(category)\n85: }\n86: \n87: /// Every accepted value for a subid's second segment: OSCAL, internal, and\n88: /// aliases. Presented to consumers as simply the `category`.\n89: pub fn component_types() -> impl Iterator<Item = &'static str> {\n90:     OSCAL_COMPONENT_TYPES\n91:         .iter()\n92:         .chain(INTERNAL_CATEGORIES.iter())\n93:         .copied()\n94:         .chain(CATEGORY_ALIASES.iter().map(|(alias, _)| *alias))\n95: }\n96: \n97: /// Whether `candidate` is an accepted category from either vocabulary.\n98: pub fn is_component_type(candidate: &str) -> bool {\n99:     component_types().any(|t| t == candidate)\n100: }\n101: \n102: /// Regex validating an OSCAL subid.\n103: ///\n104: /// Shared between the schemars adapter, the canonical subid registry schema,\n105: /// and any runtime validation that wants a single source of truth for the\n106: /// taxonomy format. Built from [`SUBID_CATEGORIES`], [`OSCAL_COMPONENT_TYPES`]\n107: /// and [`INTERNAL_CATEGORIES`] so a vocabulary change cannot leave the regex\n108: /// behind — adding a category is a one-line edit to one list.\n109: pub fn subid_regex() -> &'static str {\n110:     static PATTERN: std::sync::OnceLock<String> = std::sync::OnceLock::new();\n111:     PATTERN.get_or_init(|| {\n112:         let segment = r\"[a-z0-9]+(?:-[a-z0-9]+)*\";\n113:         let types: Vec<&str> = component_types().collect();\n114:         format!(\n115:             r\"^({})\\.({})\\.{segment}\\.{segment}(?:\\.{segment}){{0,2}}(?:@v[1-9][0-9]*)?$\",\n116:             SUBID_CATEGORIES.join(\"|\"),\n117:             types.join(\"|\"),\n118:         )\n119:     })\n120: }\n121: \n122: /// Validate a subid string against the canonical regex.\n123: pub fn validate_subid(subid: &str) -> Result<(), String> {\n124:     static RE: std::sync::OnceLock<Regex> = std::sync::OnceLock::new();\n125:     let re = RE.get_or_init(|| Regex::new(subid_regex()).expect(\"subid_regex is valid\"));\n126:     if re.is_match(subid) {\n127:         Ok(())\n128:     } else {\n129:         Err(format!(\"subid does not match required pattern: {subid}\"))\n130:     }\n131: }\n132: \n133: /// Return the metadata fields that are required for a given subid category.\n134: ///\n135: /// Per AGENTS.md §4a:\n136: /// - `mut` requires `actor_id` and `capability_id`\n137: /// - `evt` requires `event_id` or `event_hash`\n138: /// - `src` requires `source_system` and `source_locator`\n139: /// - all other categories have no additional required metadata fields\n140: pub fn category_required_fields(category: &str) -> &'static [&'static str] {"}
