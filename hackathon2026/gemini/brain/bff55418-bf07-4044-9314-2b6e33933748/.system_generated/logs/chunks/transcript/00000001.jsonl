{"step_index":113,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-27T01:58:50Z","content":"Created At: 2026-10-27T01:58:50Z\nCompleted At: 2026-10-27T01:58:50Z\nShowing lines 1-60 of 605\n1: //! OSCAL Subid Registry plugin — sealed subid discovery and review metadata.\n2: //!\n3: //! Every D-Bus object, plugin, schema, mutation, event, and tool carries two\n4: //! identifiers: a `uuid` (machine identity) and a `subid` (human-readable\n5: //! operational taxonomy key). Runtime membership comes only from the sealed\n6: //! plugin catalog; this plugin can annotate an existing subid but cannot mint\n7: //! one.\n8: //!\n9: //! Compliance refs live in metadata arrays — never inside the subid string itself.\n10: \n11: use anyhow::{Result, bail};\n12: use op_state::{ApplyResult, Checkpoint, PluginCapabilities, StateDiff, StatePlugin};\n13: use op_state_store::PluginSchema;\n14: use serde::{Deserialize, Serialize};\n15: use simd_json::OwnedValue as Value;\n16: \n17: use super::oscal_field_classification::{ASSESS_CAPABILITY, AssessFieldsInput, FieldAssessment};\n18: use super::oscal_subid_registry_methods::{\n19:     ExportInput, ExportOutput, ListByCategoryInput, ListByCategoryOutput, LookupInput,\n20:     LookupOutput, RegisterInput, RegisterOutput, ResolveInput, ResolveOutput,\n21: };\n22: \n23: // ── Defaults for serde ───────────────────────────────────────────────────────\n24: \n25: fn default_version() -> u32 {\n26:     1\n27: }\n28: \n29: fn default_authority_rank() -> i64 {\n30:     100\n31: }\n32: \n33: // ── Examples for schemars ────────────────────────────────────────────────────\n34: \n35: fn example_uuid() -> String {\n36:     \"a1b2c3d4-e5f6-7890-abcd-ef0123456789\".to_string()\n37: }\n38: \n39: fn example_subid() -> String {\n40:     \"mut.service.state-sync.apply-patch@v1\".to_string()\n41: }\n42: \n43: fn example_category() -> OscalSubidCategory {\n44:     OscalSubidCategory::Mut\n45: }\n46: \n47: fn example_component_type() -> OscalComponentType {\n48:     OscalComponentType::Service\n49: }\n50: \n51: fn example_subject() -> String {\n52:     \"state-sync\".to_string()\n53: }\n54: \n55: fn example_verb() -> String {\n56:     \"apply-patch\".to_string()\n57: }\n58: \n59: fn example_facet() -> Option<String> {\n60:     Some(\"rollback\".to_string())"}
