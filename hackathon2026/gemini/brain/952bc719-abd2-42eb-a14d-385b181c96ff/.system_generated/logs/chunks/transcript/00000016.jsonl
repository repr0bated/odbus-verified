{"step_index":1418,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T12:34:21Z","content":"Created At: 2026-10-26T12:34:21Z\nCompleted At: 2026-10-26T12:34:21Z\nShowing lines 121-250 of 1743\n121:     async fn rollback(&self, _checkpoint: &Checkpoint) -> Result<()> {\n122:         anyhow::bail!(\"cognitive has no plugin-owned mutable state to roll back\")\n123:     }\n124: \n125:     fn capabilities(&self) -> PluginCapabilities {\n126:         PluginCapabilities {\n127:             supports_rollback: false,\n128:             supports_checkpoints: false,\n129:             supports_verification: true,\n130:             atomic_operations: false,\n131:         }\n132:     }\n133: }\n134: \n135: // ── Schema-derived state for cognitive ─────────────────────────────────────\n136: \n137: #[derive(Debug, Clone, Serialize, Deserialize, schemars::JsonSchema, PartialEq)]\n138: #[serde(rename_all = \"snake_case\")]\n139: pub enum AuthStatus {\n140:     None,\n141:     ChromeProfile,\n142:     Cookie,\n143:     ApiKey,\n144: }\n145: \n146: impl Default for AuthStatus {\n147:     fn default() -> Self {\n148:         Self::None\n149:     }\n150: }\n151: \n152: fn default_auth_status() -> AuthStatus {\n153:     AuthStatus::default()\n154: }\n155: \n156: fn example_auth_status() -> AuthStatus {\n157:     AuthStatus::ChromeProfile\n158: }\n159: \n160: #[derive(Debug, Clone, Serialize, Deserialize, schemars::JsonSchema, PartialEq)]\n161: #[serde(rename_all = \"snake_case\")]\n162: pub enum GeminiMode {\n163:     Query,\n164:     DeepResearch,\n165: }\n166: \n167: impl Default for GeminiMode {\n168:     fn default() -> Self {\n169:         Self::Query\n170:     }\n171: }\n172: \n173: fn default_gemini_mode() -> GeminiMode {\n174:     GeminiMode::default()\n175: }\n176: \n177: #[derive(Debug, Clone, Serialize, Deserialize, schemars::JsonSchema, PartialEq)]\n178: #[serde(rename_all = \"snake_case\")]\n179: pub enum MemoryOperation {\n180:     Store,\n181:     Ret