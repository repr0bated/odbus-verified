nment root: $ROOT\" >&2; exit 78;;\n34: esac\n35: case \"$ROOT\" in\n36:     */current/*|*/releases/*|/opt/op-dbus/execution-python) echo \"refusing live execution environment root: $ROOT\" >&2; exit 78;;\n37: esac\n38: python_version=$(\"$PYTHON\" -c 'import sys; print(\"%d.%d\" % sys.version_info[:2])')\n39: case \"$python_version\" in 3.14) ;; *) echo \"execution environment requires native Python 3.14, found $python_version\" >&2; exit 78;; esac\n40: lock_sha=$(sha256sum \"$LOCK\" | awk '{print $1}')\n41: runtime_sha=$(sha256sum \"$PYTHON\" | cut -d' ' -f1)\n42: preparer_sha=$(sha256sum \"$0\" | cut -d' ' -f1)\n43: if [ -d \"$ROOT\" ] && [ ! -L \"$ROOT\" ] &&\n44:    [ -f \"$ROOT/.opdbus-execution-python\" ] &&\n45:    grep -qx \"python=$python_version\" \"$ROOT/.opdbus-execution-python\" &&\n46:    grep -qx \"lock_sha256=$lock_sha\" \"$ROOT/.opdbus-execution-python\" &&\n47:    grep -qx \"runtime=$runtime_mode\" \"$ROOT/.opdbus-execution-python\" &&\n48:    grep -qx \"runtime_sha256=$runtime_sha\" \"$ROOT/.opdbus-execution-python\" &&\n49:    grep -qx \"preparer_sha256=$preparer_sha\" \"$ROOT/.opdbus-execution-python\" &&\n50:    [ -x \"$ROOT/bin/python\" ] && [ -x \"$ROOT/bin/ruff\" ] && [ -x \"$ROOT/bin/mypy\" ]; then\n51:     printf 'unchanged=%s lock_sha256=%s\\n' \"$ROOT\" \"$lock_sha\"\n52:     exit 0\n53: fi\n54: \n55: mkdir -p \"$CACHE\"\n56: export UV_CACHE_DIR=\"$CACHE\"\n57: mkdir -p \"$(dirname -- \"$ROOT\")\"\n58: tmp=$(mktemp -d \"$ROOT.tmp.XXXXXXXX\")\n59: trap 'rm -rf -- \"$tmp\"' EXIT HUP INT TERM\n60: if [ \"$runtime_mode\" = bundled ]; then\n61:     cp -a --reflink=auto --no-preserve=ownership \"$BUNDLE/.\" \"$tmp/\"\n62:     [ \"$(\"$tmp/bin/python\" -c 'import sys; print(sys.base_prefix)')\" = \"$tmp\" ] ||\n63:         { echo \"copied standalone Python runtime is not relocatable\" >&2; exit 78; }\n64:     \"$UV\" pip sync --python \"$tmp/bin/python\" --prefix \"$tmp\" --require-hashes \"$LOCK\"\n65: else\n66:     \"$UV\" venv --python \"$PYTHON\" \"$tmp\" >/dev/null\n67:     \"$UV\" pip sync --python \"$tmp/bin/python\" --require-hashes \"$LOCK\"\n68: fi\n69: # Console scripts otherwise embed the temporary build path in their shebang.\n70: # Use the environment-selected interpreter so the tree remains usable after"}
