{"step_index":1865,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T13:35:32Z","content":"Created At: 2026-10-26T13:35:32Z\nCompleted At: 2026-10-26T13:35:32Z\nShowing lines 1-60 of 686\n1: //! Client of the cognitive owner over the session-bus plugin socket.\n2: //!\n3: //! Production memory/soul/namespace traffic goes through\n4: //! `org.opdbus.v1.PluginV1.Call` on `/org/opdbus/v1/plugins/cognitive`\n5: //! (destination `org.opdbus.v1.plugins`), matching `op-mcp`'s\n6: //! `cognitive_bridge`. Cognitive is the sole CozoDB owner; this crate\n7: //! must not open RocksDB on the serve path.\n8: //!\n9: //! In-process `CognitiveMemoryStore` / `SoulMemoryStore` exist only so unit\n10: //! and integration tests can drive the gRPC service impls against in-memory\n11: //! Cozo.\n12: \n13: use anyhow::{Context, Result, anyhow};\n14: use chrono::{DateTime, Utc};\n15: use op_cognitive::memory_store::{\n16:     CognitiveMemoryStore, EntryQuery, MemoryEntry as StoreEntry, NamespaceKind,\n17: };\n18: use op_cognitive::soul_memory::{\n19:     AgentNamespaceBinding, SoulMemory as StoreSoul, SoulMemoryStore, SoulUpdate,\n20: };\n21: use serde_json::{Value, json};\n22: use std::sync::Arc;\n23: \n24: /// Well-known session bus. Same default as `op-mcp::cognitive_bridge`.\n25: pub const DEFAULT_SESSION_BUS_ADDRESS: &str = \"unix:path=/run/opdbus/session-bus.sock\";\n26: const BRIDGE_BUS_NAME: &str = \"org.opdbus.v1.plugins\";\n27: const PLUGIN_INTERFACE: &str = \"org.opdbus.v1.PluginV1\";\n28: const COGNITIVE_OBJECT_PATH: &str = \"/org/opdbus/v1/plugins/cognitive\";\n29: \n30: /// Reserved namespaces used to persist assistant soul/bindings through the\n31: /// existing `memory_*` plugin methods (those relations are not separate\n32: /// schema methods).\n33: const SOUL_NAMESPACE: &str = \"assistant:soul\";\n34: const BINDING_NAMESPACE: &str = \"assistant:binding\";\n35: const META_KEY: &str = \"_meta\";\n36: \n37: /// Session-bus address used to reach the cognitive plugin.\n38: pub fn default_cognitive_bus_address() -> String {\n39:     std::env::var(\"DBUS_SESSION_BUS_ADDRESS\")\n40:         .or_else(|_| std::env::var(\"COGNITIVE_BUS_ADDRESS\"))\n41:         .unwrap_or_else(|_| DEFAULT_SESSION_BUS_ADDRESS.to_string())\n42: }\n43: \n44: /// D-Bus client for `PluginV1.Call` on the cognitive plugin.\n45: #[derive(Clone)]\n46: pub struct CognitivePluginClient {\n47:     connection: zbus::Connection,\n48: }\n49: \n50: impl CognitivePluginClient {\n51:     pub async fn connect(bus_address: &str) -> Result<Self> {\n52:         let connection = zbus::connection::Builder::address(bus_address)\n53:             .with_context(|| format!(\"invalid session bus address: {bus_address}\"))?\n54:             .build()\n55:             .await\n56:             .with_context(|| format!(\"connecting to session bus at {bus_address}\"))?;\n57:         Ok(Self { connection })\n58:     }\n59: \n60:     pub async fn connect_default() -> Result<Self> {"}
