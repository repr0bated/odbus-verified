{"step_index":1693,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T13:00:21Z","content":"Created At: 2026-10-26T13:00:21Z\nCompleted At: 2026-10-26T13:00:22Z\nShowing lines 1-100 of 115\n1: #!/bin/sh\n2: # Mount physical-seed roots after Incus API readiness, then start only ready\n3: # session instances (including the fixed chatbot alias). Staging names remain\n4: # stopped. This is storage\n5: # readiness, without a bridge/lungs dependency. A service restart observes\n6: # running instances without stopping them; finish never detaches their roots.\n7: exec 2>&1\n8: rm -f /run/opdbus/runit-ready/identity-roots\n9: \n10: wait_dep() {\n11:     sv start \"$1\" >/dev/null 2>&1 || true\n12:     i=0\n13:     until sv check \"$1\" >/dev/null 2>&1; do\n14:         i=$((i + 1))\n15:         [ \"$i\" -ge 90 ] && { echo \"dependency $1 not ready after 90s\" >&2; exit 1; }\n16:         sleep 1\n17:     done\n18: }\n19: \n20: wait_dep incus\n21: \n22: i=0\n23: until incus info >/dev/null 2>&1; do\n24:     i=$((i + 1))\n25:     if [ \"$i\" -ge 60 ]; then\n26:         echo \"incusd API not ready\" >&2\n27:         exit 1\n28:     fi\n29:     sleep 1\n30: done\n31: \n32: helper=/usr/local/libexec/3tched/op-identity-root\n33: gpt=/var/lib/3tched-leaf-pool/.provisioning/3tchedChatbot.boot.json\n34: if [ -e \"$gpt\" ] || [ -L \"$gpt\" ]; then\n35:     /usr/local/libexec/3tched/restore-chatbot-root || exit 1\n36:     /usr/local/libexec/3tched/runit-ready-signal identity-roots\n37:     exec sleep infinity\n38: fi\n39: physical=${OP_IDENTITY_SEED_STATE:-/var/lib/opdbus-runtime/seed-identities}\n40: legacy=${IDENTITIES:-/var/lib/opdbus-runtime/identities}\n41: physical_present=0\n42: seed_readonly_ready=0\n43: failed=0\n44: for receipt in \"$physical\"/*/state.json; do\n45:     [ -e \"$receipt\" ] || [ -L \"$receipt\" ] || continue\n46:     physical_present=1\n47:     name=$(basename \"$(dirname \"$receipt\")\")\n48:     if [ \"$name\" != 3tchedChatbot ] && ! printf '%s' \"$name\" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then\n49:         echo \"physical seed staging receipt $name: boot disabled\"\n50:         continue\n51:     fi\n52:     marker=\"$physical/$name/boot-rea\n<truncated 542 bytes>\nb-3d01-ca12998cae28\"))\n62:     ' \"$receipt\" >/dev/null; then\n63:         echo \"physical seed $name: invalid/incomplete receipt; legacy suppressed\" >&2\n64:         failed=$((failed + 1))\n65:         continue\n66:     fi\n67:     start_on_boot=$(jq -er '.start_on_boot | select(type == \"boolean\") | tostring' \"$marker\") || {\n68:         echo \"physical seed $name: invalid boot completion policy\" >&2\n69:         failed=$((failed + 1))\n70:         continue\n71:     }\n72:     # The physical partition's kernel RO flag is volatile across reboot.\n73:     # The host owner restores it once, after ready/opt-in selection and before\n74:     # any seed-check/up; verification failures stop boot restoration closed.\n75:     if [ \"$seed_readonly_ready\" -eq 0 ]; then\n76:         \"$helper\" seed-readonly || { echo \"physical seed read-only enforcement failed\" >&2; exit 1; }\n77:         seed_readonly_ready=1\n78:     fi\n79:     state=$(incus query \"/1.0/instances/$name/state\" | jq -er '.status') || state=unknown\n80:     case \"$state\" in\n81:         Running)\n82:             if \"$helper\" seed-check \"$name\"; then\n83:                 \"$helper\" seed-lungs \"$name\" || failed=$((failed + 1))\n84:             else failed=$((failed + 1)); fi\n85:             ;;\n86:         Stopped)\n87:             if \"$helper\" seed-up \"$name\" && \"$helper\" seed-lungs \"$name\"; then\n88:                 if [ \"$start_on_boot\" = true ]; then incus start \"$name\" || failed=$((failed + 1))\n89:                 else echo \"physical seed $name: storage restored; boot start disabled\"; fi\n90:             else failed=$((failed + 1)); fi\n91:             ;;\n92:         *) echo \"physical seed $name: unsupported native status $state\" >&2\n93:             failed=$((failed + 1)) ;;\n94:     esac\n95: done\n96: if [ \"$physical_present\" -eq 1 ]; then\n97:     # A direct legacy lower mount conflicts with sprouts from the SAME seed,\n98:     # even for a different identity. Do not invoke legacy `up` in this mode.\n99:     for image in \"$legacy\"/*/identity.img; do\n100:         [ -f \"$image\" ] || continue","truncated_fields":["content"]}
