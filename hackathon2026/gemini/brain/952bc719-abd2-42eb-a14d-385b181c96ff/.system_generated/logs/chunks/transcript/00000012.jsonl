{"step_index":1009,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:36:06Z","content":"Created At: 2026-10-26T11:36:06Z\nCompleted At: 2026-10-26T11:36:06Z\nShowing lines 1-50 of 345\n1: #!/bin/sh\n2: # op-dbus-release: application\n3: exec 2>&1\n4: set -eu\n5: \n6: # This root-controlled opt-in is deliberately absent from default releases.\n7: # Session selectors are operator input, never credentials or model arguments.\n8: filesystem_marker=/etc/op-dbus/threetched-filesystem.enabled\n9: filesystem_session_file=/etc/op-dbus/human-lungs-session\n10: filesystem_root=/run/mounts/3tchedFS\n11: filesystem_root_receipt=/etc/op-dbus/threetched-filesystem.allowed-root-owned\n12: filesystem_enabled=false\n13: protected_filesystem_file() {\n14:     [ -f \"$1\" ] && [ ! -L \"$1\" ] || return 1\n15:     set -- $(stat -c '%u %a' \"$1\")\n16:     [ \"$1\" = 0 ] && { [ \"$2\" = 400 ] || [ \"$2\" = 600 ]; }\n17: }\n18: unset OPDBUS_FILESYSTEM_ROOT OPDBUS_FILESYSTEM_SESSION OPDBUS_FILESYSTEM_READ_HELPER\n19: set --\n20: if [ -e \"$filesystem_marker\" ] || [ -L \"$filesystem_marker\" ]; then\n21:     [ ! -L /etc/op-dbus ] && [ \"$(stat -c '%u %a' /etc/op-dbus)\" = '0 755' ] || exit 78\n22:     protected_filesystem_file \"$filesystem_marker\" || { echo 'tched-router: unprotected filesystem opt-in marker' >&2; exit 78; }\n23:     [ \"$(wc -c <\"$filesystem_marker\")\" -le 6 ] || exit 78\n24:     case \"$(cat \"$filesystem_marker\")\" in\n25:         true) filesystem_enabled=true ;;\n26:         false) ;;\n27:         *) echo 'tched-router: filesystem opt-in marker must contain true or false' >&2; exit 78 ;;\n28:     esac\n29: fi\n30: if [ \"$filesystem_enabled\" = true ]; then\n31:     [ \"$(id -u jeremy)\" = 1001 ] || exit 78\n32:     protected_filesystem_file \"$filesystem_session_file\" || { echo 'tched-router: unprotected human session source' >&2; exit 78; }\n33:     [ \"$(wc -c <\"$filesystem_session_file\")\" -le 37 ] || exit 78\n34:     OPDBUS_FILESYSTEM_ROOT=$filesystem_root\n35:     OPDBUS_FILESYSTEM_SESSION=$(cat \"$filesystem_session_file\")\n36:     OPDBUS_FILESYSTEM_READ_HELPER=1\n37:     printf '%s' \"$OPDBUS_FILESYSTEM_SESSION\" | jq -Re 'test(\"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\")' >/dev/null || exit 78\n38:     export OPDBUS_FILESYSTEM_ROOT OPDBUS_FILESYSTEM_SESSION OPDBUS_FILESYSTEM_READ_HELPER\n39:     set -- OPDBUS_FILESYSTEM_ROOT=\"$OPDBUS_FILESYSTEM_ROOT\" \\\n40:         OPDBUS_FILESYSTEM_SESSION=\"$OPDBUS_FILESYSTEM_SESSION\" OPDBUS_FILESYSTEM_READ_HELPER=1\n41: fi\n42: \n43: # Keep only public service settings across the first exec. The shared\n44: # environment file can contain unrelated provider credentials; none of those\n45: # become ambient input to the router daemon.\n46: if [ \"${TCHED_ROUTER_SANITIZED:-}\" != 1 ]; then\n47:     set -a\n48:     [ -r /etc/op-dbus/environment ] && . /etc/op-dbus/environment\n49:     set +a\n50:     exec env -i TCHED_ROUTER_SANITIZED=1 PATH=/usr/local/libexec/op-dbus/bin:/usr/local/bin:/usr/bin:/bin \\"}
