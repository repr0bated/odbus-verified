{"step_index":565,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:03:08Z","content":"Created At: 2026-10-26T11:03:08Z\nCompleted At: 2026-10-26T11:03:08Z\nShowing lines 1-60 of 122\n1: #!/usr/bin/env bash\n2: set -euo pipefail\n3: \n4: project_root=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n5: static_root=\"${OP_WEB_STATIC_DIR:-/usr/local/share/op-dbus/dashboard}\"\n6: landing=\"${LANDING:-}\"\n7: url_prefix=\"${URL_PREFIX:-}\"\n8: \n9: if [[ -n \"$landing\" && -n \"$url_prefix\" ]]; then\n10:   echo \"Set LANDING or URL_PREFIX, not both\" >&2\n11:   exit 2\n12: fi\n13: if [[ -n \"$landing\" ]]; then\n14:   if [[ ! \"$landing\" =~ ^[A-Za-z0-9._-]+$ || \"$landing\" == \".\" || \"$landing\" == \"..\" ]]; then\n15:     echo \"LANDING must be a single name such as live, prod, or 3tched: $landing\" >&2\n16:     exit 2\n17:   fi\n18:   url_prefix=\"/${landing}/\"\n19: fi\n20: if [[ -z \"$url_prefix\" ]]; then\n21:   echo \"Set LANDING to a mount name (live, prod, 3tched) or URL_PREFIX=/ for the dashboard root\" >&2\n22:   exit 2\n23: fi\n24: if [[ \"$url_prefix\" != \"/\" && \"$url_prefix\" != /*/ ]]; then\n25:   echo \"URL_PREFIX must begin and end with '/': $url_prefix\" >&2\n26:   exit 2\n27: fi\n28: \n29: relative_path=\"${url_prefix#/}\"\n30: relative_path=\"${relative_path%/}\"\n31: if [[ \"$relative_path\" == *\"..\"* || \"$relative_path\" == *\"//\"* ]]; then\n32:   echo \"URL_PREFIX must identify a safe path: $url_prefix\" >&2\n33:   exit 2\n34: fi\n35: if [[ -n \"$relative_path\" && ! \"$relative_path\" =~ ^[A-Za-z0-9._/-]+$ ]]; then\n36:   echo \"URL_PREFIX contains unsupported characters: $url_prefix\" >&2\n37:   exit 2\n38: fi\n39: if [[ \"$static_root\" != /* || \"$static_root\" == \"/\" ]]; then\n40:   echo \"OP_WEB_STATIC_DIR must be a specific absolute directory: $static_root\" >&2\n41:   exit 2\n42: fi\n43: \n44: if [[ -z \"$relative_path\" ]]; then\n45:   # Root mount: this UI is op-web's dashboard. Only this build's own files are\n46:   # replaced (assets/ and index.html); sibling mounts and host-owned files in the\n47:   # static root are left alone.\n48:   target_dir=\"${static_root%/}\"\n49: else\n50:   target_dir=\"${static_root%/}/$relative_path\"\n51: fi\n52: \n53: cd \"$project_root\"\n54: SVELTEKIT_BASE_PATH=\"${url_prefix%/}\" npm run build\n55: \n56: # A new index replaces any host-injected runtime configuration. Verify the\n57: # build contains its own public endpoints before replacing the served files.\n58: node --input-type=module <<'NODE'\n59: import { readFileSync, readdirSync } from \"node:fs\";\n60: import { loadEnv } from \"vite\";"}
