{"step_index":1383,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T12:32:18Z","content":"Created At: 2026-10-26T12:32:18Z\nCompleted At: 2026-10-26T12:32:18Z\nShowing lines 1-60 of 217\n1: //! 🛷 Doctor Diagnostics — R15\n2: //!\n3: //! Comprehensive system diagnostics: auth status, quota, memory store\n4: //! health, session state, NotebookLM bridge status, Gemini fallback,\n5: //! and query history.\n6: \n7: use serde::{Deserialize, Serialize};\n8: use std::sync::Arc;\n9: \n10: use crate::gemini_fallback::GeminiFallback;\n11: use crate::memory_store::CognitiveMemoryStore;\n12: use crate::quota::QuotaManager;\n13: use crate::session::SessionManager;\n14: use crate::tool_profiles;\n15: \n16: #[derive(Debug, Clone, Serialize, Deserialize)]\n17: pub struct DiagnosticReport {\n18:     pub timestamp: String,\n19:     pub overall_status: String,\n20:     pub components: Vec<ComponentStatus>,\n21:     pub recommendations: Vec<String>,\n22: }\n23: \n24: #[derive(Debug, Clone, Serialize, Deserialize)]\n25: pub struct ComponentStatus {\n26:     pub name: String,\n27:     pub status: String,\n28:     pub details: serde_json::Value,\n29: }\n30: \n31: /// Run full diagnostics across all components.\n32: pub async fn run_diagnostics(\n33:     memory_store: &Arc<CognitiveMemoryStore>,\n34:     session_manager: &Arc<SessionManager>,\n35:     quota_manager: &Arc<QuotaManager>,\n36:     gemini: &Arc<GeminiFallback>,\n37: ) -> DiagnosticReport {\n38:     let mut components = Vec::new();\n39:     let mut recommendations = Vec::new();\n40:     let mut all_ok = true;\n41: \n42:     // 1. Memory Store\n43:     match memory_store.get_stats().await {\n44:         Ok(stats) => {\n45:             components.push(ComponentStatus {\n46:                 name: \"memory_store\".into(),\n47:                 status: \"ok\".into(),\n48:                 details: serde_json::json!({\n49:                     \"total_namespaces\": stats.total_namespaces,\n50:                     \"total_entries\": stats.total_entries,\n51:                     \"entries_by_kind\": stats.entries_by_kind,\n52:                 }),\n53:             });\n54:         }\n55:         Err(e) => {\n56:             all_ok = false;\n57:             components.push(ComponentStatus {\n58:                 name: \"memory_store\".into(),\n59:                 status: \"error\".into(),\n60:                 details: serde_json::json!({ \"error\": e.to_string() }),"}
