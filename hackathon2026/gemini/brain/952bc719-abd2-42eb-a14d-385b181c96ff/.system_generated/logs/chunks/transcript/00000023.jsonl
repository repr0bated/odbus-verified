{"step_index":2045,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T14:05:30Z","content":"Created At: 2026-10-26T14:05:30Z\nCompleted At: 2026-10-26T14:05:30Z\nShowing lines 1-59 of 59\n1: #!/usr/bin/env bash\n2: # launch-identity.sh: Instantiate a modular 3tchedFS identity container from JSON template.\n3: set -euo pipefail\n4: \n5: usage() {\n6:     echo \"Usage: $0 <instance-name> <wireguard-pubkey> [session-id]\"\n7:     echo \"Example: $0 id-1 'Env5zPMmM1Zhypu5/DY/yU4PRYW/4AOEq2KZ4OSc+18=' [uuid]\"\n8:     exit 1\n9: }\n10: \n11: [[ $# -ge 2 ]] || usage\n12: INSTANCE_NAME=$1\n13: WG_PUBKEY=$2\n14: SESSION_ID=${3:-$(uuidgen | tr '[:upper:]' '[:lower:]')}\n15: REPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n16: TEMPLATE=\"${REPO_ROOT}/instances/chatbot-template.json\"\n17: PROFILE_DEF=\"${REPO_ROOT}/profiles/3tched-lungs.json\"\n18: COZO_DEV_DIR=\"/var/lib/op-dbus/identity-cozo/devices\"\n19: IMAGE_PATH=\"${COZO_DEV_DIR}/${INSTANCE_NAME}.img\"\n20: \n21: [[ $(id -u) -eq 0 ]] || { echo \"Error: Must be run as root.\" >&2; exit 1; }\n22: \n23: echo \"==> 1. Ensuring 3tched-lungs profile is registered in Incus...\"\n24: if ! incus profile show 3tched-lungs >/dev/null 2>&1; then\n25:     incus query -X POST /1.0/profiles -d @\"${PROFILE_DEF}\"\n26: fi\n27: \n28: echo \"==> 2. Preparing per-container Cozo & leaf storage image...\"\n29: if [[ ! -f \"${IMAGE_PATH}\" ]]; then\n30:     \"${REPO_ROOT}/storage/make-cozo-device.sh\" \"${IMAGE_PATH}\" 20\n31: fi\n32: \n33: echo \"==> 3. Generating instance JSON for ${INSTANCE_NAME} (Session: ${SESSION_ID})...\"\n34: PAYLOAD=$(sed \\\n35:     -e \"s|{{INSTANCE_NAME}}|${INSTANCE_NAME}|g\" \\\n36:     -e \"s|{{DISPLAY_NAME}}|${INSTANCE_NAME}|g\" \\\n37:     -e \"s|{{SESSION_ID}}|${SESSION_ID}|g\" \\\n38:     -e \"s|{{WIREGUARD_PUBKEY}}|${WG_PUBKEY}|g\" \\\n39:     \"${TEMPLATE}\")\n40: \n41: echo \"==> 4. Creating instance via Incus REST API...\"\n42: RESPONSE=$(incus query -X POST /1.0/instances -d \"${PAYLOAD}\")\n43: echo \"${RESPONSE}\" | jq -r '.status // \"ok\"'\n44: \n45: echo \"==> 5. Attaching Cozo disk device to container...\"\n46: incus config device add \"${INSTANCE_NAME}\" cozo-storage disk \\\n47:     source=\"${IMAGE_PATH}\" \\\n48:     path=/dev/cozo-disk\n49: \n50: echo \"==> 6. Starting container ${INSTANCE_NAME}...\"\n51: incus start \"${INSTANCE_NAME}\"\n52: \n53: echo \"==> 7. Initializing storage inside container...\"\n54: # Partition 1 is the Btrfs leaf sprout; partition 2 is ext4 Cozo store\n55: incus exec \"${INSTANCE_NAME}\" -- mkdir -p /persist /var/lib/op-dbus\n56: incus exec \"${INSTANCE_NAME}\" -- mount -t ext4 /dev/cozo-disk2 /var/lib/op-dbus 2>/dev/null || true\n57: incus exec \"${INSTANCE_NAME}\" -- btrfs device add /dev/cozo-disk1 / 2>/dev/null || true\n58: \n59: echo \"==> Successfully launched identity container: ${INSTANCE_NAME} (${SESSION_ID})\""}
