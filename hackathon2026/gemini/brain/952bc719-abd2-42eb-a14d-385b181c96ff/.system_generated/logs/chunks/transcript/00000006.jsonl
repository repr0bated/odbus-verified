{"step_index":628,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:06:03Z","content":"Created At: 2026-10-26T11:06:03Z\nCompleted At: 2026-10-26T11:06:03Z\nShowing lines 61-120 of 175\n61: expected_archive=$(pin source_archive_sha256)\n62: actual_archive=$(sha256sum \"$SOURCE_ARCHIVE\" | awk '{print $1}')\n63: [ \"$actual_archive\" = \"$expected_archive\" ] || {\n64:     printf 'UI source archive does not match the pinned dirty-worktree artifact\\n' >&2\n65:     exit 1\n66: }\n67: expected_manifest=$(pin content_manifest_sha256)\n68: actual_manifest=$(sha256sum \"$SCRIPT_DIR/source-sha256sums\" | awk '{print $1}')\n69: [ \"$actual_manifest\" = \"$expected_manifest\" ] || {\n70:     printf 'UI source content manifest does not match its pin\\n' >&2\n71:     exit 1\n72: }\n73: tar -tzf \"$SOURCE_ARCHIVE\" | awk '\n74:     /^\\// || /(^|\\/)\\.\\.($|\\/)/ { bad=1 }\n75:     !/^3tched-json-render-ui\\// { bad=1 }\n76:     END { exit bad ? 1 : 0 }\n77: ' || { printf 'UI source archive has an unsafe or unexpected path\\n' >&2; exit 1; }\n78: tar -tvzf \"$SOURCE_ARCHIVE\" | awk 'substr($1,1,1) !~ /[-d]/ {bad=1} END {exit bad ? 1 : 0}' || {\n79:     printf 'UI source archive must contain only files and directories\\n' >&2\n80:     exit 1\n81: }\n82: \n83: stage=$(mktemp -d \"${TMPDIR:-/var/tmp}/op-ui-build.XXXXXX\")\n84: tar -xzf \"$SOURCE_ARCHIVE\" -C \"$stage\"\n85: source_root=\"$stage/3tched-json-render-ui\"\n86: asset_base=$(pin asset_base)\n87: door_default=$(pin door_default)\n88: issuer_default=$(pin issuer_default)\n89: [ \"$asset_base\" = \"/\" ] || {\n90:     printf 'production UI asset base must be the dashboard root: %s\\n' \"$asset_base\" >&2\n91:     exit 1\n92: }\n93: [ \"$door_default\" = \"https://10.0.0.2:8090\" ] || {\n94:     printf 'production UI door default is not the pinned :8090 door: %s\\n' \"$door_default\" >&2\n95:     exit 1\n96: }\n97: (cd \"$source_root\" && sha256sum -c \"$SCRIPT_DIR/source-sha256sums\" >/dev/null) || {\n98:     printf 'UI source files do not match the pinned content manifest\\n' >&2\n99:     exit 1\n100: }\n101: listed=$(wc -l < \"$SCRIPT_DIR/source-sha256sums\" | tr -d ' ')\n102: actual=$(find \"$source_root\" -type f | wc -l | tr -d ' ')\n103: [ \"$listed\" = \"$actual\" ] || {\n104:     printf 'UI source archive contains an unmanifested file\\n' >&2\n105:     exit 1\n106: }\n107: [ ! -e \"$source_root/.env\" ] && [ ! -e \"$source_root/.git\" ] &&\n108:     [ ! -e \"$source_root/node_modules\" ] && [ ! -e \"$source_root/dist\" ] || {\n109:         printf 'UI source archive contains a forbidden generated/private path\\n' >&2\n110:         exit 1\n111:     }\n112: \n113: if [ \"$VERIFY_ONLY\" = 1 ]; then\n114:     printf 'verified UI source archive %s (%s files)\\n' \"$actual_archive\" \"$actual\"\n115:     exit 0\n116: fi\n117: \n118: node_version=$(node --version | sed 's/^v//')\n119: node_major=$(printf '%s' \"$node_version\" | awk -F. '{print $1}')\n120: node_minor=$(printf '%s' \"$node_version\" | awk -F. '{print $2}')"}
