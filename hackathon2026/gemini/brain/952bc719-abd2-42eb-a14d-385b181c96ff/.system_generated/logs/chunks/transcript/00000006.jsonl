{"step_index":626,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:05:58Z","content":"Created At: 2026-10-26T11:05:58Z\nCompleted At: 2026-10-26T11:05:59Z\nShowing lines 1-60 of 175\n1: #!/bin/sh\n2: # Verify the pinned portable UI source and emit a build artifact. This helper\n3: # never installs dashboard files or writes to the external UI checkout.\n4: set -eu\n5: \n6: SCRIPT_DIR=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n7: SOURCE_ARCHIVE=\"$SCRIPT_DIR/source.tar.gz\"\n8: OUTPUT_DIR=target/ui-artifacts/3tched-json-render-ui\n9: NPM_CACHE=${NPM_CACHE:-/var/cache/op-dbus-build/npm}\n10: VERIFY_ONLY=0\n11: \n12: usage() {\n13:     cat <<'EOF'\n14: Usage: vendor/3tched-json-render-ui/build-assets.sh [options]\n15:   --source-archive PATH  source archive to verify (default: pinned archive)\n16:   --output-dir PATH      artifact directory\n17:   --npm-cache PATH       npm download cache\n18:   --verify-only          verify provenance and contents without npm/build\n19: EOF\n20: }\n21: \n22: while [ \"$#\" -gt 0 ]; do\n23:     case \"$1\" in\n24:         --source-archive) SOURCE_ARCHIVE=$2; shift 2 ;;\n25:         --output-dir) OUTPUT_DIR=$2; shift 2 ;;\n26:         --npm-cache) NPM_CACHE=$2; shift 2 ;;\n27:         --verify-only) VERIFY_ONLY=1; shift ;;\n28:         -h|--help) usage; exit 0 ;;\n29:         *) printf 'unknown option: %s\\n' \"$1\" >&2; usage >&2; exit 2 ;;\n30:     esac\n31: done\n32: \n33: case \"$OUTPUT_DIR\" in\n34:     /*) ;;\n35:     *) OUTPUT_DIR=$(pwd)/$OUTPUT_DIR ;;\n36: esac\n37: case \"$NPM_CACHE\" in\n38:     /*) ;;\n39:     *) NPM_CACHE=$(pwd)/$NPM_CACHE ;;\n40: esac\n41: \n42: for command in awk find gzip jq npm node sed sha256sum tar wc; do\n43:     command -v \"$command\" >/dev/null 2>&1 || {\n44:         printf 'required command is unavailable: %s\\n' \"$command\" >&2\n45:         exit 1\n46:     }\n47: done\n48: [ -f \"$SOURCE_ARCHIVE\" ] || { printf 'source archive is absent: %s\\n' \"$SOURCE_ARCHIVE\" >&2; exit 1; }\n49: [ -f \"$SCRIPT_DIR/source.pin\" ] || { printf 'source pin is absent\\n' >&2; exit 1; }\n50: [ -f \"$SCRIPT_DIR/source-sha256sums\" ] || { printf 'source manifest is absent\\n' >&2; exit 1; }\n51: \n52: pin() {\n53:     key=$1\n54:     sed -n \"s/^${key}=//p\" \"$SCRIPT_DIR/source.pin\"\n55: }\n56: \n57: [ \"$(pin format)\" = opdbus.3tched-json-render-ui-source.v1 ] || {\n58:     printf 'unsupported UI source pin format\\n' >&2\n59:     exit 1\n60: }"}
