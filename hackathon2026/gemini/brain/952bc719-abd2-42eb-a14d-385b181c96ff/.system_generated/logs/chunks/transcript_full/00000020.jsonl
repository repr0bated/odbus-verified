{"step_index":1416,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T12:34:18Z","content":"Created At: 2026-10-26T12:34:18Z\nCompleted At: 2026-10-26T12:34:18Z\nShowing lines 1-120 of 1743\n1: //! Cognitive state plugin — GB.Cognitive.\n2: //!\n3: //! Declares the cognitive tools compiled into `op-grpc-bridge`. The bridge owns\n4: //! the runtime and publishes its read-only projection to D-Bus under\n5: //! `/org/opdbus/v1/plugins/cognitive`; there is no separately supervised\n6: //! cognitive service or plugin-owned listener configuration.\n7: //!\n8: //! The canonical schema (every gRPC method, every MCP tool, every\n9: //! request/response field) lives in the `cognitive_schema()` function below.\n10: \n11: use anyhow::Result;\n12: use async_trait::async_trait;\n13: use op_state::{ApplyResult, Checkpoint, DiffMetadata, PluginCapabilities, StateDiff, StatePlugin};\n14: use op_state_store::PluginSchema;\n15: use op_state_store::SideEffect;\n16: use serde::{Deserialize, Serialize};\n17: use simd_json::OwnedValue as Value;\n18: \n19: pub use super::cognitive_agents::CatalogExecutionOutput;\n20: use super::plugin_scaffold_helpers::method_decl_from_schemars_with_output;\n21: \n22: // =============================================================================\n23: // PLUGIN ENTRY: identity and typed schema seed\n24: // =============================================================================\n25: \n26: const PLUGIN_NAME: &str = \"cognitive\";\n27: const PLUGIN_VERSION: &str = \"4.1.0\";\n28: const PLUGIN_CATEGORY: &str = \"service\";\n29: const PLUGIN_DESCRIPTION: &str = \"Bridge-owned cognitive tools — memory, code context, and grounded query capabilities compiled into op-grpc-bridge. THE PLUGIN IS THE SCHEMA: every method, tool, property, and field is declared here. Downstream inherits.\";\n30: const PLUGIN_DISPLAY_NAME: &str = \"GB.Cognitive\";\n31: \n32: // =============================================================================\n33: // PLUGIN BODY: D-Bus-backed behavior only\n34: // =============================================================================\n35: \n36: pub struct CognitivePlugin;\n37: \n38: impl CognitivePlugin {\n39:     pub fn new() -> Self {\n40:         Self\n41:     }\n42: }\n43: \n44: impl Default for CognitivePlugin {\n45:     fn default() -> Self {\n46:         Self::new()\n47:     }\n48: }\n49: \n50: // ── StatePlugin impl ─────────────────────────────────────────────────────────\n51: \n52: #[async_trait]\n53: impl StatePlugin for CognitivePlugin {\n54:     fn name(&self) -> &str {\n55:         PLUGIN_NAME\n56:     }\n57:     fn version(&self) -> &str {\n58:         PLUGIN_VERSION\n59:     }\n60: \n61:     fn schema(&self) -> Option<PluginSchema> {\n62:         let mut schema = cognitive_schema();\n63:         super::common::oscal::ensure_category_metadata_fields(&mut schema);\n64:         Some(schema)\n65:     }\n66: \n67:     /// The cognitive runtime is a compiled component of `op-grpc-bridge`.\n68:     ///\n69:     /// Availability is derived from inventory registration plus the bridge's\n70:     /// compile-time dependency, never from a runit directory. This keeps schema\n71:     /// consumers and reflection activation stable after the standalone service\n72:     /// definition is removed.\n73:     fn is_available(&self) -> bool {\n74:         true\n75:     }\n76: \n77:     fn unavailable_reason(&self) -> String {\n78:         \"cognitive is compiled into op-grpc-bridge and has no external service dependency\"\n79:             .into()\n80:     }\n81: \n82:     async fn calculate_diff(&self, current: &Value, desired: &Value) -> Result<StateDiff> {\n83:         // This StatePlugin publishes the bridge-owned projection only. Cognitive\n84:         // mutations are the declared tool methods below and flow through the\n85:         // MutationEngine; there is no declarative service configuration to apply.\n86:         Ok(StateDiff {\n87:             plugin: self.name().into(),\n88:             actions: Vec::new(),\n89:             metadata: DiffMetadata {\n90:                 timestamp: chrono::Utc::now().timestamp(),\n91:                 current_hash: format!(\"{:x}\", md5::compute(simd_json::to_string(current)?)),\n92:                 desired_hash: format!(\"{:x}\", md5::compute(simd_json::to_string(desired)?)),\n93:             },\n94:         })\n95:     }\n96: \n97:     async fn apply_state(&self, diff: &StateDiff) -> Result<ApplyResult> {\n98:         let errors = (!diff.actions.is_empty())\n99:             .then(|| {\n100:                 \"cognitive state is bridge-owned and read-only; invoke a declared cognitive tool method instead\"\n101:                     .to_string()\n102:             })\n103:             .into_iter()\n104:             .collect::<Vec<_>>();\n105:         Ok(ApplyResult {\n106:             success: errors.is_empty(),\n107:             changes_applied: Vec::new(),\n108:             errors,\n109:             checkpoint: None,\n110:         })\n111:     }\n112: \n113:     async fn verify_state(&self, _desired: &Value) -> Result<bool> {\n114:         Ok(true)\n115:     }\n116: \n117:     async fn create_checkpoint(&self) -> Result<Checkpoint> {\n118:         anyhow::bail!(\"cognitive has no plugin-owned mutable state to checkpoint\")\n119:     }\n120: "}
