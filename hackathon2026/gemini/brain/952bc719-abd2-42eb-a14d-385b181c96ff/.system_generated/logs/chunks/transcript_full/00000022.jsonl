ank'\n128:     done\n129:     mount -o ro,subvolid=5 \"$seed_loop\" \"$root_mount\"\n130:     for member in @ @agent_memory @agent_rules @agent_shared @agent_skills @agent_soul @agent_user; do\n131:         btrfs subvolume show \"$root_mount/$member\" >/dev/null || fail \"seed missing $member\"\n132:     done\n133:     phase root-device-add-intent\n134:     btrfs device add \"$root_partition\" \"$root_mount\"\n135:     sync -f \"$root_mount\"\n136:     umount \"$root_mount\"\n137:     mount -o \"rw,subvolid=5,device=$seed_loop,device=$root_partition\" \"$root_partition\" \"$root_mount\"\n138:     phase upgrade-format-intent\n139:     mkfs.btrfs -L 3tched-upgrade \"$upgrade_partition\"\n140:     mount -o rw,subvolid=5 \"$upgrade_partition\" \"$upgrade_mount\"\n141:     btrfs subvolume create \"$upgrade_mount/@\"\n142:     private_fsid=$(blkid -p -s UUID -o value \"$root_partition\")\n143:     [[ -n $private_fsid && $private_fsid != \"$seed_fsid\" &&\n144:        $(findmnt -rn -M \"$root_mount\" -o UUID) == \"$private_fsid\" ]] || fail 'root is not the private sprout'\n145:     # These are private writable descendants, not incremental receive bases.\n146:     # Clear their inherited received_uuid; never change the sealed seed copy.\n147:     for member in @ @agent_memory @agent_rules @agent_skills @agent_user; do\n148:         btrfs property set -f -ts \"$root_mount/$member\" ro false\n149:     done\n150:     for member in @agent_shared @agent_soul; do\n151:         btrfs property set -ts \"$root_mount/$member\" ro true\n152:     done\n153:     install -d -m 0700 \"$root_mount/@agent_user/persist\"\n154:     install -d -m 0755 \"$root_mount/@/opt/run-mounts/persist\"\n155:     sync -f \"$root_mount\"\n156:     sync -f \"$upgrade_mount\"\n157:     jq --arg rf \"$(blkid -p -s UUID -o value \"$root_partition\")\" \\\n158:         --arg uf \"$(blkid -p -s UUID -o value \"$upgrade_partition\")\" \\\n159:         '.root_fsid=$rf|.upgrade_fsid=$uf|.filesystem_prepared=true|.phase=\"filesystems-prepared\"' \"$receipt\" > \"$receipt.new\"\n160:     mv -T \"$receipt.new\" \"$receipt\"\n161:     sync -f \"$receipt_root\"\n162:     printf 'Filesystems prepared; mounts retained for next manual step. Receipt: %s\\n' \"$receipt\"\n163:     exit 0\n164: fi\n165: [[ ! -e $image && ! -L $image ]] || fail 'image already exists; use inspect, never repeat creation'\n166: receipt=$receipt_root/$name.json\n167: [[ ! -e $receipt && ! -L $receipt ]] || fail 'retained preparation intent exists; inspect before any retry'\n168: total_gib=$((root_gib + upgrade_gib))\n169: created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)\n170: jq -n --arg name \"$name\" --arg image \"$image\" --arg pool \"$pool\" --arg time \"$created_at\" \\\n171:     --argjson root \"$root_gib\" --argjson upgrade \"$upgrade_gib\" --argjson total \"$total_gib\" \\\n172:     '{version:1,layout:\"raw-gpt-root-upgrade-v1\",phase:\"disk-***\",\n173:       name:$name,image:$image,pool:$pool,created_at:$time,\n174:       root_gib:$root,upgrade_gib_requested:$upgrade,total_gib:$total,\n175:       identity_registered:false,filesystem_prepared:false}' > \"$receipt\"\n176: # qemu-img creates a sparse raw disk; GPT/alignment overhead reduces partition 2\n177: # slightly. All commands address only the newly created image, never a host disk.\n178: qemu-img create -f raw \"$image\" \"${total_gib}G\"\n179: chmod 0600 \"$image\"\n180: sgdisk --clear \\\n181:     --new=\"1:0:+${root_gib}G\" --typecode=1:8300 --change-name=1:3tched-root \\\n182:     --new=\"2:0:$((total_gib * 2097152 - 2049))\" --typecode=2:8300 --change-name=2:3tched-upgrade \\\n183:     \"$image\"\n184: partition_table=$(sfdisk --json \"$image\")\n185: # Record preparation evidence; the final adoption plan is made after all mounts.\n186: jq --arg inode \"$(stat -c %i \"$image\")\" --argjson bytes \"$(stat -c %s \"$image\")\" \\\n187:     --argjson partition_table \"$partition_table\" \\\n188:     '.phase=\"disk-***\" | .image_inode=$inode | .image_bytes=$bytes |\n189:      .partition_table=$partition_table.partitiontable' \"$receipt\" > \"$receipt.new\"\n190: mv -T -- \"$receipt.new\" \"$receipt\"\n191: sync -f \"$pool\"\n192: printf 'Prepared disk: %s\\nReceipt: %s\\n' \"$image\" \"$receipt\"\n193: printf '%s\\n' 'No filesystems formatted, container created, seed attached, or Cozo binding committed.'"}
