{"step_index":1581,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T12:42:25Z","content":"Created At: 2026-10-26T12:42:25Z\nCompleted At: 2026-10-26T12:42:26Z\nShowing lines 1-100 of 193\n1: #!/usr/bin/env bash\n2: # Completed manual provisioning step: one sparse disk, root + upgrade partitions.\n3: # Storage preparation only; identity registration and container startup are separate.\n4: set -euo pipefail\n5: fail() { printf 'prepare-instance-disk: %s\\n' \"$*\" >&2; exit 1; }\n6: usage() {\n7:     cat <<'USAGE'\n8: Usage:\n9:   prepare-instance-disk create NAME [--root-gib N] [--upgrade-gib N]\n10:   prepare-instance-disk inspect NAME\n11:   prepare-instance-disk prepare NAME --seed-device /dev/disk/by-uuid/UUID\n12: \n13: Pool: /var/lib/incus/storage-pools/3tched-pool (existing loop-backed Btrfs filesystem)\n14: Image: NAME.img, sparse raw, GPT root + upgrade partitions\n15: Defaults: 20 GiB root, remaining approximately 40 GiB upgrade.\n16: GPT creation uses sgdisk (GPT fdisk); sfdisk supplies JSON inspection receipts.\n17: Existing images are never adopted, repartitioned or overwritten by create.\n18: inspect reads the image and reports its partition table; it does not modify it.\n19: USAGE\n20: }\n21: [[ $# -gt 0 ]] || { usage; exit 2; }\n22: case $1 in -h|--help) usage; exit 0 ;; esac\n23: [[ $# -ge 2 ]] || fail 'action and instance name required'\n24: action=$1 name=$2\n25: shift 2\n26: [[ $action == create || $action == inspect || $action == prepare ]] || fail 'unknown action'\n27: [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$ ]] || fail 'invalid instance name'\n28: root_gib=20 upgrade_gib=40 seed_device=\n29: while [[ $# -gt 0 ]]; do\n30:     [[ $action != inspect ]] || fail 'inspect takes no options'\n31:     [[ $# -ge 2 ]] || fail \"missing value for $1\"\n32:     case $1 in\n33:         --root-gib) [[ $action == create ]] || fail 'size applies to create'; root_gib=$2 ;;\n34:         --upgrade-gib) [[ $action == create ]] || fail 'size applies to create'; upgrade_gib=$2 ;;\n35:         --seed-device) [[ $action == prepare ]] || fail 'seed applies to prepare'; seed_device=$2 ;;\n36:         *) fail \"unknown option: $1\" ;;\n37:     esac\n38:     shift 2\n39: done\n40: [[ $(id -u) == 0 ]] || fail 'host root owns disk preparation'\n41: for tool in qemu-img sgdisk sfdisk jq findmnt realpath stat flock date sync; do\n42:     command -v \"$tool\" >/dev/null || fail \"missing $tool\"\n43: done\n44: for size in \"$root_gib\" \"$upgrade_gib\"; do\n45:     [[ $size =~ ^[1-9][0-9]{0,3}$ ]] && (( size <= 1024 )) || fail 'partition size must be 1 to 1024 GiB'\n46: done\n47: pool=/var/lib/incus/storage-pools/3tched-pool\n48: [[ -d $pool && ! -L $pool && $(realpath -e \"$pool\") == \"$pool\" ]] || fail 'leaf pool is absent or noncanonical'\n49: [[ $(findmnt -rn -M \"$pool\" -o FSTYPE) == btrfs &&\n50:    $(findmnt -rn -M \"$pool\" -o FSROOT) == / &&\n51:    $(findmnt -rn -M \"$pool\" -o UUID) == a1ab7b42-12a8-437c-8f65-d0469892c8dd &&\n52:    $(findmnt -rn -M \"$pool\" -o UUID) != \"$(findmnt -rn -M / -o UUID)\" ]] ||\n53:     fail 'expected mounted Incus loop filesystem; refusing a root-directory fallback'\n54: path=$pool\n55: while :; do\n56:     [[ ! -L $path && $(stat -c %u:%g \"$path\") == 0:0 &&\n57:        $(( 8#$(stat -c %a \"$path\") & 022 )) == 0 ]] || fail 'pool ancestry must be root-controlled'\n58:     [[ $path != / ]] || break\n59:     path=$(dirname -- \"$path\")\n60: done\n61: image=$pool/$name.img\n62: if [[ $action == inspect ]]; then\n63:     [[ -f $image && ! -L $image ]] || fail 'image is absent or not a regular file'\n64:     qemu-img info -f raw --output=json \"$image\"\n65:     sfdisk --json \"$image\"\n66:     exit 0\n67: fi\n68: umask 077\n69: receipt_root=$pool/.provisioning\n70: [[ ! -L $receipt_root ]] || fail 'receipt directory is a symlink'\n71: mkdir -p -- \"$receipt_root\"\n72: [[ $(stat -c '%u %a' \"$receipt_root\") == '0 700' ]] || fail 'receipt directory must be root-owned mode 0700'\n73: lock=$receipt_root/$name.lock\n74: [[ ! -L $lock && ( ! -e $lock || -f $lock ) ]] || fail 'invalid instance lock'\n75: exec 9>\"$lock\"\n76: flock -n 9 || fail 'another preparation owns this instance'\n77: receipt=$receipt_root/$name.json\n78: if [[ $action == prepare ]]; then\n79:     for tool in losetup lsblk blkid blockdev btrfs mkfs.btrfs mount umount rg sed install; do\n80:         command -v \"$tool\" >/dev/null || fail \"missing $tool\"\n81:     done\n82:     [[ $seed_device == /dev/disk/by-uuid/* && -b $seed_device ]] || fail 'stable seed UUID path required'\n83:     [[ -f $image && ! -L $image && -f $receipt && ! -L $receipt ]] || fail 'disk and creation receipt required'\n84:     jq -e --arg image \"$image\" --arg name \"$name\" --arg inode \"$(stat -c %i \"$image\")\" \\\n85:         --argjson bytes \"$(stat -c %s \"$image\")\" \\\n86:         '.phase==\"disk-***\" and .image==$image and .name==$name and\n87:          .image_inode==$inode and .image_bytes==$bytes and .identity_registered==false' \"$receipt\" >/dev/null || fail 'not a fresh partitioned disk; never repeat device-add'\n88:     table=$(sfdisk --json \"$image\")\n89:     jq -e --argjson actual \"$table\" '.partition_table==$actual.partitiontable and\n90:         (.partition_table.partitions|length)==2' \"$receipt\" >/dev/null || fail 'partition table differs from receipt'\n91:     [[ -z $(losetup -j \"$image\") ]] || fail 'image already attached'\n92:     seed_fsid=$(blkid -p -s UUID -o value \"$seed_device\")\n93:     [[ $seed_device == /dev/disk/by-uuid/\"$seed_fsid\" ]] || fail 'seed UUID mismatch'\n94:     btrfs inspect-internal dump-super \"$seed_device\" | sed -n '/flags/,/fsid/p' | rg -q SEEDING || fail 'seed is not sealed'\n95:     # UUID aliases may point at an existing loop view. Resolve the physical\n96:     # partition/LV independently and keep the protected backing device explicit.\n97:     physical_seed=$(lsblk -J -o PATH,TYPE,UUID | jq -er --arg uuid \"$seed_