{"step_index":784,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:16:36Z","content":"Created At: 2026-10-26T11:16:36Z\nCompleted At: 2026-10-26T11:16:36Z\nShowing lines 1-50 of 52\n1: //! The threetched service paths shared by tched-router plugin surfaces.\n2: //! Defaults mirror deploy/runit/tched-router/run; service overrides use its\n3: //! THREETCHED_BIN, THREETCHED_MANIFEST and TCHED_ROUTER_CONFIG_DIR variables.\n4: \n5: use std::path::PathBuf;\n6: \n7: use anyhow::{Result, ensure};\n8: \n9: pub const DEFAULT_BINARY: &str = \"/usr/local/libexec/op-dbus/threetched/threetched\";\n10: pub const DEFAULT_CONFIG_DIR: &str = \"/var/lib/tched-router\";\n11: pub const DEFAULT_MANIFEST: &str = \"/usr/share/op-dbus/threetched-manifests/tched-router.json\";\n12: \n13: fn absolute_env_path(name: &str, default: &str) -> Result<PathBuf> {\n14:     let path = std::env::var_os(name)\n15:         .map(PathBuf::from)\n16:         .unwrap_or_else(|| PathBuf::from(default));\n17:     ensure!(path.is_absolute(), \"{name} must be an absolute path\");\n18:     Ok(path)\n19: }\n20: \n21: pub fn binary() -> Result<PathBuf> {\n22:     absolute_env_path(\"THREETCHED_BIN\", DEFAULT_BINARY)\n23: }\n24: \n25: pub fn config_dir() -> Result<PathBuf> {\n26:     absolute_env_path(\"TCHED_ROUTER_CONFIG_DIR\", DEFAULT_CONFIG_DIR)\n27: }\n28: \n29: pub fn manifest() -> Result<PathBuf> {\n30:     absolute_env_path(\"THREETCHED_MANIFEST\", DEFAULT_MANIFEST)\n31: }\n32: \n33: /// Select the binary and provenance manifest used only to capture the sealed\n34: /// CLI contract. Runtime dispatch continues to use [`binary`] and [`manifest`].\n35: /// Build/seal invocations may point these selectors at a not-yet-installed\n36: /// candidate, but must supply the pair together so provenance cannot drift.\n37: pub(crate) fn capture_paths() -> Result<(PathBuf, PathBuf)> {\n38:     match (\n39:         std::env::var_os(\"THREETCHED_CAPTURE_BIN\"),\n40:         std::env::var_os(\"THREETCHED_CAPTURE_MANIFEST\"),\n41:     ) {\n42:         (None, None) => Ok((binary()?, manifest()?)),\n43:         (Some(binary), Some(manifest)) => {\n44:             let binary = PathBuf::from(binary);\n45:             let manifest = PathBuf::from(manifest);\n46:             ensure!(binary.is_absolute(), \"THREETCHED_CAPTURE_BIN must be an absolute path\");\n47:             ensure!(manifest.is_absolute(), \"THREETCHED_CAPTURE_MANIFEST must be an absolute path\");\n48:             Ok((binary, manifest))\n49:         }\n50:         _ => anyhow::bail!(\"THREETCHED_CAPTURE_BIN and THREETCHED_CAPTURE_MANIFEST must be supplied together\"),"}
