{"step_index":458,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T10:49:02Z","content":"Created At: 2026-10-26T10:49:02Z\nCompleted At: 2026-10-26T10:49:02Z\nShowing lines 187-230 of 608\n187: pub fn restore(state: &mut State, inventory: &Inventory) -> Result<()> {\n188:     let plan = state.journal.as_ref().context(\"missing service journal\")?.plan.clone();\n189:     restore_loggers(state, false)?;\n190:     for name in &plan.order {\n191:         let wanted = &plan.wanted[name];\n192:         ensure!(service_path(name).join(\"down\").try_exists()? == wanted.down, \"down marker changed for {name}\");\n193:         ensure!(linked(name)? == (wanted.linked || wanted.new_service), \"enable link changed for {name}\");\n194:         if !wanted.linked && !wanted.new_service { continue; }\n195:         if wanted.new_service { wait_supervisor(name)?; }\n196:         let action = if wanted.want == b'u' { \"up\" } else if wanted.pid != 0 && wanted.state == 1 { \"once\" } else { continue; };\n197:         state.intent(format!(\"service-start:{name}:{action}\"))?;\n198:         state.journal.as_mut().unwrap().allowed.insert(name.clone());\n199:         state.save()?; super::boot::transition(state)?;\n200:         sv(action, name)?;\n201:         sv(\"check\", name)?;\n202:         if let Some(probe) = inventory.services.get(name).and_then(|s| s.probe.as_ref()) {\n203:             fs::secure_absolute(Path::new(&probe[0]), libc::O_RDONLY)?;\n204:             run(Command::new(&probe[0]).args(&probe[1..]), 30)?;\n205:         }\n206:     }\n207:     state.intent(\"services-restored\")\n208: }\n209: pub fn restore_original(state: &mut State) -> Result<()> {\n210:     let plan = state.journal.as_ref().context(\"missing original service journal\")?.plan.clone();\n211:     restore_loggers(state, true)?;\n212:     for name in &plan.order {\n213:         let wanted = &plan.wanted[name];\n214:         if !wanted.linked { continue; }\n215:         ensure!(linked(name)? && service_path(name).join(\"down\").try_exists()? == wanted.down,\n216:             \"original service link/down state differs: {name}\");\n217:         let action = if wanted.want == b'u' { \"up\" } else if wanted.pid != 0 && wanted.state == 1 { \"once\" } else { continue; };\n218:         state.intent(format!(\"restore-original-service:{name}:{action}\"))?;\n219:         sv(action, name)?;\n220:         sv(\"check\", name)?;\n221:     }\n222:     state.intent(\"original-service-state-restored\")\n223: }\n224: fn restore_loggers(state: &mut State, originals: bool) -> Result<()> {\n225:     let wanted = state.journal.as_ref().context(\"missing logger journal\")?.plan.wanted.clone();\n226:     for (name, wanted) in wanted.iter().filter(|(name,_)| name.ends_with(\"/log\")) {\n227:         if !wanted.linked && (originals || !wanted.new_service) { continue; }\n228:         if !service_path(name).join(\"run\").try_exists()? { continue; }\n229:         ensure!(service_path(name).join(\"down\").try_exists()? == wanted.down, \"logger down marker changed\");\n230:         if wanted.new_service { wait_supervisor(name)?; }"}
