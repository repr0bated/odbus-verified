: string; generation: string }>>;\n33:   stateStatus: \"available\" | \"withheld-or-unavailable\" | \"removed\";\n34: }\n35: export interface FeedSnapshot {\n36:   namespace: string;\n37:   plugins: Readonly<Record<string, PluginFeed>>;\n38:   catalogHash: string;\n39:   generation: string;\n40:   status: FeedStatus;\n41: }\n42: export const emptyFeedSnapshot = (namespace = \"public\"): FeedSnapshot => ({\n43:   namespace, plugins: {}, catalogHash: \"\", generation: \"0\", status: { state: \"idle\" },\n44: });\n45: \n46: /** Cursors belong to this subscription namespace + plugin + schema/object path.\n47:  * Audit event IDs are independent and never used as state revisions. */\n48: export class FeedReducer {\n49:   private revisions = new Map<string, bigint>();\n50:   private deletions = new Map<string, { pluginId: string; path: string; generation: bigint }>();\n51:   constructor(public snapshot = emptyFeedSnapshot()) {}\n52:   reset(status: FeedStatus): FeedSnapshot {\n53:     this.revisions.clear();\n54:     this.deletions.clear();\n55:     this.snapshot = { ...emptyFeedSnapshot(this.snapshot.namespace), status };\n56:     return this.snapshot;\n57:   }\n58:   apply(frame: StateChange): FeedSnapshot {\n59:     if (!/^\\d+$/.test(frame.stateGeneration)) throw new DoorError(\"DATA_LOSS\", \"Invalid state generation.\");\n60:     const generation = BigInt(frame.stateGeneration);\n61:     const schemaFrame = frame.changeType === ChangeType.SCHEMA_MIGRATION;\n62:     if (frame.frameKind === StateFrameKind.HEARTBEAT) {\n63:       if (generation >= BigInt(this.snapshot.generation)) this.snapshot = { ...this.snapshot, catalogHash: frame.catalogHash, generation: frame.stateGeneration };\n64:       return this.snapshot;\n65:     }\n66:     const root = feedPluginObjectPath(frame.pluginId);\n67:     if (!(frame.objectPath === root || frame.objectPath.startsWith(`${root}/`)) ||\n68:         frame.objectPath.split(\"/\").some(segment => unsafeSegments.has(segment))) {\n69:    