{"step_index":700,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:08:30Z","content":"Created At: 2026-10-26T11:08:30Z\nCompleted At: 2026-10-26T11:08:30Z\nShowing lines 1-70 of 434\n1: /**\n2:  * The doorbell: a content-free wake from the broker, gated by the identity\n3:  * sled, telling this page to re-read its private state through the door.\n4:  *\n5:  * What the broker sees: an MQTT client whose id is the page's owner key\n6:  * (`sha256(principal, session, genesis)`, handed out by the door), a password\n7:  * that is the page's own door credential (`oia1:<base64>` or `sid1:…`), one\n8:  * SUBSCRIBE to `opdbus/wake/<owner-key>`, and `{\"seq\": n}` messages. Nothing\n9:  * authoritative and no identity ever transits the broker; the door verifies\n10:  * the credential against the sled exactly as it does for a gRPC call.\n11:  *\n12:  * This is a deliberately minimal MQTT 3.1.1 client (CONNECT, SUBSCRIBE,\n13:  * PUBLISH in, PINGREQ, DISCONNECT) over a WebSocket — about the size of a\n14:  * dependency's type definitions, and fully testable with a fake socket.\n15:  */\n16: \n17: export interface DoorbellConfig {\n18:   /** wss://host:port */\n19:   listener: string;\n20:   /** Owner key; doubles as the MQTT client id. */\n21:   ownerKey: string;\n22:   /** Exactly the topic the door said; the broker refuses anything else. */\n23:   topic: string;\n24:   /**\n25:    * A fresh credential for each CONNECT. An issued OIA1 is one-time (the\n26:    * door consumes its nonce), so a reconnect must not reuse the last one.\n27:    */\n28:   credential: () => Promise<string>;\n29:   onWake: (seq: number) => void;\n30:   onStatus?: (status: DoorbellStatus) => void;\n31:   /** Keepalive in seconds (MQTT). */\n32:   keepAliveSeconds?: number;\n33:   /** Test seam. */\n34:   socketFactory?: (url: string) => WebSocketLike;\n35: }\n36: \n37: export type DoorbellStatus =\n38:   | { state: \"connecting\" }\n39:   | { state: \"subscribed\" }\n40:   | { state: \"closed\"; reason: string; retryInMs: number | null };\n41: \n42: export interface WebSocketLike {\n43:   binaryType: string;\n44:   readyState: number;\n45:   onopen: ((ev: unknown) => void) | null;\n46:   onmessage: ((ev: { data: ArrayBuffer | Blob | string }) => void) | null;\n47:   onclose: ((ev: { code?: number; reason?: string }) => void) | null;\n48:   onerror: ((ev: unknown) => void) | null;\n49:   send(data: ArrayBuffer | Uint8Array): void;\n50:   close(code?: number, reason?: string): void;\n51: }\n52: \n53: export interface Doorbell {\n54:   stop(): void;\n55: }\n56: \n57: const CONNECT = 1, CONNACK = 2, PUBLISH = 3, PUBACK = 4, SUBSCRIBE = 8, SUBACK = 9;\n58: const PINGREQ = 12, PINGRESP = 13, DISCONNECT = 14;\n59: const MIN_RETRY_MS = 2_000;\n60: const MAX_RETRY_MS = 60_000;\n61: const CONNACK_REFUSED = [\"accepted\", \"unacceptable protocol\", \"identifier rejected\", \"server unavailable\", \"bad credentials\", \"not authorized\"];\n62: \n63: const encoder = new TextEncoder();\n64: const decoder = new TextDecoder();\n65: \n66: function remainingLength(length: number): number[] {\n67:   const out: number[] = [];\n68:   do {\n69:     let digit = length % 128;\n70:     length = Math.floor(length / 128);"}
