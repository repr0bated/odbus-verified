{"step_index":965,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:28:38Z","content":"Created At: 2026-10-26T11:28:38Z\nCompleted At: 2026-10-26T11:28:38Z\nCommand exited with code 0.\n\nCommand output:\ncommit 7766577e7af741ea227ef1721167cd7dd3cc494f\r\nAuthor: Jeremy Hobson <jeremy@3tched.com>\r\nDate:   Sun Oct 18 09:55:01 2026 +0000\r\n\r\n    chore(repo): checkpoint restoration and cognitive source rename\r\n\r\ndiff --git a/deploy/release/op-release-launch b/deploy/release/op-release-launch\r\nnew file mode 100755\r\nindex 0000000..330145c\r\n--- /dev/null\r\n+++ b/deploy/release/op-release-launch\r\n@@ -0,0 +1,126 @@\r\n+#!/bin/sh\r\n+# Installed base-system launcher; holds one open-file-description lock through exec.\r\n+# Base-installation authorization contract (never installed by this launcher):\r\n+# /usr/local/libexec/opdbus-release is root:root 0755, outside every application\r\n+# overlay, containing ONLY op-release, op-release-launch and manifest.sha256.\r\n+# The executables and /etc/init.d/op-release-activate are root:root 0755 regular\r\n+# single-link files. The manifest is root:root 0600, with exactly one canonical\r\n+# SHA256 line (\"<64 lowercase hex>  <absolute path>\") for each of those THREE\r\n+# executables, including the init script outside this directory. No self-entry.\r\n+# Authorize those bytes together from the independently authored op-deployment\r\n+# op-release build and these two source scripts; never approve a historical\r\n+# controller by copying or renaming it. Publish the manifest only after review\r\n+# of the complete installed set, with release/boot callers inactive during the\r\n+# base installation. This is root approval, not a remotely signed provenance\r\n+# claim. No generated manifest, fallback, or live installation is performed here.\r\n+# Existing receiver.json, first-activation.json and native lifetime gates remain\r\n+# separate authorities; this kit neither creates nor relaxes them.\r\n+set -eu\r\n+PATH=/usr/sbin:/usr/bin:/sbin:/bin\r\n+LC_ALL=C\r\n+export PATH LC_ALL\r\n+umask 077\r\n+base=/usr/local/libexec/opdbus-release\r\n+state=/var/lib/opdbus-release\r\n+runtime=/run/opdbus-release\r\n+[ \"$#\" -gt 0 ] || { echo 'usage: op-release-launch {release|deploy|provision-slots|status|activate a|b|rollback|abort|boot}' >&2; exit 2; }\r\n+verb=$1\r\n+case \"$verb\" in\r\n+  activate) [ \"$#\" -eq 2 ] && { [ \"$2\" = a ] || [ \"$2\" = b ]; } || exit 2 ;;\r\n+  release|deploy|provision-slots|status|rollback|abort|boot) [ \"$#\" -eq 1 ] || exit 2 ;;\r\n+  *) echo 'unsupported release verb; host/Incus provisioning belongs to its existing owner' >&2; exit 2 ;;\r\n+esac\r\n+# Independently authored, read-only release-kit verifier. It intentionally has\r\n+# no shell-source dependency and knows no storage daemon, guard tool or helper.\r\n+fail() { printf 'op-release-launch: %s\\n' \"$*\" >&2; exit 1; }\r\n+secure_directory() {\r\n+    [ -d \"$1\" ] && [ ! -L \"$1\" ] &&\r\n+        [ \"$(stat -c %u:%g \"$1\")\" = 0:0 ] &&\r\n+        [ \"$((0$(stat -c %a \"$1\") & 07022))\" -eq 0 ] ||\r\n+        fail \"insecure directory: $1\"\r\n+}\r\n+secure_file() {\r\n+    [ -f \"$1\" ] && [ ! -L \"$1\" ] &&\r\n+        [ \"$(stat -c %u:%g:%a:%h \"$1\")\" = \"0:0:$2:1\" ] ||\r\n+        fail \"expected root-owned, non-symlink, single-link mode $2 file: $1\"\r\n+}\r\n+verify_release_kit() {\r\n+    for directory in / /usr /usr/local /usr/local/libexec \"$base\" /etc /etc/init.d; do\r\n+        secure_directory \"$directory\"\r\n+    done\r\n+    [ \"$(stat -c %a \"$base\")\" = 755 ] || fail 'release-kit directory must be mode 0755'\r\n+    secure_file \"$base/op-release\" 755\r\n+    secure_file \"$base/op-release-launch\" 755\r\n+    secure_file /etc/init.d/op-release-activate 755\r\n+    secure_file \"$base/manifest.sha256\" 600\r\n+    # Reject mixed kits, including unmanifested hidden files and subdirectories.\r\n+    for entry in \"$base\"/* \"$base\"/.[!.]* \"$base\"/..?*; do\r\n+        [ -e \"$entry\" ] || [ -L \"$entry\" ] || continue\r\n+        case \"${entry##*/}\" in\r\n+            op-release|op-release-launch|manifest.sha256) ;;\r\n+            *) fail \"unexpected release-kit entry: $entry\" ;;\r\n+        esac\r\n+    done\r\n+    [ \"$(stat -c %s \"$base/manifest.sha256\")\" -le 1024 ] ||\r\n+        fail 'release-kit manifest is oversized'\r\n+    awk '\r\n+        BEGIN {\r\n+            allowed[\"/usr/local/libexec/opdbus-release/op-release\"] = 1\r\n+            allowed[\"/usr/local/libexec/opdbus-release/op-release-launch\"] = 1\r\n+            allowed[\"/etc/init.d/op-release-activate\"] = 1\r\n+        }\r\n+        {\r\n+            if (NF != 2 || length($1) != 64 || $1 ~ /[^0-9a-f]/ ||\r\n+                $0 != $1 \"  \" $2 || !($2 in allowed) || seen[$2]++) {\r\n+                invalid = 1\r\n+                exit 1\r\n+            }\r\n+            count++\r\n+        }\r\n+        END { if (invalid || count != 3) exit 1 }\r\n+    ' \"$base/manifest.sha256\" || fail 'manifest must name exactly the three approved release-kit files'\r\n+    sha256sum --strict --check --quiet \"$base/manifest.sha256\" ||\r\n+        fail 'approved release-kit digest mismatch'\r\n+    # Existing approval policy data only. New kernels/BTF require separate\r\n+    # review; successful hashing or a lifetime feature does not confer approval.\r\n+    btf=$(sha256sum /sys/kernel/btf/vmlinux) || fail 'kernel BTF is unavailable'\r\n+    kernel=$(uname -r) || fail 'kernel release is unavailable'\r\n+    case \"$kernel ${btf%% *}\" in\r\n+        '6.18.57-x64v3-op-release-lifetime1-xanmod1 418e74eb9598f5747b4039d3934d77f244b1d9e7ba0f64d729c21a6ddebdb975' | \\\r\n+        '6.18.56-x64v3-xanmod1 488c010609b5e98244ddf062cd7bcaf86b17b2a32bc70b369ca3c2a4efd59cb2' | \\\r\n+        '6.12.111+deb13-amd64 117c3da349bc97db5eb4c0627b7b12afc9a3f83686e35c2b28d6031e13767018') ;;\r\n+        *) fail 'kernel/BTF pair requires separate policy approval' ;;\r\n+    esac\r\n+}\r\n+verify_release_kit\r\n+if [ \"$verb\" = status ]; then\r\n+    exec \"$base/op-release\" \"$@\"\r\n+fi\r\n+[ \"$(id -u)\" -eq 0 ] || { echo 'release requires the authorized root owner' >&2; exit 1; }\r\n+for directory in /var /var/lib \"$state\" /run; do\r\n+    secure_directory \"$directory\"\r\n+done\r\n+secure_file \"$state/lock\" 600\r\n+if [ -e \"$runtime\" ] || [ -L \"$runtime\" ]; then secure_directory \"$runtime\"; fi\r\n+install -d -m 0755 -o root -g root \"$runtime\"\r\n+exec 9>>\"$state/lock\"\r\n+if ! flock -n 9; then\r\n+    if [ \"$verb\" = boot ]; then\r\n+        temporary=$(mktemp \"$runtime/.ready.XXXXXX\")\r\n+        printf 'recovery-pending lock-busy\\n' > \"$temporary\"\r\n+        chmod 0644 \"$temporary\"\r\n+        mv -f \"$temporary\" \"$runtime/ready\"\r\n+    fi\r\n+    echo 'another release transaction holds fd9' >&2\r\n+    exit 1\r\n+fi\r\n+if [ \"$verb\" != boot ]; then\r\n+    # Membership is preinstalled authority, not a request to turn the guard on.\r\n+    # Never create a cgroup, alter trusted maps, auto-rearm or require guard ON.\r\n+    [ -f /sys/fs/cgroup/opdbus-release/cgroup.procs ] || {\r\n+        echo 'approved existing release cgroup is absent' >&2; exit 1;\r\n+    }\r\n+    printf '%s\\n' \"$$\" > /sys/fs/cgroup/opdbus-release/cgroup.procs\r\n+fi\r\n+# No top-level mount, independent recovery process, or restart-all loop here.\r\n+exec \"$base/op-release\" \"$@\"\r\n"}
