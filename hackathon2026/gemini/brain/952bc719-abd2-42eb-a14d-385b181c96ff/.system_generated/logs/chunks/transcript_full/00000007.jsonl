{"step_index":569,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T11:03:21Z","content":"Created At: 2026-10-26T11:03:21Z\nCompleted At: 2026-10-26T11:03:21Z\nShowing lines 1-50 of 50\n1: #!/bin/sh\n2: # op-dbus-release: application\n3: exec 2>&1\n4: rm -f -- /run/opdbus/runit-ready/op-web\n5: \n6: wait_dep() {\n7:     sv start \"$1\" >/dev/null 2>&1 || true\n8:     i=0\n9:     until sv check \"$1\" >/dev/null 2>&1; do\n10:         i=$((i+1))\n11:         [ \"$i\" -ge 90 ] && { echo \"dependency $1 not ready after 90s\" >&2; exit 1; }\n12:         sleep 1\n13:     done\n14: }\n15: # Was `wait_dep ovsbr0-addr` until 2026-08-13. ovsbr0-addr's helper does not\n16: # exist and its run script has no `set -e`, so its only real effect was to\n17: # touch /run/opdbus/runit-ready/ovsbr0-addr — which this service and incusd\n18: # both gated on. Retiring it (3tched-network-install.sh) therefore took both\n19: # down. opdbus-rundirs is what actually creates the rundirs op-web needs.\n20: wait_dep opdbus-rundirs\n21: # The bridge owns CognitiveServer and its single-writer RocksDB. Web must\n22: # not start until the bridge has completed replay and opened its socket.\n23: wait_dep op-grpc-bridge\n24: \n25: set -a\n26: [ -r /etc/op-dbus/environment ] && . /etc/op-dbus/environment\n27: set +a\n28: \n29: export OP_WEB_BIND_ADDR=\"${OP_WEB_BIND_ADDR:-10.0.0.2}\"\n30: export PORT=\"${PORT:-8080}\"\n31: export OP_WEB_STATIC_DIR=/usr/local/share/op-dbus/dashboard-release\n32: export OP_DBUS_GRPC_ADDR=\"${OP_DBUS_GRPC_ADDR:-https://10.0.0.2:8090}\"\n33: export OP_DBUS_GRPC_CA_FILE=\"${OP_DBUS_GRPC_CA_FILE:-/etc/op-dbus/tls/tonic-svc0-ca.crt}\"\n34: # Serve the existing private HTTP endpoint. The ready bridge above proves\n35: # its host-owned TLS door is bound; no decoy or tunnel daemon is a dependency.\n36: unset OP_WEB_TLS_BIND\n37: # Live subscribe is tonic-web on lungs (10.0.0.2:8090), not HTTP SSE.\n38: # OP_WEB_SSE_BRIDGE / OP_WEB_SSE_HYDRATE stay unset (off). Allowlist only\n39: # matters if an operator re-enables legacy hydrate.\n40: # Human browsers obtain OIA1 from the decoy's authenticated WireGuard pickup.\n41: # Host-local IP mappings do not prove a caller's identity, so no SID1 pickup\n42: # or HTTP admin grant is configured here.\n43: export RUST_LOG=\"${RUST_LOG:-op_web=info,info}\"\n44: \n45: # NOTE the readiness token is written BEFORE the exec, so it asserts \"the run\n46: # script got this far\", not \"op-web-server is serving\". `check` is what closes\n47: # that gap — it tests the listener, not the token. Do not let anything gate on\n48: # the token alone.\n49: /usr/local/libexec/op-dbus/helpers/runit-ready-signal op-web\n50: exec /usr/local/libexec/op-dbus/bin/op-web-server"}
