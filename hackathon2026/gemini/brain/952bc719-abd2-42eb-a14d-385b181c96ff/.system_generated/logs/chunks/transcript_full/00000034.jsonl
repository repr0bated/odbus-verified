{"step_index":2391,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T16:59:16Z","content":"Created At: 2026-10-26T16:59:16Z\nCompleted At: 2026-10-26T16:59:16Z\nShowing lines 1-60 of 60\n1: #!/usr/bin/env bash\n2: # launch-identity.sh: Instantiate a modular 3tchedFS identity container from JSON template.\n3: set -euo pipefail\n4: \n5: usage() {\n6:     echo \"Usage: $0 <instance-name> <wireguard-pubkey> [session-id]\"\n7:     echo \"Example: $0 id-1 'Env5zPMmM1Zhypu5/DY/yU4PRYW/4AOEq2KZ4OSc+18=' [uuid]\"\n8:     exit 1\n9: }\n10: \n11: [[ $# -ge 2 ]] || usage\n12: INSTANCE_NAME=$1\n13: WG_PUBKEY=$2\n14: SESSION_ID=${3:-$(uuidgen | tr '[:upper:]' '[:lower:]')}\n15: REPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n16: TEMPLATE=\"${REPO_ROOT}/instances/chatbot-template.json\"\n17: PROFILE_DEF=\"${REPO_ROOT}/profiles/3tched-lungs.json\"\n18: COZO_DEV_DIR=\"/var/lib/op-dbus/identity-cozo/devices\"\n19: IMAGE_PATH=\"${COZO_DEV_DIR}/${INSTANCE_NAME}.img\"\n20: \n21: [[ $(id -u) -eq 0 ]] || { echo \"Error: Must be run as root.\" >&2; exit 1; }\n22: \n23: echo \"==> [GENESIS] Synthesizing Sovereign Identity (${INSTANCE_NAME})...\"\n24: echo \"==> [DNA] Sequencing somatic tissue & private memory space...\"\n25: if [[ ! -f \"${IMAGE_PATH}\" ]]; then\n26:     \"${REPO_ROOT}/storage/make-cozo-device.sh\" \"${IMAGE_PATH}\" 20\n27: fi\n28: \n29: echo \"==> [SPINE] Verifying 3tchedFS neural profile in Incus...\"\n30: if ! incus profile show 3tched-lungs >/dev/null 2>&1; then\n31:     incus query -X POST /1.0/profiles -d @\"${PROFILE_DEF}\"\n32: fi\n33: \n34: echo \"==> [GESTATION] Materializing instance from genetic template (Session: ${SESSION_ID})...\"\n35: PAYLOAD=$(sed \\\n36:     -e \"s|{{INSTANCE_NAME}}|${INSTANCE_NAME}|g\" \\\n37:     -e \"s|{{DISPLAY_NAME}}|${INSTANCE_NAME}|g\" \\\n38:     -e \"s|{{SESSION_ID}}|${SESSION_ID}|g\" \\\n39:     -e \"s|{{WIREGUARD_PUBKEY}}|${WG_PUBKEY}|g\" \\\n40:     \"${TEMPLATE}\")\n41: \n42: echo \"==> [EMERGENCE] Creating living container via Incus REST API...\"\n43: RESPONSE=$(incus query -X POST /1.0/instances -d \"${PAYLOAD}\")\n44: echo \"${RESPONSE}\" | jq -r '.status // \"ok\"'\n45: \n46: echo \"==> [HEARTBEAT] Connecting circulatory block storage to organism...\"\n47: incus config device add \"${INSTANCE_NAME}\" cozo-storage disk \\\n48:     source=\"${IMAGE_PATH}\" \\\n49:     path=/dev/cozo-disk\n50: \n51: echo \"==> [AWAKEN] Energizing container nervous system (${INSTANCE_NAME})...\"\n52: incus start \"${INSTANCE_NAME}\"\n53: \n54: echo \"==> [BREATHE] Opening lungs: mounting hippocampal memory & sprouting Btrfs leaf...\"\n55: # Partition 1 is the Btrfs leaf sprout; partition 2 is ext4 Cozo store\n56: incus exec \"${INSTANCE_NAME}\" -- mkdir -p /persist /var/lib/op-dbus\n57: incus exec \"${INSTANCE_NAME}\" -- mount -t ext4 /dev/cozo-disk2 /var/lib/op-dbus 2>/dev/null || true\n58: incus exec \"${INSTANCE_NAME}\" -- btrfs device add /dev/cozo-disk1 / 2>/dev/null || true\n59: \n60: echo \"==> [ALIVE] Sovereign entity awakened: ${INSTANCE_NAME} (Session: ${SESSION_ID})\""}
