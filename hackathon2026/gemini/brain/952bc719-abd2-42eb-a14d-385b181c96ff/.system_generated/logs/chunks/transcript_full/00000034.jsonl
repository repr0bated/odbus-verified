{"step_index":2389,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T16:59:10Z","content":"Created At: 2026-10-26T16:59:10Z\nCompleted At: 2026-10-26T16:59:11Z\nShowing lines 1-100 of 470\n1: #!/usr/bin/env bash\n2: # Upgrade OS only: host -> instance; never replicate user/agent subvolumes.\n3: set -euo pipefail\n4: export LC_ALL=C\n5: fail() { printf 'sync-instance-upgrade: %s\\n' \"$*\" >&2; exit 1; }\n6: [[ $# == 2 && $1 =~ ^(pair|sync|boot)$ && $2 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$ ]] || fail 'usage: sync-instance-upgrade pair|sync|boot NAME'\n7: action=$1 name=$2\n8: [[ $(id -u) == 0 ]] || fail 'host root required'\n9: # Restoration uses the existing native/storage receipts below, not an online\n10: # preparation replay; the bridge may itself depend on this root at boot.\n11: for tool in jq btrfs blkid findmnt losetup mount umount flock incus stat realpath blockdev lsblk sfdisk awk find head timeout sync; do\n12:     type -P \"$tool\" >/dev/null || fail \"missing $tool\"\n13: done\n14: # One bounded attempt, never a retry after an uncertain mount/API result.\n15: readback() { timeout --kill-after=5s 15s \"$@\"; }\n16: incus() { readback incus --force-local --project default \"$@\"; }\n17: findmnt() { readback findmnt \"$@\"; }\n18: stat() { readback stat \"$@\"; }\n19: realpath() { readback realpath \"$@\"; }\n20: blkid() { readback blkid \"$@\"; }\n21: mount() { timeout --kill-after=5s 30s mount \"$@\"; }\n22: umount() { timeout --kill-after=5s 30s umount \"$@\"; }\n23: mounted() {\n24:     local targets target\n25:     # Query the complete table successfully before deciding a mount is absent;\n26:     # a failed/timed-out filtered findmnt must not authorize another mount.\n27:     targets=$(findmnt -rn -o TARGET) || fail 'cannot read mount table'\n28:     while IFS= read -r target; do\n29:         [[ $target != \"$1\" ]] || return 0\n30:     done <<<\"$targets\"\n31:     return 1\n32: }\n33: umask 077\n34: pool=/var/lib/incus/storage-pools/3tched-pool\n35: [[ -d $pool && ! -L $pool && $(realpath -e \"$pool\") == \"$pool\" &&\n36:    $(findmnt -rn -M \"$pool\" -o FSTYPE) == btrfs &&\n37:    $(findmnt -rn -M \"$pool\" -o FSROOT) == / &&\n38:    $(findmnt -rn -M \"$pool\" -o UUID) == a1ab7b42-12a8-437c-8f65-d0469892c8dd &&\n39:    $(findmnt -rn -M / -o UUID) != a1ab7b42-12a8-437c-8f65-d0469892c8dd ]] ||\n40:     fail 'canonical Incus loop pool is not mounted on its pinned filesystem'\n41: receipt=$pool/.provisioning/$name.json\n42: [[ -f $receipt && ! -L $receipt ]] || fail 'preparation receipt required'\n43: jq -e --arg name \"$name\" --arg image \"$pool/$name.img\" \\\n44:     '.phase==\"filesystems-prepared\" and .name==$name and .image==$image and .filesystem_prepared==true' \"$receipt\" >/dev/null || fail 'disk not prepared'\n45: image=$pool/$name.img\n46: [[ -f $image && ! -L $image && $(stat -c %i \"$image\") == \"$(jq -r .image_inode \"$receipt\")\" && $(stat -c %s \"$image\") == \"$(jq -r .image_bytes \"$receipt\")\" ]] || fail 'image pins differ'\n47: exec 8>\"$pool/.provisioning/host-upgrade.lock\"\n48: flock -n 8 || fail 'host upgrade transfer active'\n49: exec 9>\"$pool/.provisioning/$name.lock\"\n50: flock -n 9 || fail 'instance preparation active'\n51: instances=$(incus list -f json)\n52: jq -e --arg name \"$name\" 'type==\"array\" and all(.[]; .name!=$name or .status==\"Stopped\")' \\\n53:     <<<\"$instances\" >/dev/null || fail 'instance must be stopped'\n54: binding=$pool/.provisioning/$name.incus.json\n55: # ID-N is only a selector for this existing configured chatbot. In particular,\n56: # a disk filename/regex cannot authorize a new human provisioning path.\n57: if [[ $name == 3tchedCtlChatbot || $name == 3tchedChatbot || $name == ID-* ]]; then\n58:     [[ $name =~ ^(3tchedCtlChatbot|3tchedChatbot|ID-[1-9][0-9]*)$ && -f $binding && ! -L $binding ]] || fail 'configured chatbot preparation receipt required'\n59:     jq -e --arg name \"$name\" '\n60:         .version==1 and .name==$name and .session_id==\"b0c777e3-0955-cd8b-3d01-ca12998cae28\" and\n61:         (.phase==\"container-defined\" or .phase==\"root-bound\") and\n62:         .instance.name==$name and .instance.type==\"container\" and\n63:         .instance.config[\"user.opdbus.session_id\"]==.session_id and\n64:         .instance.config[\"user.opdbus.wireguard_public_key\"]==\"Env5zPMmM1Zhypu5/DY/yU4PRYW/4AOEq2KZ4OSc+18=\" and\n65:         (.instance.config[\"volatile.uuid\"]|type==\"string\" and test(\"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\"))\n66:     ' \"$binding\" >/dev/null || fail 'configured chatbot preparation identity differs'\n67:     instance=$(readback incus --force-local query \"/1.0/instances/$name?project=default\") || fail 'native chatbot readback failed'\n68:     jq -e --slurpfile binding \"$binding\" --arg name \"$name\" '\n69:         .name==$name and .type==\"container\" and .status==\"Stopped\" and .status_code==102 and\n70:         .config[\"volatile.uuid\"]==$binding[0].instance.config[\"volatile.uuid\"] and\n71:         .config[\"user.opdbus.session_id\"]==$binding[0].session_id and\n72:         .config[\"user.opdbus.wireguard_public_key\"]==$binding[0].instance.config[\"user.opdbus.wireguard_public_key\"]\n73:     ' <<<\"$instance\" >/dev/null || fail 'native chatbot UUID/session/key differs'\n74: fi\n75: root=$pool/.mounts/$name/root\n76: replica=$pool/.mounts/$name/upgrade\n77: view=$pool/.mounts/$name/root-view\n78: seed_layer=$pool/.mounts/$name/seed-layer\n79: upgrade_layer=$pool/.mounts/$name/upgrade-layer\n80: container_root=/var/lib/incus/storage-pools/identity-roots/containers/$name/rootfs\n81: [[ $(jq -r .root_mount \"$receipt\") == \"$root\" && $(jq -r .upgrade_mount \"$receipt\") == \"$replica\" ]] || fail 'mount pins differ'\n82: host_uuid=7de8757c-6b8e-43d0-82fc-47e9da564775\n83: state=$pool/.provisioning/$name.upgrade.json\n84: [[ ! -L $state && ! -e $state.new && ! -L $state.new ]] || fail 'unsafe or retained pair receipt; reconcile manually'\n85: if [[ $action == pair ]]; then\n86:     [[ ! -e $state ]] || fail 'pair exists; never repeat provisioning transfer'\n87: else\n88:     [[ -f $state ]] || fail 'initial pairing required'\n89:     jq -e --arg host \"$host_uuid\" --arg replica \"$(jq -r .upgrade_fsid \"$receipt\")\" \\\n90:         '.phase==\"paired\" and .host_fsid==$host and .replica_fsid==$replica and .direction==\"host-to-container\" and\n91:          (.generation|type==\"string\" and test(\"^[A-Za-z0-9-]{1,128}$\"))' \"$state\" >/dev/null || fail 'incomplete or different pairing; inspect before recovery'\n92: fi\n93: generation=$(date -u +%Y%m%dT%H%M%S)-$$\n94: commit_state() {\n95:     sync -f \"$state.new\" || fail 'cannot persist pending receipt'\n96:     mv -T \"$state.new\" \"$state\" || fail 'cannot publish pending receipt'\n97:     sync -f \"$pool/.provisioning\" || fail 'cannot persist receipt directory'\n98: }\n99: transition_started=false\n100: on_exit() {"}
