  # Both OS layers are read-only in the guest. The upgrade partition itself\n412:     # remains writable for receive/rotation; user siblings are separate binds.\n413:     # Patches deleting seed files must carry whiteouts in the upgrade layer.\n414:     jq '.phase=\"restore-intent\"' \"$state\" > \"$state.new\"\n415:     commit_state\n416:     validate_instance\n417:     assert_dir \"$container_root\"\n418:     mkdir -p \"$view\" \"$seed_layer\" \"$upgrade_layer\"\n419:     for target in \"$view\" \"$seed_layer\" \"$upgrade_layer\"; do assert_dir \"$target\"; done\n420:     # This kernel cannot idmap an OverlayFS mount. Map its Btrfs lowers first.\n421:     mount --bind -o ro,X-mount.idmap=b:0:1000000:1000000000 \"$root/@\" \"$seed_layer\"\n422:     mount --bind -o ro,X-mount.idmap=b:0:1000000:1000000000 \"$replica/@\" \"$upgrade_layer\"\n423:     assert_bind \"$seed_layer\" \"$root/@\" /@ ro\n424:     assert_bind \"$upgrade_layer\" \"$replica/@\" /@ ro\n425:     mount -t overlay overlay -o \"ro,lowerdir=$upgrade_layer:$seed_layer\" \"$view\"\n426:     assert_overlay \"$view\"\n427:     # Check the effective merged mountpoints before binding any private data.\n428:     # Never create directories or repair a lower tree through a mounted view.\n429:     for relative in agent agent/memory agent/rules agent/shared agent/skills agent/soul agent/user opt opt/run-mounts opt/run-mounts/persist; do\n430:         assert_dir \"$view/$relative\"\n431:     done\n432:     for member in memory rules shared skills soul user; do\n433:         mount --bind -o X-mount.idmap=b:0:1000000:1000000000 \"$root/@agent_$member\" \"$view/agent/$member\"\n434:         case \"$member\" in shared|soul) mount -o remount,bind,ro \"$view/agent/$member\" ;; esac\n435:     done\n436:     mount --bind -o X-mount.idmap=b:0:1000000:1000000000 \"$root/@agent_user/persist\" \"$view/opt/run-mounts/persist\"\n437:     mount --rbind \"$view\" \"$container_root\"\n438:     incus config set \"$name\" \"volatile