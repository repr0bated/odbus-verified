{"step_index":363,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T10:43:57Z","content":"Created At: 2026-10-26T10:43:57Z\nCompleted At: 2026-10-26T10:43:57Z\nShowing lines 1-60 of 161\n1: mod boot;\n2: mod fs;\n3: mod inventory;\n4: mod lifetime;\n5: mod loggers;\n6: mod model;\n7: mod mounts;\n8: mod preserve;\n9: mod recovery;\n10: mod services;\n11: mod transfer;\n12: \n13: use anyhow::{Context, Result, bail, ensure};\n14: use model::*;\n15: use std::{collections::BTreeSet, path::Path};\n16: \n17: fn activate(state: &mut State, slot: Slot) -> Result<()> {\n18:     ensure!(state.active != Some(slot), \"requested slot is already active\");\n19:     let mut candidate = state.release(slot)?.clone();\n20:     let incoming = inventory::load(&*state.root(slot)?)?;\n21:     ensure!(incoming.graph_sha256 == candidate.graph_sha256 && incoming.tree_sha256 == candidate.tree_sha256, \"activation inventory differs from verified receive\");\n22:     let old = state.active.and_then(|s| match state.root(s).and_then(|r| inventory::load(&r)) {\n23:         Ok(inventory) => Some(inventory),\n24:         Err(error) => { eprintln!(\"op-release: active inventory unavailable; selecting every declared candidate consumer: {error:#}\"); None }\n25:     });\n26:     let approval = if state.active.is_none() { Some(preserve::approval(&incoming)?) } else { None };\n27:     let no_links = BTreeSet::new();\n28:     let links = approval.as_ref().map_or(&no_links, |a| &a.link_services);\n29:     let plan = services::plan(old.as_ref(), &incoming, links)?;\n30:     if let Some(active) = state.active {\n31:         let previous = state.release(active)?;\n32:         ensure!(previous.targets.len() == candidate.targets.len() && previous.targets.iter().zip(&candidate.targets).all(|(a,b)| a.path == b.path),\n33:             \"target-set changes require a separate approved host migration, not a mixed overlay rotation\");\n34:         for (target, previous) in candidate.targets.iter_mut().zip(&previous.targets) { target.parent = previous.parent.clone(); mounts::verify_parent(target)?; }\n35:         for name in &plan.order {\n36:             ensure!(incoming.services.get(name).is_some_and(|s| s.release_owned), \"removing a supervised release service requires owner lifecycle approval before activation\");\n37:             ensure!(Path::new(SERVICES).join(name).join(\"run\").try_exists()?, \"new release service {name} requires approved fixed-stub installation\");\n38:         }\n39:     } else {\n40:         for target in &mut candidate.targets { target.parent = Some(mounts::parent(&target.path)?); }\n41:     }\n42:     let logger_changes = loggers::plan(&plan, &incoming, state.active.is_none())?;\n43:     let mut journal = Journal::new(\"activate\", state.active, Some(slot)); journal.plan = plan; journal.candidate = Some(candidate.clone());\n44:     journal.loggers = logger_changes;\n45:     state.slots.insert(slot, Some(candidate.clone())); state.journal = Some(journal); state.save()?;\n46:     let outcome = (|| -> Result<()> {\n47:         if let Some(approval) = &approval { preserve::plan(state, &incoming, approval)?; }\n48:         else { preserve::plan_hooks(state, &incoming)?; }\n49:         let candidates = mounts::build(state, slot)?;\n50:         state.intent(\"transition-readiness\")?; boot::transition(state)?;\n51:         services::down(state)?;\n52:         if approval.is_some() { preserve::apply(state)?; }\n53:         mounts::switch(state, slot, candidates)?;\n54:         preserve::apply_hooks(state, true)?;\n55:         loggers::apply(state, true)?;\n56:         services::catalog(state, &candidate)?;\n57:         if approval.is_some() { preserve::links(state)?; }\n58:         services::reload_loggers(state)?;\n59:         services::restore(state, &incoming)?;\n60:         state.intent(\"commit-active\")?;"}
