stemFile { source: \"system/payload\".into(), path: path.into(), sha256: \"0\".repeat(64), mode: 0o755, install_if_absent: false }\n510:     }\n511:     #[test]\n512:     fn rejects_protected_overlay_and_ancestor_destinations() {\n513:         for path in [\"/etc/shadow\", \"/var/lib/opdbus/grants\", \"/root/key\", \"/proc/test\", \"/etc/op-dbus/identity.json\", \"/usr/local/libexec/opdbus-release/policy.json\"] {\n514:             assert!(validate_destination(&entry(path), &[], &[]).is_err(), \"{path}\");\n515:         }\n516:         let path = \"/usr/local/libexec/opdbus-release/op-release\";\n517:         for overlay in [path, \"/usr/local/libexec\", \"/usr/local/libexec/opdbus-release/op-release/child\"] {\n518:             assert!(validate_destination(&entry(path), &[PathBuf::from(overlay)], &[]).is_err());\n519:             assert!(validate_destination(&entry(path), &[], &[PathBuf::from(overlay)]).is_err());\n520:         }"}
