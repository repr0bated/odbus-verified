{"step_index":1905,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T13:38:00Z","content":"Created At: 2026-10-26T13:38:00Z\nCompleted At: 2026-10-26T13:38:00Z\nShowing lines 1-80 of 893\n1: //! Cognitive Tools for MCP\n2: //!\n3: //! MCP tools backed by the Cozo namespace/entry memory store.\n4: //! Operations: store, retrieve, query, delete, list_namespaces, stats.\n5: \n6: use crate::agent_tools::register_agent_tools;\n7: use crate::blob_catalog_tool::register_blob_catalog_tool;\n8: use crate::blob_vectors_tool::register_blob_vectors_tools;\n9: use crate::memory_store::{CognitiveMemoryStore, EntryQuery, NamespaceKind};\n10: use crate::qdrant_shuttle::QdrantSemanticShuttle;\n11: use anyhow::{Context, Result};\n12: use async_trait::async_trait;\n13: use op_mcp::tool_registry::{BoxedTool, Tool, ToolRegistry};\n14: use simd_json::prelude::*;\n15: use simd_json::{json, OwnedValue as Value};\n16: use std::sync::Arc;\n17: \n18: // One bounded process-wide owner, including separately constructed MemoryTools.\n19: // This serializes memory operations without retaining payloads or keyed locks.\n20: static MEMORY_OPERATIONS: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());\n21: \n22: /// Safe field access for simd_json values.\n23: ///\n24: /// simd_json's `Index` impl **panics** when the key is absent, unlike `serde_json`\n25: /// which yields `Null`. Every optional-field read must therefore go through `get`.\n26: /// This wrapper keeps the ergonomic `field(input, \"k\").as_str()` shape while\n27: /// returning a Null sentinel rather than unwinding the worker task.\n28: ///\n29: /// Reading an absent optional argument used to panic the tokio worker and reset the\n30: /// client connection, which surfaced as an empty HTTP response rather than an error.\n31: pub(crate) fn field<'a>(input: &'a Value, key: &str) -> &'a Value {\n32:     static NULL: std::sync::OnceLock<Value> = std::sync::OnceLock::new();\n33:     input\n34:         .get(key)\n35:         .unwrap_or_else(|| NULL.get_or_init(|| json!(null)))\n36: }\n37: \n38: pub struct CognitiveToolRegistry;\n39: \n40: impl CognitiveToolRegistry {\n41:     pub async fn register_all(\n42:         registry: &ToolRegistry,\n43:         store: Arc<CognitiveMemoryStore>,\n44:         qdrant: Option<Arc<QdrantSemanticShuttle>>,\n45:     ) -> Result<()> {\n46:         registry\n47:             .register(Arc::new(MemoryTool::new(store.clone(), qdrant.clone())) as BoxedTool)\n48:             .await?;\n49:         registry\n50:             .register(Arc::new(GeminiQueryTool {\n51:                 fallback: crate::gemini_fallback::GeminiFallback::new(),\n52:             }) as BoxedTool)\n53:             .await?;\n54:         register_agent_tools(registry).await?;\n55:         // Provider-backed MCP tools are projected by the bridge from their\n56:         // supervised loopback services. They must never delay construction of\n57:         // the in-process HOT memory/workflow runtime.\n58:         register_blob_catalog_tool(registry).await?;\n59:         register_blob_vectors_tools(registry, qdrant).await?;\n60:         Ok(())\n61:     }\n62: }\n63: \n64: /// Explicit provider operation; never selects the chatbot's default route.\n65: pub struct GeminiQueryTool {\n66:     fallback: crate::gemini_fallback::GeminiFallback,\n67: }\n68: \n69: #[async_trait]\n70: impl Tool for GeminiQueryTool {\n71:     fn name(&self) -> &str {\n72:         \"gemini_query\"\n73:     }\n74:     fn description(&self) -> &str {\n75:         \"Explicit Gemini query or bounded deep research using configured provider credentials.\"\n76:     }\n77:     fn category(&self) -> &str {\n78:         \"cognitive\"\n79:     }\n80:     fn tags(&self) -> Vec<String> {"}
