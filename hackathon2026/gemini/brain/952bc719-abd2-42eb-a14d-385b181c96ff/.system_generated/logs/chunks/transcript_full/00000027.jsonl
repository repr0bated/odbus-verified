{"step_index":1907,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T13:38:05Z","content":"Created At: 2026-10-26T13:38:05Z\nCompleted At: 2026-10-26T13:38:05Z\nShowing lines 81-180 of 893\n81:         vec![\"query\".into(), \"research\".into()]\n82:     }\n83:     fn input_schema(&self) -> Value {\n84:         simd_json::serde::to_owned_value(\n85:             &op_plugins::cognitive_plugin_schema().methods[\"gemini_query\"].args,\n86:         )\n87:         .expect(\"plugin-owned Gemini input schema serializes\")\n88:     }\n89:     fn required_capability(&self) -> Option<&str> {\n90:         Some(\"cognitive.invoke\")\n91:     }\n92:     fn subid(&self) -> Option<&str> {\n93:         Some(\"mut.service.gemini.query@v1\")\n94:     }\n95: \n96:     async fn execute(&self, input: Value) -> Result<Value> {\n97:         use op_plugins::state_plugins::cognitive::{\n98:             GeminiMode, GeminiQueryOutput, GeminiQueryRequest,\n99:         };\n100:         let request: GeminiQueryRequest = serde_json::from_value(simd_json_to_serde(&input))\n101:             .context(\"invalid Gemini query request\")?;\n102:         anyhow::ensure!(\n103:             !request.query.trim().is_empty(),\n104:             \"Gemini query must not be empty\"\n105:         );\n106:         anyhow::ensure!(\n107:             (1..=5).contains(&request.depth),\n108:             \"research depth must be 1-5\"\n109:         );\n110:         let output = tokio::time::timeout(std::time::Duration::from_secs(25), async {\n111:             let context = request.context.as_deref().filter(|s| !s.is_empty());\n112:             match request.mode {\n113:                 GeminiMode::Query => {\n114:                     let result = self.fallback.gemini_query(&request.query, context).await?;\n115:                     Ok::<_, anyhow::Error>(GeminiQueryOutput {\n116:                         response: result.answer,\n117:                         citations: result.citations.into_iter().map(|c| c.source).collect(),\n118:                     })\n119:                 }\n120:                 GeminiMode::DeepResearch => {\n121:                     let result = self\n122:                         .fallback\n123:                         .deep_research(&request.query, context, request.depth.into())\n124:                         .await?;\n125:                     anyhow::ensure!(\n126:                         result.sections.len() == usize::from(request.depth),\n127:                         \"deep research incomplete\"\n128:                     );\n129:                     let response = result\n130:                         .sections\n131:                         .iter()\n132:                         .map(|s| format!(\"{}\\n{}\", s.title, s.content))\n133:                         .collect::<Vec<_>>()\n134:                         .join(\"\\n\\n\");\n135:                     Ok(GeminiQueryOutput {\n136:                         response,\n137:                         citations: result\n138:                             .sections\n139:                             .into_iter()\n140:                             .flat_map(|s| s.citations)\n141:                             .map(|c| c.source)\n142:                             .collect(),\n143:                     })\n144:                 }\n145:             }\n146:         })\n147:         .await\n148:         .context(\"Gemini operation exceeded its 25-second deadline; no complete result\")??;\n149:         Ok(serde_to_simd_json(serde_json::to_value(output)?))\n150:     }\n151: }\n152: \n153: pub struct MemoryTool {\n154:     store: Arc<CognitiveMemoryStore>,\n155:     qdrant: Option<Arc<QdrantSemanticShuttle>>,\n156: }\n157: \n158: impl MemoryTool {\n159:     pub fn new(\n160:         store: Arc<CognitiveMemoryStore>,\n161:         qdrant: Option<Arc<QdrantSemanticShuttle>>,\n162:     ) -> Self {\n163:         Self { store, qdrant }\n164:     }\n165: }\n166: \n167: #[async_trait]\n168: impl Tool for MemoryTool {\