1.0/instances -d \"${PAYLOAD}\")\n43: echo \"${RESPONSE}\" | jq -r '.status // \"ok\"'\n44: \n45: echo \"==> 5. Attaching Cozo disk device to container...\"\n46: incus config device add \"${INSTANCE_NAME}\" cozo-storage disk \\\n47:     source=\"${IMAGE_PATH}\" \\\n48:     path=/dev/cozo-disk\n49: \n50: echo \"==> 6. Starting container ${INSTANCE_NAME}...\"\n51: incus start \"${INSTANCE_NAME}\"\n52: \n53: echo \"==> 7. Initializing storage inside container...\"\n54: # Partition 1 is the Btrfs leaf sprout; partition 2 is ext4 Cozo store\n55: incus exec \"${INSTANCE_NAME}\" -- mkdir -p /persist /var/lib/op-dbus\n56: incus exec \"${INSTANCE_NAME}\" -- mount -t ext4 /dev/cozo-disk2 /var/lib/op-dbus 2>/dev/null || true\n57: incus exec \"${INSTANCE_NAME}\" -- btrfs device add /dev/cozo-disk1 / 2>/dev/null || true\n58: \n59: echo \"==> Successfully launched identity container: ${INSTANCE_NAME} (${SESSION_ID})\""}
