{"step_index":2001,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T13:56:08Z","content":"Created At: 2026-10-26T13:56:08Z\nCompleted At: 2026-10-26T13:56:09Z\nShowing lines 1-70 of 312\n1: //! Same-origin connector from the page to the bridge door.\n2: //!\n3: //! The page sends gRPC-Web to op-web's own origin. op-web forwards each call\n4: //! unchanged to the tonic door over TLS it already trusts, so the browser never\n5: //! handles the door's certificate. Identity metadata (OIA1 or SID1) passes\n6: //! through untouched and the door's interceptor verifies it; op-web never\n7: //! reads, mints or checks a credential here.\n8: \n9: use std::time::Duration;\n10: \n11: use anyhow::Context;\n12: use axum::{\n13:     body::Body,\n14:     extract::{Request, State},\n15:     http::{HeaderMap, HeaderName, HeaderValue, Method, Uri, Version, header},\n16:     middleware::Next,\n17:     response::Response,\n18: };\n19: use tonic::transport::{Certificate, Channel, ClientTlsConfig, Endpoint};\n20: use tower::ServiceExt;\n21: \n22: /// Connection-scoped headers that must not cross to the HTTP/2 door.\n23: const HOP_BY_HOP: [&str; 8] = [\n24:     \"connection\",\n25:     \"keep-alive\",\n26:     \"proxy-connection\",\n27:     \"transfer-encoding\",\n28:     \"upgrade\",\n29:     \"te\",\n30:     \"trailer\",\n31:     \"host\",\n32: ];\n33: \n34: /// A lazily connected channel to the door. Calls carry no request timeout, so\n35: /// server-streaming methods stay open for as long as the page keeps them.\n36: #[derive(Clone)]\n37: pub struct DoorProxy {\n38:     channel: Channel,\n39: }\n40: \n41: impl DoorProxy {\n42:     /// Build from the settings op-web's own door client uses:\n43:     /// `OP_DBUS_GRPC_ADDR`, `OP_DBUS_GRPC_CA_FILE` and `OP_DBUS_GRPC_TLS_DOMAIN`.\n44:     pub fn from_env() -> anyhow::Result<Self> {\n45:         let address = crate::state::door_grpc_addr();\n46:         let ca_pem = match std::env::var(\"OP_DBUS_GRPC_CA_FILE\") {\n47: