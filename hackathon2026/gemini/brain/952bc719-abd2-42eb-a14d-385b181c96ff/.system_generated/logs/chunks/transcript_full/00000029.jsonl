4 + hello_len:\n48:         return None\n49:     hello = hello[: 4 + hello_len]\n50:     # Handshake header: type(1) len(3) + client_version(2) random(32)\n51:     body = hello[4:]\n52:     if len(body) < 34:\n53:         return None\n54:     idx = 34\n55:     # session_id\n56:     if idx >= len(body):\n57:         return None\n58:     sid_len = body[idx]\n59:     idx += 1 + sid_len\n60:     # cipher_suites\n61:     if idx + 2 > len(body):\n62:         return None\n63:     cs_len = int.from_bytes(body[idx : idx + 2], \"big\")\n64:     idx += 2 + cs_len\n65:     # compression\n66:     if idx + 1 > len(body):\n67:         return None\n68:     comp_len = body[idx]\n69:     idx += 1 + comp_len\n70:     # extensions\n71:     if idx + 2 > len(body):\n72:         return None\n73:     ext_len = int.from_bytes(body[idx : idx + 2], \"big\")\n74:     idx += 2\n75:     end = min(len(body), idx + ext_len)\n76:     while idx + 4 <= end:\n77:         etype = int.from_bytes(body[idx : idx + 2], \"big\")\n78:         elen = int.from_bytes(body[idx + 2 : idx + 4], \"big\")\n79:         idx += 4\n80:         if idx + elen > end:\n81:             break\n82:         if etype == 0x0000 and elen >= 5:  # server_name\n83:             # list_len(2) name_type(1) name_len(2) name\n84:             nlist = body[idx : idx + elen]\n85:             if len(nlist) < 5:\n86:                 break\n87:             # skip list length\n88:             nidx = 2\n89:             if nlist[nidx] != 0:  # host_name\n90:                 break\n91:             nlen = int.from_bytes(nlist[nidx + 1 : nidx + 3], \"big\")\n92:             nidx += 3\n93:             if nidx + nlen > len(nlist):\n94:                 break\n95:             try:\n96:                 return nlist[nidx : nidx + nlen].decode(\"ascii\")\n97:             except UnicodeDecodeError:\n98:                 return None\n99:         idx += elen\n100:     return None"}
