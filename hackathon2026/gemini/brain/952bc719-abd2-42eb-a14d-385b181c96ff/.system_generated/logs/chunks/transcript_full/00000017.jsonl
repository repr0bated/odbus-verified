p:\"add\",path:($p+\"/level\"),value:\"readonly\"},\n138:       {op:\"add\",path:($p+\"/workspace_only\"),value:true},\n139:       {op:\"add\",path:($p+\"/require_approval_for_medium_risk\"),value:true},\n140:       {op:\"add\",path:($p+\"/block_high_risk_commands\"),value:true}\n141:     ]' | threetched_config patch - >/dev/null\n142: done\n143: \n144: # The threetched config owner applies one compare-and-swap of this exact list.\n145: # An ownership receipt distinguishes our addition from a pre-existing root.\n146: if [ \"$filesystem_enabled\" = true ] || [ -e \"$filesystem_root_receipt\" ] || [ -L \"$filesystem_root_receipt\" ]; then\n147:     [ ! -L /etc/op-dbus ] && [ \"$(stat -c '%u %a' /etc/op-dbus)\" = '0 755' ] || exit 78\n148:     if [ -e \"$filesystem_root_receipt\" ] || [ -L \"$filesystem_root_receipt\" ]; then\n149:         protected_filesystem_file \"$filesystem_root_receipt\" || exit 78\n150:         [ \"$(cat \"$filesystem_root_receipt\")\" = \"$filesystem_root\" ] || exit 78\n151:     fi\n152:     roots=$(threetched_config get risk_profiles.control_plane.allowed_roots --json | jq -ce '.value | if type == \"string\" then fromjson else . end | arrays | select(all(.[]; type == \"string\"))')\n153:     if [ \"$filesystem_enabled\" = true ]; then\n154:         [ \"$(findmnt -rn -M \"$filesystem_root\" -o FSTYPE)\" = fuse.3tchedFS ] || { echo 'tched-router: threetched filesystem mount is not ready' >&2; exit 78; }\n155:         jq -e --arg session \"$OPDBUS_FILESYSTEM_SESSION\" '.mount_identity.kind == \"host_session\" and .mount_identity.session == $session and .local_call_owner_uid == 1001 and .workspace_id == null' \"$filesystem_root/.3tchedfs.json\" >/dev/null || exit 78\n156:         if ! printf '%s' \"$roots\" | jq -e --arg root \"$filesystem_root\" 'index($root) != null' >/dev/null; then\n157:             # Record intent before the atomic threetched patch, so interrupted\n158:             # startup can still roll back only this exact added permission.\n159:             receipt_tmp=$(mktemp /etc/op-dbus/.threetched-filesystem-root.XXXXXX)\n160:             chmod 0600 \"$receipt_tmp\""}
