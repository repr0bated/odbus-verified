{"step_index":180,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T10:21:56Z","content":"Created At: 2026-10-26T10:21:56Z\nCompleted At: 2026-10-26T10:21:57Z\nShowing lines 1-61 of 61\n1: //! Adapter for the pinned downstream Btrfs quiescent-destroy ABI.\n2: //! No userspace scan, kernel-version guess, or ordinary-delete fallback is safe.\n3: use std::{io, os::fd::{AsRawFd, BorrowedFd}};\n4: use uuid::Uuid;\n5: \n6: // deploy/release/lifetime/0001-btrfs-quiescent-destroy.patch, native Linux ABI:\n7: // _IOW(BTRFS_IOCTL_MAGIC /* 0x94 */, 255, struct ... /* 96 bytes */).\n8: const SNAP_DESTROY_QUIESCENT: libc::c_ulong = 0x4060_94ff;\n9: \n10: #[repr(C)]\n11: struct QuiescentDestroy {\n12:     subvolid: u64,\n13:     fsid: [u8; 16],\n14:     uuid: [u8; 16],\n15:     received_uuid: [u8; 16],\n16:     flags: u64,\n17:     reserved: [u64; 4],\n18: }\n19: const _: () = assert!(std::mem::size_of::<QuiescentDestroy>() == 96);\n20: \n21: // The caller journals exact identity before this call and must close its own\n22: // target-root descriptors/mounts first. `top` is a different root on the same\n23: // filesystem. Source snapshots and aborted incoming roots use this same path;\n24: // they must be read-only too (a zero received UUID is valid).\n25: //\n26: // The kernel holds admission closed continuously from its reference census\n27: // through unlink. Success permanently closes the old incarnation; no userspace\n28: // lease/Drop unlock is needed while the caller waits for the cleaner and renames\n29: // the incoming root. Live-alias rejection precedes root unlink. Other failures\n30: // can follow unlink, so recovery must reconcile identity after every error.\n31: // The ABI reserves EBUSY/ESTALE/EROFS/EINVAL for pre-unlink rejection and maps\n32: // all failures after root unlink starts to EIO. EIO never promises rollback.\n33: // ENOENT is special to this checked ABI: its kernel lifetime registry includes\n34: // orphan root objects through final free and proves the exact generation has\n35: // no live inode aliases. Pathname absence or native cleaner completion alone\n36: // never substitutes for that proof. A busy orphan remains admission-closed.\n37: // ENOTTY means the required kernel is absent and must remain a hard failure.\n38: pub fn destroy(\n39:     top: BorrowedFd<'_>,\n40:     fsid: Uuid,\n41:     subvolid: u64,\n42:     native_uuid: Uuid,\n43:     received_uuid: Uuid,\n44: ) -> io::Result<()> {\n45:     let args = QuiescentDestroy {\n46:         subvolid,\n47:         fsid: fsid.into_bytes(),\n48:         uuid: native_uuid.into_bytes(),\n49:         received_uuid: received_uuid.into_bytes(),\n50:         flags: 0,\n51:         reserved: [0; 4],\n52:     };\n53:     // SAFETY: the fixed-layout, fully initialized 96-byte input and borrowed\n54:     // ioctl-capable directory descriptor remain valid throughout the syscall.\n55:     let result = unsafe { libc::ioctl(top.as_raw_fd(), SNAP_DESTROY_QUIESCENT, &args) };\n56:     match result {\n57:         0 => Ok(()),\n58:         -1 => Err(io::Error::last_os_error()),\n59:         _ => Err(io::Error::from_raw_os_error(libc::EPROTO)),\n60:     }\n61: }"}
