{"step_index":352,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T10:33:05Z","content":"Created At: 2026-10-26T10:33:05Z\nCompleted At: 2026-10-26T10:33:05Z\nCommand exited with code 0.\n\nCommand output:\nelapsed=0\r\nuntil has_local_ipv4 10.0.0.2; do\r\n    elapsed=$((elapsed + 1))\r\n    if [ \"$elapsed\" -ge \"${OP_GRPC_3TCHED_WAIT_SECS:-90}\" ]; then\r\n        echo \"private host door address 10.0.0.2 is not assigned; base-network owner must provision it\" >&2\r\n        exit 1\r\n    fi\r\n    sleep 1\r\ndone\r\nstartup_phase private-door-address-ready\r\n\r\n# `:8090` is tonic on 10.0.0.2, with the internal certificate.\r\n# The unix socket serves the same fabric.\r\nFABRIC_BIND=\"10.0.0.2:8090\"\r\nexport TCHED_ROUTER_BIND_ADDR=\"$FABRIC_BIND\"\r\nexport GRPC_BIND=\"$FABRIC_BIND\"\r\nexport TCHED_ROUTER_UNIX_SOCKET=\"${TCHED_ROUTER_UNIX_SOCKET:-/run/opdbus/grpc.sock}\"\r\nexport TCHED_ROUTER_TLS_CERT_FILE=\"${TCHED_ROUTER_TLS_CERT_FILE:-/etc/op-dbus/tls/tonic-svc0.crt}\"\r\nexport TCHED_ROUTER_TLS_KEY_FILE=\"${TCHED_ROUTER_TLS_KEY_FILE:-/etc/op-dbus/tls/tonic-svc0.key}\"\r\nunset TCHED_ROUTER_BROWSER_TLS_BIND_ADDR TCHED_ROUTER_BROWSER_TLS_CERT_FILE TCHED_ROUTER_BROWSER_TLS_KEY_FILE\r\nstartup_phase emqx-prepare\r\n/usr/local/libexec/op-dbus/helpers/emqx-prepare\r\nexport OP_EMQX_EXHOOK_ENABLE=1\r\nexport OP_EMQX_EXHOOK_BIND_ADDR=127.0.0.1:9000\r\nexport OP_EMQX_EXHOOK_SERVER_CERT_FILE=\"${TCHED_ROUTER_TLS_CERT_FILE}\"\r\nexport OP_EMQX_EXHOOK_SERVER_KEY_FILE=\"${TCHED_ROUTER_TLS_KEY_FILE}\"\r\nexport OP_EMQX_EXHOOK_CLIENT_CA_FILE=/etc/emqx/certs/opdbus-ca.crt\r\nexport OP_EMQX_EXHOOK_CLIENT_CERT_FILE=/etc/emqx/certs/emqx-exhook-client.crt\r\n# The bridge opens this append-only journal with mode 0600 and syncs every\r\n# accepted nonce before dispatch. Keeping it outside tmpfs preserves replay\r\n# rejection across service/process restarts.\r\n"}
