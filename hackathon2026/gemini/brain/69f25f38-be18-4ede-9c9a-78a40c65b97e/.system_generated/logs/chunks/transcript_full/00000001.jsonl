{"step_index":87,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T10:17:02Z","content":"Created At: 2026-10-26T10:17:02Z\nCompleted At: 2026-10-26T10:17:02Z\nShowing lines 1-80 of 645\n1: //! Explicit base-system payloads. Never infer rootfs writes from overlay inventory.\n2: //!\n3: //! The manifest is graph-pinned and has a separate, deliberately narrow host\n4: //! destination policy. No overlay inventory entry implicitly authorizes a write.\n5: //! Originals are streamed into private durable backups; journal records contain\n6: //! hashes/metadata, never binary contents. An ambiguous recovery keeps evidence.\n7: //! Committed receipts retain backups and the pre-reboot boot ID. Interrupted kit\n8: //! publication may require the authorized bootstrap kit before strict launcher\n9: //! digest gates admit native recovery; those gates are never bypassed here.\n10: \n11: use anyhow::{Context, Result, ensure};\n12: use serde::{Deserialize, Serialize};\n13: use sha2::{Digest, Sha256};\n14: use std::{collections::BTreeSet, ffi::CString, fs::File, io::{Seek, SeekFrom},\n15:     os::{fd::{AsFd, AsRawFd, FromRawFd}, unix::{ffi::OsStrExt, fs::MetadataExt}},\n16:     path::{Path, PathBuf}, process::Command};\n17: use super::{fs, inventory::{self, Inventory}, model::*, mounts, preserve, services};\n18: \n19: const KIT_MANIFEST: &str = \"/usr/local/libexec/opdbus-release/manifest.sha256\";\n20: const KIT: [&str; 4] = [\n21:     \"/usr/local/libexec/opdbus-release/op-release\",\n22:     \"/usr/local/libexec/opdbus-release/op-release-launch\",\n23:     \"/etc/init.d/op-release-activate\", KIT_MANIFEST,\n24: ];\n25: \n26: #[derive(Clone, Debug, Deserialize, Serialize)]\n27: #[serde(deny_unknown_fields)]\n28: pub struct SystemFile {\n29:     pub source: PathBuf, pub path: PathBuf, pub sha256: String, pub mode: u32,\n30:     #[serde(default)] pub install_if_absent: bool,\n31: }\n32: #[derive(Deserialize)]\n33: #[serde(deny_unknown_fields)]\n34: struct Manifest { version: u32, files: Vec<SystemFile> }\n35: #[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]\n36: #[serde(deny_unknown_fields)]\n37: pub struct Fingerprint { sha256: String, mode: u32, uid: u32, gid: u32 }\n38: #[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]\n39: #[serde(deny_unknown_fields)]\n40: pub enum Identity {\n41:     Btrfs { uuid: String, subvolume: u64, inode: u64 },\n42:     Other { device: u64, inode: u64 },\n43: }\n44: #[derive(Clone, Debug, Deserialize, Serialize)]\n45: #[serde(deny_unknown_fields)]\n46: pub struct FileChange {\n47:     entry: SystemFile, before: Option<Fingerprint>, after: Fingerprint,\n48:     backup: PathBuf, temporary: PathBuf, parent: Option<Identity>,\n49:     #[serde(default)]\n50:     backup_parent: Option<Identity>,\n51:     started: bool, reverted: bool,\n52: }\n53: #[derive(Clone, Debug, Deserialize, Serialize)]\n54: #[serde(deny_unknown_fields)]\n55: pub struct DirectoryChange {\n56:     path: PathBuf, temporary: PathBuf, parent: Option<Identity>,\n57:     identity: Option<Identity>, started: bool, removed: bool,\n58:     #[serde(default = \"directory_mode\")]\n59:     mode: u32,\n60: }\n61: fn directory_mode() -> u32 { 0o755 }\n62: #[derive(Clone, Debug, Deserialize, Serialize)]\n63: #[serde(deny_unknown_fields)]\n64: pub struct Transaction {\n65:     pub manifest_sha256: String, files: Vec<FileChange>, directories: Vec<DirectoryChange>,\n66:     #[serde(default)]\n67:     backup_directory: Option<PathBuf>,\n68: }\n69: #[derive(Clone, Debug, Deserialize, Serialize)]\n70: #[serde(deny_unknown_fields)]\n71: pub struct Receipt {\n72:     pub release: String, pub transaction: Transaction,\n73:     pub previous_boot_id: String, pub reboot_requested: bool,\n74: }\n75: pub fn receipt(release: &str, transaction: &Transaction) -> Result<Receipt> {\n76:     let boot_id = std::fs::read_to_string(\"/proc/sys/kernel/random/boot_id\")?;\n77:     let boot_id = uuid::Uuid::parse_str(boot_id.trim())?.to_string();\n78:     Ok(Receipt { release: release.into(), transaction: transaction.clone(), previous_boot_id: boot_id, reboot_requested: false })\n79: }\n80: fn backup_fingerprint(before: &Fingerprint) -> Fingerprint {"}
