{"step_index":89,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-26T10:17:05Z","content":"Created At: 2026-10-26T10:17:05Z\nCompleted At: 2026-10-26T10:17:05Z\nShowing lines 250-400 of 645\n250:     // Installing a down marker must not change an existing service's wanted state.\n251:     for file in &files {\n252:         if let Some((name, \"down\")) = service_member(&file.entry.path) {\n253:             ensure!(!services::linked(name)? && inspect(&Path::new(SERVICES).join(name).join(\"run\"))?.is_none(),\n254:                 \"a new down marker is only valid for a new, disabled service\");\n255:         }\n256:     }\n257:     let backup_directory = if files.iter().any(|file| file.before.is_some()) {\n258:         let path = Path::new(STATE).parent().unwrap().join(format!(\"system-backups-{transaction}\"));\n259:         let parent = existing_parent(path.parent().unwrap())?.context(\"release state directory is missing\")?;\n260:         ensure!(existing_parent(&path)?.is_none(), \"system backup directory already exists\");\n261:         directories.push(DirectoryChange { path: path.clone(), temporary: format!(\".system-backups-{transaction}\").into(),\n262:             parent: Some(parent), identity: None, started: false, removed: false, mode: 0o700 });\n263:         Some(path)\n264:     } else { None };\n265:     Ok(Transaction { manifest_sha256, files, directories, backup_directory })\n266: }\n267: pub fn supplies_dispatcher(transaction: Option<&Transaction>, name: &str) -> bool {\n268:     transaction.is_some_and(|t| t.files.iter().any(|f| f.entry.path == Path::new(SERVICES).join(name).join(\"run\") && f.before.is_none()))\n269: }\n270: pub fn installed_down(transaction: Option<&Transaction>, name: &str) -> bool {\n271:     transaction.is_some_and(|t| t.files.iter().any(|f| f.entry.path == Path::new(SERVICES).join(name).join(\"down\")\n272:         && f.before.is_none() && f.started && !f.reverted))\n273: }\n274: pub fn owns_directory(transaction: Option<&Transaction>, path: &Path) -> bool {\n275:     transaction.is_some_and(|t| t.directories.iter().any(|d| d.path == path))\n276: }\n277: fn name(path: &Path) -> Result<CString> {\n278:     fs::relative(path)?; ensure!(path.components().count() == 1, \"single component required\");\n279:     Ok(CString::new(path.as_os_str().as_bytes())?)\n280: }\n281: fn syscall(result: i32) -> Result<()> {\n282:     if result < 0 { Err(std::io::Error::last_os_error().into()) } else { Ok(()) }\n283: }\n284: fn stage_copy(parent: &File, destination: &Path, source: &mut File, mode: u32) -> Result<()> {\n285:     let destination = name(destination)?;\n286:     // An unnamed inode prevents partial backups/stages surviving a crash. Only\n287:     // fully written and synced files acquire the transaction-owned stage name.\n288:     // SAFETY: parent is pinned; O_TMPFILE creates a new owned inode.\n289:     let fd = unsafe { libc::openat(parent.as_raw_fd(), c\".\".as_ptr(), libc::O_TMPFILE | libc::O_RDWR | libc::O_CLOEXEC, 0o600) };\n290:     ensure!(fd >= 0, \"create unnamed system stage: {}\", std::io::Error::last_os_error());\n291:     // SAFETY: successful openat transfers fd ownership.\n292:     let mut file = unsafe { File::from_raw_fd(fd) };\n293:     // Inherited default ACLs must fail while the inode is still unnamed, so\n294:     // recovery never encounters an unsupported named stage that it cannot inspect.\n295:     reject_xattrs(&file)?;\n296:     let metadata = source.metadata()?;\n297:     source.seek(SeekFrom::Start(0))?;\n298:     std::io::copy(source, &mut file)?;\n299:     // SAFETY: apply exact mode to our owned inode.\n300:     syscall(unsafe { libc::fchmod(file.as_raw_fd(), mode) })?;\n301:     let times = [\n302:         libc::timespec { tv_sec: metadata.atime(), tv_nsec: metadata.atime_nsec() },\n303:         libc::timespec { tv_sec: metadata.mtime(), tv_nsec: metadata.mtime_nsec() },\n304:     ];\n305:     // SAFETY: preserve the source's access/modification times on our new inode.\n306:     syscall(unsafe { libc::futimens(file.as_raw_fd(), times.as_ptr()) })?;\n307:     file.sync_all()?;\n308:     let descriptor_path = CString::new(format!(\"/proc/self/fd/{}\", file.as_raw_fd()))?;\n309:     // SAFETY: this kernel-owned link names our live unnamed descriptor, not a\n310:     // caller-supplied symlink; the destination is beneath the pinned parent.\n311:     syscall(unsafe { libc::linkat(libc::AT_FDCWD, descriptor_path.as_ptr(), parent.as_raw_fd(), destination.as_ptr(), libc::AT_SYMLINK_FOLLOW) })?;\n312:     Ok(parent.sync_all()?)\n313: }\n314: fn replace_at(parent: &File, temporary: &Path, destination: &Path) -> Result<()> {\n315:     let temporary = name(temporary)?; let destination = name(destination)?;\n316:     // SAFETY: both single-component names refer to the same pinned parent.\n317:     syscall(unsafe { libc::renameat(parent.as_raw_fd(), temporary.as_ptr(), parent.as_raw_fd(), destination.as_ptr()) })?;\n318:     Ok(parent.sync_all()?)\n319: }\n320: fn pinned_parent(path: &Path, expected: Option<&Identity>) -> Result<File> {\n321:     let parent = fs::secure_absolute(path.parent().context(\"system path has no parent\")?, libc::O_RDONLY | libc::O_DIRECTORY)?;\n322:     reject_xattrs(&parent)?;\n323:     if let Some(expected) = expected { ensure!(&identity(&parent)? == expected, \"system parent identity changed\"); }\n324:     Ok(parent)\n325: }\n326: fn backup_parent(transaction: &Transaction, expected: Option<&Identity>) -> Result<File> {\n327:     let path = transaction.backup_directory.as_ref().context(\"system backup directory is not recorded\")?;\n328:     let directory = fs::secure_absolute(path, libc::O_RDONLY | libc::O_DIRECTORY)?;\n329:     reject_xattrs(&directory)?;\n330:     let created = transaction.directories.iter().find(|change| &change.path == path)\n331:         .and_then(|change| change.identity.as_ref()).context(\"system backup directory creation identity is missing\")?;\n332:     ensure!(&identity(&directory)? == created, \"system backup directory is not the transaction-created directory\");\n333:     let metadata = directory.metadata()?;\n334:     ensure!(metadata.uid() == 0 && metadata.gid() == 0 && metadata.mode() & 0o7777 == 0o700,\n335:         \"system backup directory must be private root:root 0700\");\n336:     if let Some(expected) = expected { ensure!(&identity(&directory)? == expected, \"system backup directory identity changed\"); }\n337:     Ok(directory)\n338: }\n339: fn check_overlay(path: &Path) -> Result<()> {\n340:     ensure!(overlay_paths()?.iter().all(|p| !overlaps(path, p)), \"system destination became covered by an overlay\"); Ok(())\n341: }\n342: pub fn apply(state: &mut State, root: &File) -> Result<()> {\n343:     let Some(transaction) = state.journal.as_ref().and_then(|j| j.system.as_ref()) else { return Ok(()); };\n344:     let count = transaction.directories.len();\n345:     for index in 0..count {\n346:         let change = state.journal.as_ref().unwrap().system.as_ref().unwrap().directories[index].clone();\n347:         check_overlay(&change.path)?;\n348:         let parent = pinned_parent(&change.path, change.parent.as_ref())?;\n349:         ensure!(existing_parent(&change.path)?.is_none(), \"system parent appeared after planning\");\n350:         {\n351:             let dir = &mut state.journal.as_mut().unwrap().system.as_mut().unwrap().directories[index];\n352:             dir.parent = Some(identity(&parent)?); dir.started = true;\n353:         }\n354:         state.intent(format!(\"system-directory-stage:{}\", change.path.display()))?;\n355:         fs::mkdir_at(parent.as_fd(), &change.temporary, change.mode)?;\n356:         let dir = fs::open_beneath(parent.as_fd(), &change.temporary, libc::O_RDONLY | libc::O_DIRECTORY)?;\n357:         state.journal.as_mut().unwrap().system.as_mut().unwrap().directories[index].identity = Some(identity(&dir)?);\n358:         state.intent(format!(\"system-directory-publish:{}\", change.path.display()))?;\n359:         fs::rename_at(parent.as_fd(), &change.temporary, parent.as_fd(), Path::new(change.path.file_name().unwrap()))?;\n360:     }\n361:     let count = state.journal.as_ref().unwrap().system.as_ref().unwrap().files.len();\n362:     for index in 0..count {\n363:         let change = state.journal.as_ref().unwrap().system.as_ref().unwrap().files[index].clone();\n364:         check_overlay(&change.entry.path)?;\n365:         let parent = pinned_parent(&change.entry.path, change.parent.as_ref())?;\n366:         let basename = Path::new(change.entry.path.file_name().unwrap());\n367:         ensure!(inspect_at(&parent, basename)? == change.before, \"system destination changed after planning\");\n368:         let backups = if change.before.is_some() {\n369:             Some(backup_parent(state.journal.as_ref().unwrap().system.as_ref().unwrap(), None)?)\n370:         } else { None };\n371:         {\n372:             let file = &mut state.journal.as_mut().unwrap().system.as_mut().unwrap().files[index];\n373:             file.parent = Some(identity(&parent)?); file.started = true;\n374:             file.backup_parent = backups.as_ref().map(identity).transpose()?;\n375:         }\n376:         state.intent(format!(\"system-file-backup:{}\", change.entry.path.display()))?;\n377:         if let Some(before) = &change.before {\n378:             let mut original = fs::open_beneath(parent.as_fd(), basename, libc::O_RDONLY | libc::O_NOATIME)?;\n379:             check_file(&original)?;\n380:             let backups = backups.as_ref().context(\"missing system backup descriptor\")?;\n381:             stage_copy(backups, &change.backup, &mut original, 0o600)?;\n382:             ensure!(inspect_at(backups, &change.backup)? == Some(backup_fingerprint(before)), \"system backup differs from preflight\");\n383:         }\n384:         let mut source = fs::open_beneath(root.as_fd(), &change.entry.source, libc::O_RDONLY | libc::O_NOATIME)?;\n385:         check_file(&source)?; verify_digest(&mut source, &change.entry.sha256)?;\n386:         stage_copy(&parent, &change.temporary, &mut source, change.entry.mode)?;\n387:         ensure!(inspect_at(&parent, &change.temporary)?.as_ref() == Some(&change.after), \"staged system payload differs\");\n388:         state.intent(format!(\"system-file-replace:{}\", change.entry.path.display()))?;\n389:         ensure!(inspect_at(&parent, basename)? == change.before, \"system destination interfered with before replacement\");\n390:         if change.before.is_none() { fs::rename_at(parent.as_fd(), &change.temporary, parent.as_fd(), basename)?; }\n391:         else { replace_at(&parent, &change.temporary, basename)?; }\n392:         state.intent(format!(\"system-file-applied:{}\", change.entry.path.display()))?;\n393:     }\n394:     Ok(())\n395: }\n396: fn remove_matching(parent: &File, path: &Path, expected: &Fingerprint) -> Result<()> {\n397:     if let Some(actual) = inspect_at(parent, path)? {\n398:         ensure!(&actual == expected, \"transaction evidence changed: {}\", path.display());\n399:         fs::remove_at(parent.as_fd(), path, false)?;\n400:     }"}
