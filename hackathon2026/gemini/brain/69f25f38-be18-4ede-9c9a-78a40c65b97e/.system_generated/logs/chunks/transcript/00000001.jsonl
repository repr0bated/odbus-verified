est { version: u32, files: Vec<SystemFile> }\n35: #[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]\n36: #[serde(deny_unknown_fields)]\n37: pub struct Fingerprint { sha256: String, mode: u32, uid: u32, gid: u32 }\n38: #[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]\n39: #[serde(deny_unknown_fields)]\n40: pub enum Identity {\n41:     Btrfs { uuid: String, subvolume: u64, inode: u64 },\n42:     Other { device: u64, inode: u64 },\n43: }\n44: #[derive(Clone, Debug, Deserialize, Serialize)]\n45: #[serde(deny_unknown_fields)]\n46: pub struct FileChange {\n47:     entry: SystemFile, before: Option<Fingerprint>, after: Fingerprint,\n48:     backup: PathBuf, temporary: PathBuf, parent: Option<Identity>,\n49:     #[serde(default)]\n50:     backup_parent: Option<Identity>,\n51:     started: bool, reverted: bool,\n52: }\n53: #[derive(Clone, Debug, Deserialize, Serialize)]\n54: #[serde(deny_unknown_fields)]\n55: pub struct DirectoryChange {\n56:     path: PathBuf, temporary: PathBuf, parent: Option<Identity>,\n57:     identity: Option<Identity>, started: bool, removed: bool,\n58:     #[serde(default = \"directory_mode\")]\n59:     mode: u32,\n60: }\n61: fn directory_mode() -> u32 { 0o755 }\n62: #[derive(Clone, Debug, Deserialize, Serialize)]\n63: #[serde(deny_unknown_fields)]\n64: pub struct Transaction {\n65:     pub manifest_sha256: String, files: Vec<FileChange>, directories: Vec<DirectoryChange>,\n66:     #[serde(default)]\n67:     backup_directory: Option<PathBuf>,\n68: }\n69: #[derive(Clone, Debug, Deserialize, Serialize)]\n70: #[serde(deny_unknown_fields)]\n71: pub struct Receipt {\n72:     pub release: String, pub transaction: Transaction,\n73:     pub previous_boot_id: String, pub reboot_requested: bool,\n74: }\n75: pub fn receipt(release: &str, transaction: &Transaction) -> Result<Receipt> {\n76:     let boot_id = std::fs::read_to_string(\"/proc/sys/kernel/random/boot_id\")?;\n77:     let boot_id = uuid::Uuid::parse_str(boot_id.trim())?.to_s