                  "x-oscal-subid": "src.service.llm-model-route.source@v1"
                },
                "status": {
                  "default": "",
                  "description": "Declared operational status.",
                  "type": "string",
                  "x-oscal-subid": "obs.software.llm-model-route.status@v1"
                },
                "status_reason": {
                  "default": "",
                  "description": "Human-readable reason for the current availability status.",
                  "type": "string",
                  "x-oscal-subid": "obs.software.llm-model-route.status-reason@v1"
