{"source_path":"/home/jeremy/.claude/projects/-srv-git-odbus-verified/f4c461eb-d25f-4247-9bd7-eddda9ade635.jsonl","source_line":224,"timestamp":"2026-10-19T01:49:04.805Z","uuid":"ab752b05-a646-4632-8b90-b5f1ddfe7320","parentUuid":"1284c13f-35ab-43c8-97df-65c22aa7a9b5","sessionId":"f4c461eb-d25f-4247-9bd7-eddda9ade635","type":"user","role":"user","content":[{"tool_use_id":"toolu_01Cgjp9aQwQrWoLGYoBsDZ3E","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# Completed manual provisioning step: one sparse disk, root + upgrade partitions.\n3\t# Storage preparation only; identity registration and container startup are separate.\n4\tset -euo pipefail\n5\tfail() { printf 'prepare-instance-disk: %s\\n' \"$*\" >&2; exit 1; }\n6\tusage() {\n7\t    cat <<'USAGE'\n8\tUsage:\n9\t  prepare-instance-disk create NAME [--root-gib N] [--upgrade-gib N]\n10\t  prepare-instance-disk inspect NAME\n11\t  prepare-instance-disk prepare NAME --seed-device /dev/disk/by-uuid/UUID\n12\t\n13\tPool: /var/lib/3tched-leaf-pool (mounted @3tched-leaf-pool)\n14\tImage: NAME.img, sparse raw, GPT root + upgrade partitions\n15\tDefaults: 20 GiB root, remaining approximately 40 GiB upgrade.\n16\tExisting images are never adopted, repartitioned or overwritten by create.\n17\tinspect reads the image and reports its partition table; it does not modify it.\n18\tUSAGE\n19\t}\n20\t[[ $# -gt 0 ]] || { usage; exit 2; }\n21\tcase $1 in -h|--help) usage; exit 0 ;; esac\n22\t[[ $# -ge 2 ]] || fail 'action and instance name required'\n23\taction=$1 name=$2\n24\tshift 2\n25\t[[ $action == create || $action == inspect || $action == prepare ]] || fail 'unknown action'\n26\t[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$ ]] || fail 'invalid instance name'\n27\troot_gib=20 upgrade_gib=40 seed_device=\n28\twhile [[ $# -gt 0 ]]; do\n29\t    [[ $action != inspect ]] || fail 'inspect takes no options'\n30\t    [[ $# -ge 2 ]] || fail \"missing value for $1\"\n31\t    case $1 in\n32\t        --root-gib) [[ $action == create ]] || fail 'size applies to create'; root_gib=$2 ;;\n33\t        --upgrade-gib) [[ $action == create ]] || fail 'size applies to create'; upgrade_gib=$2 ;;\n34\t        --seed-device) [[ $action == prepare ]] || fail 'seed applies to prepare'; seed_device=$2 ;;\n35\t        *) fail \"unknown option: $1\" ;;\n36\t    esac\n37\t    shift 2\n38\tdone\n39\t[[ $(id -u) == 0 ]] || fail 'host root owns disk preparation'\n40\tfor tool in qemu-img sfdisk jq findmnt realpath stat flock date sync; do\n41\t    command -v \"$tool\" >/dev/null || fail \"missing $tool\"\n42\tdone\n43\tfor size in \"$root_gib\" \"$upgrade_gib\"; do\n44\t    [[ $size =~ ^[1-9][0-9]{0,3}$ ]] && (( size <= 1024 )) || fail 'partition size must be 1 to 1024 GiB'\n45\tdone\n46\tpool=/var/lib/3tched-leaf-pool\n47\t[[ -d $pool && ! -L $pool && $(realpath -e \"$pool\") == \"$pool\" ]] || fail 'leaf pool is absent or noncanonical'\n48\t[[ $(findmnt -rn -M \"$pool\" -o FSTYPE) == btrfs && $(findmnt -rn -M \"$pool\" -o FSROOT) == /@3tched-leaf-pool ]] || fail 'expected mounted @3tched-leaf-pool; refusing a root-directory fallback'\n49\t[[ $(stat -c '%u %a' \"$pool\") == '0 700' ]] || fail 'leaf pool must be root-owned mode 0700'\n50\timage=$pool/$name.img\n51\tif [[ $action == inspect ]]; then\n52\t    [[ -f $image && ! -L $image ]] || fail 'image is absent or not a regular file'\n53\t    qemu-img info -f raw --output=json \"$image\"\n54\t    sfdisk --json \"$image\"\n55\t    exit 0\n56\tfi\n57\tumask 077\n58\treceipt_root=$pool/.provisioning\n59\t[[ ! -L $receipt_root ]] || fail 'receipt directory is a symlink'\n60\tmkdir -p -- \"$receipt_root\"\n61\t[[ $(stat -c '%u %a' \"$receipt_root\") == '0 700' ]] || fail 'receipt directory must be root-owned mode 0700'\n62\tlock=$receipt_root/$name.lock\n63\t[[ ! -L $lock && ( ! -e $lock || -f $lock ) ]] || fail 'invalid instance lock'\n64\texec 9>\"$lock\"\n65\tflock -n 9 || fail 'another preparation owns this instance'\n66\treceipt=$receipt_root/$name.json\n67\tif [[ $action == prepare ]]; then\n68\t    for tool in losetup blkid blockdev btrfs mkfs.btrfs mount umount rg sed install; do\n69\t        command -v \"$tool\" >/dev/null || fail \"missing $tool\"\n70\t    done\n71\t    [[ $seed_device == /dev/disk/by-uuid/* && -b $seed_device ]] || fail 'stable seed UUID path required'\n72\t    [[ -f $image && ! -L $image && -f $receipt && ! -L $receipt ]] || fail 'disk and creation receipt required'\n73\t    jq -e --arg image \"$image\" --arg name \"$name\" --arg inode \"$(stat -c %i \"$image\")\" \\\n74\t        --argjson bytes \"$(stat -c %s \"$image\")\" \\\n75\t        '.phase==\"disk-partitioned\" and .image==$image and .name==$name and\n76\t         .image_inode==$inode and .image_bytes==$bytes and .identity_registered==false' \"$receipt\" >/dev/null || fail 'not a fresh partitioned disk; never repeat device-add'\n77\t    table=$(sfdisk --json \"$image\")\n78\t    jq -e --argjson actual \"$table\" '.partition_table==$actual.partitiontable and\n79\t        (.partition_table.partitions|length)==2' \"$receipt\" >/dev/null || fail 'partition table differs from receipt'\n80\t    [[ -z $(losetup -j \"$image\") ]] || fail 'image already attached'\n81\t    seed_fsid=$(blkid -p -s UUID -o value \"$seed_device\")\n82\t    [[ $seed_device == /dev/disk/by-uuid/\"$seed_fsid\" ]] || fail 'seed UUID mismatch'\n83\t    btrfs inspect-internal dump-super \"$seed_device\" | sed -n '/flags/,/fsid/p' | rg -q SEEDING || fail 'seed is not sealed'\n84\t    root_mount=$pool/.mounts/$name/root\n85\t    upgrade_mount=$pool/.mounts/$name/upgrade\n86\t    [[ ! -e $pool/.mounts/$name ]] || fail 'mount directory already exists'\n87\t    phase() {\n88\t        jq --arg phase \"$1\" '.phase=$phase' \"$receipt\" > \"$receipt.new\"\n89\t        mv -T \"$receipt.new\" \"$receipt\"\n90\t        sync -f \"$receipt_root\"\n91\t    }\n92\t    phase filesystem-prepare-intent\n93\t    mkdir -p \"$root_mount\" \"$upgrade_mount\"\n94\t    blockdev --setro \"$seed_device\"\n95\t    seed_loop=$(losetup --find --show --read-only \"$seed_device\")\n96\t    disk_loop=$(losetup --find --show --partscan \"$image\")\n97\t    root_partition=${disk_loop}p1 upgrade_partition=${disk_loop}p2\n98\t    jq --arg seed \"$seed_device\" --arg sf \"$seed_fsid\" --arg sl \"$seed_loop\" --arg dl \"$disk_loop\" \\\n99\t        --arg rp \"$root_partition\" --arg up \"$upgrade_partition\" --arg rm \"$root_mount\" --arg um \"$upgrade_mount\" \\\n100\t        '.seed_device=$seed|.seed_fsid=$sf|.seed_loop=$sl|.disk_loop=$dl|\n101\t         .root_partition=$rp|.upgrade_partition=$up|.root_mount=$rm|.upgrade_mount=$um' \"$receipt\" > \"$receipt.new\"\n102\t    mv -T \"$receipt.new\" \"$receipt\"\n103\t    for partition in \"$root_partition\" \"$upgrade_partition\"; do\n104\t        [[ -b $partition && -z $(blkid -p -s TYPE -o value \"$partition\" || true) ]] || fail 'partition is not blank'\n105\t    done\n106\t    mount -o ro,subvolid=5 \"$seed_loop\" \"$root_mount\"\n107\t    for member in @ @agent_memory @agent_rules @agent_shared @agent_skills @agent_soul @agent_user; do\n108\t        btrfs subvolume show \"$root_mount/$member\" >/dev/null || fail \"seed missing $member\"\n109\t    done\n110\t    phase root-device-add-intent\n111\t    btrfs device add \"$root_partition\" \"$root_mount\"\n112\t    sync -f \"$root_mount\"\n113\t    umount \"$root_mount\"\n114\t    mount -o \"rw,subvolid=5,device=$seed_loop,device=$root_partition\" \"$root_partition\" \"$root_mount\"\n115\t    phase upgrade-format-intent\n116\t    mkfs.btrfs -L 3tched-upgrade \"$upgrade_partition\"\n117\t    mount -o rw,subvolid=5 \"$upgrade_partition\" \"$upgrade_mount\"\n118\t    btrfs subvolume create \"$upgrade_mount/@\"\n119\t    for member in @agent_memory @agent_rules @agent_skills @agent_user; do\n120\t        btrfs property set -ts \"$root_mount/$member\" ro false\n121\t    done\n122\t    for member in @agent_shared @agent_soul; do\n123\t        btrfs property set -ts \"$root_mount/$member\" ro true\n124\t    done\n125\t    install -d -m 0700 \"$root_mount/@agent_user/persist\"\n126\t    install -d -m 0755 \"$root_mount/@/opt/run-mounts/persist\"\n127\t    sync -f \"$root_mount\"\n128\t    sync -f \"$upgrade_mount\"\n129\t    jq --arg rf \"$(blkid -p -s UUID -o value \"$root_partition\")\" \\\n130\t        --arg uf \"$(blkid -p -s UUID -o value \"$upgrade_partition\")\" \\\n131\t        '.root_fsid=$rf|.upgrade_fsid=$uf|.filesystem_prepared=true|.phase=\"filesystems-prepared\"' \"$receipt\" > \"$receipt.new\"\n132\t    mv -T \"$receipt.new\" \"$receipt\"\n133\t    sync -f \"$receipt_root\"\n134\t    printf 'Filesystems prepared; mounts retained for next manual step. Receipt: %s\\n' \"$receipt\"\n135\t    exit 0\n136\tfi\n137\t[[ ! -e $image && ! -L $image ]] || fail 'image already exists; use inspect, never repeat creation'\n138\treceipt=$receipt_root/$name.json\n139\t[[ ! -e $receipt && ! -L $receipt ]] || fail 'retained preparation intent exists; inspect before any retry'\n140\ttotal_gib=$((root_gib + upgrade_gib))\n141\tcreated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)\n142\tjq -n --arg name \"$name\" --arg image \"$image\" --arg pool \"$pool\" --arg time \"$created_at\" \\\n143\t    --argjson root \"$root_gib\" --argjson upgrade \"$upgrade_gib\" --argjson total \"$total_gib\" \\\n144\t    '{version:1,layout:\"raw-gpt-root-upgrade-v1\",phase:\"disk-create-intent\",\n145\t      name:$name,image:$image,pool:$pool,created_at:$time,\n146\t      root_gib:$root,upgrade_gib_requested:$upgrade,total_gib:$total,\n147\t      identity_registered:false,filesystem_prepared:false}' > \"$receipt\"\n148\t# qemu-img creates a sparse raw disk; GPT/alignment overhead reduces partition 2\n149\t# slightly. All commands address only the newly created image, never a host disk.\n150\tqemu-img create -f raw \"$image\" \"${total_gib}G\"\n151\tchmod 0600 \"$image\"\n152\tsfdisk \"$image\" <<PARTITIONS\n153\tlabel: gpt\n154\tunit: sectors\n155\t\n156\tsize=${root_gib}G, type=L, name=\"3tched-root\"\n157\ttype=L, name=\"3tched-upgrade\"\n158\tPARTITIONS\n159\tpartition_table=$(sfdisk --json \"$image\")\n160\t# Pin partition identities now; loop numbers are runtime attachments, not owners.\n161\tjq --arg inode \"$(stat -c %i \"$image\")\" --argjson bytes \"$(stat -c %s \"$image\")\" \\\n162\t    --argjson partition_table \"$partition_table\" \\\n163\t    '.phase=\"disk-partitioned\" | .image_inode=$inode | .image_bytes=$bytes |\n164\t     .partition_table=$partition_table.partitiontable' \"$receipt\" > \"$receipt.new\"\n165\tmv -T -- \"$receipt.new\" \"$receipt\"\n166\tsync -f \"$pool\"\n167\tprintf 'Prepared disk: %s\\nReceipt: %s\\n' \"$image\" \"$receipt\"\n168\tprintf '%s\\n' 'No filesystems formatted, container created, seed attached, or Cozo binding committed.'\n169\t"}]}
