{"source_path":"/home/jeremy/.claude/projects/-srv-git-odbus-verified/f4c461eb-d25f-4247-9bd7-eddda9ade635.jsonl","source_line":240,"timestamp":"2026-10-19T01:49:28.547Z","uuid":"ccc93abc-c018-453a-94af-6c02a2f188b4","parentUuid":"4ff60b17-5083-4835-8636-401e61cbacf2","sessionId":"f4c461eb-d25f-4247-9bd7-eddda9ade635","type":"user","role":"user","content":[{"tool_use_id":"toolu_01F2AiuYtCZqQUzTuLXVkUry","type":"tool_result","content":"80\t        [[ -f $intent && ! -L $intent && $(stat -c %a \"$intent\") == 600 ]] || die 'unsafe prepare intent'\n81\t        jq -e --argjson args \"$args\" --arg caller \"$operator\" '.prepare_args==$args and .caller_session==$caller' \\\n82\t            \"$intent\" >/dev/null || die 'retained preparation uses another operation/caller; reconcile it, never allocate a fresh ID'\n83\t    else\n84\t        tmp=$(mktemp \"$directory/.prepare.XXXXXX\")\n85\t        jq -n --argjson args \"$args\" --arg caller \"$operator\" \\\n86\t            '{version:1,phase:\"prepare-intent\",prepare_args:$args,caller_session:$caller}' > \"$tmp\"\n87\t        sync -f \"$tmp\"; ln \"$tmp\" \"$intent\"; rm -- \"$tmp\"; sync -f \"$directory\"\n88\t    fi\n89\t    [[ $(namespace_pin) == \"$pin\" ]] || die 'caller namespace changed before preparation'\n90\t    full=$(timeout --kill-after=5s 30s \"$client\" invoke --mount \"$control_mount\" --expected-session \"$operator\" \\\n91\t        --confirm-side-effects --args \"$args\" plugins/identity_sled/operations/prepare_container/call) ||\n92\t        die \"prepare failed or uncertain; retain $intent and reconcile ONLY operation $operation_id\"\n93\t    [[ $(namespace_pin) == \"$pin\" ]] || die 'caller namespace changed; retain operation for reconciliation'\n94\t    result=$(jq -ce --arg sid \"$sid\" --arg op \"$operation_id\" '\n95\t        select(.plugin_id==\"identity_sled\" and .method==\"prepare_container\") |\n96\t        .result | select(.success==true and .outcome==\"completed\" and .plugin_id==\"identity_sled\" and .method==\"prepare_container\") |\n97\t        .result | select(.session_id==$sid and .operation_id==$op and .phase==\"complete\" and\n98\t            (.replayed|type==\"boolean\") and (.name|type==\"string\" and test(\"^(3tchedCtlChatbot|ID-[1-9][0-9]*)$\") and length<=63) and\n99\t            (.native_uuid|type==\"string\" and test(\"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\")))\n100\t    ' <<<\"$full\") || die 'canonical preparation receipt differs; retain intent'\n101\t    name=$(jq -er .name <<<\"$result\")\n102\t    uuid=$(jq -er .native_uuid <<<\"$result\")\n103\t    instance=$(timeout --kill-after=5s 30s incus --force-local --project default query \"/1.0/instances/$name\") || die 'native readback unavailable; retain intent'\n104\t    jq -e --arg name \"$name\" --arg sid \"$sid\" --arg key \"$key\" --arg uuid \"$uuid\" --arg op \"$operation_id\" '\n105\t        .name==$name and .type==\"container\" and .config[\"volatile.uuid\"]==$uuid and\n106\t        .config[\"user.opdbus.session_id\"]==$sid and .config[\"user.opdbus.wireguard_public_key\"]==$key and\n107\t        .config[\"user.opdbus.creation_operation\"]==$op\n108\t    ' <<<\"$instance\" >/dev/null || die 'canonical/native preparation binding differs'\n109\t    [[ $(namespace_pin) == \"$pin\" ]] || die 'caller namespace changed after native readback'\n110\t    container_receipt=$directory/$name.incus.json\n111\t    [[ ! -L $directory/$name.lock ]] || die 'unsafe instance lock'\n112\t    exec 9>\"$directory/$name.lock\"\n113\t    flock -n 9 || die 'instance preparation active'\n114\t    if [[ -e $container_receipt || -L $container_receipt ]]; then\n115\t        root_path \"$container_receipt\"\n116\t        [[ -f $container_receipt && ! -L $container_receipt && $(stat -c %a \"$container_receipt\") == 600 ]] || die 'unsafe container receipt'\n117\t        jq -e --argjson args \"$args\" --argjson result \"$result\" --arg caller \"$operator\" '\n118\t            .prepare_args==$args and .caller_session==$caller and\n119\t            (.prepare_result|del(.replayed))==($result|del(.replayed))\n120\t        ' \"$container_receipt\" >/dev/null || die 'retained container receipt differs; no overwrite'\n121\t    else\n122\t        jq -e '.status==\"Stopped\" and .status_code==102' <<<\"$instance\" >/dev/null || die 'new candidate is not stopped'\n123\t        tmp=$(mktemp \"$directory/.container.XXXXXX\")\n124\t        jq -n --arg name \"$name\" --arg sid \"$sid\" --arg caller \"$operator\" --argjson args \"$args\" \\\n125\t            --argjson result \"$result\" --argjson instance \"$instance\" '\n126\t            {version:1,phase:\"container-defined\",name:$name,session_id:$sid,\n127\t             pool_source:\"/var/lib/incus-storage/identity-roots\",identity_registered:false,root_bound:false,started:false,\n128\t             caller_session:$caller,prepare_args:$args,prepare_result:$result,instance:$instance}\n129\t        ' > \"$tmp\"\n130\t        sync -f \"$tmp\"; ln \"$tmp\" \"$container_receipt\"; rm -- \"$tmp\"; sync -f \"$directory\"\n131\t    fi\n132\t    tmp=$(mktemp \"$directory/.prepare.XXXXXX\")\n133\t    jq --argjson result \"$result\" '.phase=\"complete\"|.prepare_result=$result' \"$intent\" > \"$tmp\"\n134\t    sync -f \"$tmp\"; mv -T \"$tmp\" \"$intent\"; sync -f \"$directory\"\n135\t    printf 'Prepared %s; receipt: %s; storage, binding and adoption remain separate.\\n' \"$name\" \"$container_receipt\" >&2\n136\t    printf '%s\\n' \"$name\"\n137\t)\n138\tcase $1 in\n139\t    --prepare-adoption)\n140\t        shift\n141\t        script_dir=$(dirname -- \"$(realpath -e -- \"${BASH_SOURCE[0]}\")\")\n142\t        adoption_helper=$script_dir/prepare-chatbot-adoption.sh\n143\t        [[ -x $adoption_helper ]] || adoption_helper=$script_dir/prepare-chatbot-adoption\n144\t        [[ -x $adoption_helper ]] || die 'adoption plan helper missing'\n145\t        exec \"$adoption_helper\" \"$@\"\n146\t        ;;\n147\t    --bind-root)\n148\t        shift\n149\t        script_dir=$(dirname -- \"$(realpath -e -- \"${BASH_SOURCE[0]}\")\")\n150\t        bind_helper=$script_dir/bind-instance-root.sh\n151\t        [[ -x $bind_helper ]] || bind_helper=$script_dir/bind-instance-root\n152\t        [[ -x $bind_helper ]] || die 'root binding helper missing'\n153\t        exec \"$bind_helper\" \"$@\"\n154\t        ;;\n155\t    --prepare-container)\n156\t        shift\n157\t        prepare_chatbot_container \"$@\"\n158\t        exit\n159\t        ;;\n160\t    --pair-upgrade|--sync-upgrade|--upgrade-boot)\n161\t        upgrade_action=pair\n162\t        [[ $1 != --sync-upgrade ]] || upgrade_action=sync\n163\t        [[ $1 != --upgrade-boot ]] || upgrade_action=boot\n164\t        shift\n165\t        script_dir=$(dirname -- \"$(realpath -e -- \"${BASH_SOURCE[0]}\")\")\n166\t        upgrade_helper=$script_dir/sync-instance-upgrade.sh\n167\t        [[ -x $upgrade_helper ]] || upgrade_helper=$script_dir/sync-instance-upgrade\n168\t        [[ -x $upgrade_helper ]] || die 'upgrade synchronization helper missing'\n169\t        exec \"$upgrade_helper\" \"$upgrade_action\" \"$@\"\n170\t        ;;\n171\t    --prepare-disk|--inspect-disk|--prepare-filesystems)\n172\t        disk_action=create\n173\t        [[ $1 != --inspect-disk ]] || disk_action=inspect\n174\t        [[ $1 != --prepare-filesystems ]] || disk_action=prepare\n175\t        shift\n176\t        script_dir=$(dirname -- \"$(realpath -e -- \"${BASH_SOURCE[0]}\")\")\n177\t        disk_helper=$script_dir/prepare-instance-disk.sh\n178\t        [[ -x $disk_helper ]] || disk_helper=$script_dir/prepare-instance-disk\n179\t        [[ -x $disk_helper ]] || die 'disk preparation helper is missing'\n180\t\n181\t        exec \"$disk_helper\" \"$disk_action\" \"$@\"\n182\t        ;;\n183\tesac\n184\tSYSTEM_MODE=false SYSTEM_NAME=\"\" ROLE=\"\"\n185\tif [[ $1 == --system ]]; then\n186\t    SYSTEM_MODE=true; shift; SYSTEM_NAME=${1:?container name required}; shift\n187\telse ROLE=$1; shift; fi\n188\tSYSTEM_IMAGE=${SYSTEM_CONTAINER_IMAGE:-raccoon}\n189\tSYSTEM_STORAGE_POOL=${SYSTEM_STORAGE_POOL:-3tched-storage}\n190\tIMAGE=${IDENTITY_SEED_IMAGE:-3a639373bb7a} IMAGE_OVERRIDDEN=false\n191\tSYSTEM_STORAGE=$SYSTEM_STORAGE_POOL SYSTEM_STORAGE_OVERRIDDEN=false\n192\tIDENTITY_ONLY_FLAGS=\"\" PUBKEY=\"\" SESSION_ID=\"\" OPERATOR_SESSION=\"\" LEAF_PATH=\"\" NATIVE_NAME=\"\"\n193\tFSTORAGE_GIB=2 NO_START=false OPERATION_ID=\"\"\n194\twhile [[ $# -gt 0 ]]; do\n195\t    case \"$1\" in\n196\t        --principal-group) die '--principal-group is retired; manage authorization separately before provisioning; existing grants are preserved' ;;\n197\t        --pubkey|--session-id|--operator-session|--leaf-path|--fstorage-gib|--container-name)\n198\t            option=$1; IDENTITY_ONLY_FLAGS=\"$IDENTITY_ONLY_FLAGS $option\"\n199\t            shift; value=${1:?option requires a value}\n200\t            case \"$option\" in\n201\t                --pubkey) PUBKEY=$value ;; --session-id) SESSION_ID=$value ;;\n202\t                --operator-session) OPERATOR_SESSION=$value ;; --leaf-path) LEAF_PATH=$value ;;\n203\t                --fstorage-gib) FSTORAGE_GIB=$value ;; --container-name) NATIVE_NAME=$value ;;\n204\t            esac ;;\n205\t        --operation-id) shift; OPERATION_ID=${1:?canonical operation UUID required} ;;\n206\t        --image) shift; IMAGE=${1:?}; IMAGE_OVERRIDDEN=true ;;\n207\t        --storage) shift; SYSTEM_STORAGE=${1:?}; SYSTEM_STORAGE_OVERRIDDEN=true ;;\n208\t        --no-start) NO_START=true ;;\n209\t        --system)\n210\t            [[ $SYSTEM_MODE == false ]] || die '--system specified more than once'\n211\t            SYSTEM_MODE=true; SYSTEM_NAME=$ROLE ;;\n212\t        --identity-dir|--private-key-file|--email|--mesh-ip)\n213\t            IDENTITY_ONLY_FLAGS=\"$IDENTITY_ONLY_FLAGS $1\"; shift; : \"${1:?}\"\n214\t            [[ $SYSTEM_MODE == true ]] || die 'legacy identity options are retired; use an existing authoritative session' ;;\n215\t        --ghostbridge|--semantic|--recreate)\n216\t            IDENTITY_ONLY_FLAGS=\"$IDENTITY_ONLY_FLAGS $1\"\n217\t            [[ $SYSTEM_MODE == true ]] || die 'legacy identity options are retired; no recreate or credential/socket mounts' ;;\n218\t        -h|--help) usage; exit 0 ;; *) die \"unknown option: $1\" ;;\n219\t    esac\n220\t    shift\n221\tdone\n222\tprovision_system_container() (\n223\t    [ -z \"$IDENTITY_ONLY_FLAGS\" ] || die \"--system cannot be combined with identity-only options:$IDENTITY_ONLY_FLAGS\"\n224\t    [ -n \"$SYSTEM_NAME\" ] || die '--system requires a display/retry label'\n225\t    [ \"${#SYSTEM_NAME}\" -le 63 ] || die 'system retry label must be at most 63 characters'\n226\t    case \"$SYSTEM_NAME\" in\n227\t        [!A-Za-z0-9]*|*[!A-Za-z0-9-]*) die 'system container name must begin with a letter or digit and contain only letters, digits, and hyphens' ;;\n228\t        *-) die 'system container name must end with a letter or digit' ;;\n229\t    esac\n230\t    [ -n \"$IMAGE\" ] || die 'system image must not be empty'\n231\t    case \"$IMAGE\" in -*) die 'system image must not begin with an option prefix' ;; esac\n232\t    [ -n \"$SYSTEM_STORAGE\" ] || die 'system storage pool must not be empty'\n233\t    case \"$SYSTEM_STORAGE\" in\n234\t        [!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) die 'system storage pool must begin with a letter or digit and contain only letters, digits, dot, underscore, and hyphen' ;;\n235\t    esac\n236\t\n237\t    [[ $(id -u) == 0 ]] || die 'system preparation requires host root for durable operation receipts'\n238\t    valid_uuid \"$OPERATION_ID\" || die '--operation-id canonical UUID required; reuse it after interruption'\n239\t    for tool in jq findmnt realpath stat incus timeout flock sync mktemp; do need_cmd \"$tool\"; done\n240\t    client=$(realpath -e -- \"${THREETCHED_FS:-/usr/local/libexec/op-dbus/bin/3tched-fs}\")\n241\t    [[ -f $client && -x $client ]] || die 'mounted client unavailable'\n242\t    root_path \"$client\"\n243\t    lungs_mount=${OP_3TCHEDFS_MOUNT:-/run/mounts/3tchedFS}\n244\t    # Mutations use this caller's mounted identity. Native observations below\n245\t    # are explicit host-maintenance readback, not a fallback after denial.\n246\t    namespace_pin() {\n247\t        [[ $(findmnt -rn -M \"$lungs_mount\" -o FSTYPE) == fuse.3tchedFS ]] || return 1\n248\t        findmnt -rn -M \"$lungs_mount\" -o ID || return \"$?\"\n249\t        timeout --kill-after=5s 30s jq -ce 'select(.format==\"3tchedfs/1\" and .mount_identity.kind==\"host_session\" and .mount_identity.session==.session_id) |\n250\t            select(.session_id|type==\"string\" and length>0) |\n251\t            {instance_uuid,session_id,source_catalog_hash,source_catalog_generation,view_id}' \\\n252\t            \"$lungs_mount/.3tchedfs.json\"\n253\t    }\n254\t    # The client checks the typed mode as well; capture the declared host SID\n255\t    # rather than silently choosing a different principal for --system.\n256\t    expected_session=${OP_3TCHEDFS_EXPECTED_SESSION:-$(jq -er '.session_id|select(type==\"string\" and length>0)' \"$lungs_mount/.3tchedfs.json\")}\n257\t    pin=$(namespace_pin) || die 'operator namespace unavailable'\n258\t    jq -e --arg sid \"$expected_session\" '.session_id==$sid' \"$lungs_mount/.3tchedfs.json\" >/dev/null || die 'operator session differs'\n259\t    assert_namespace() {\n260\t        local current\n261\t        current=$(namespace_pin) || die 'operator namespace lost; do not retry an uncertain operation'\n262\t        [[ $current == \"$pin\" ]] || die 'operator namespace changed; reconcile before retrying'\n263\t    }\n264\t    read_instances() {\n265\t        local state\n266\t        assert_namespace\n267\t        # The declared public projection intentionally redacts names/config and\n268\t        # devices. Never widen it or invent a get/list plugin method. Read the\n269\t        # same local default-project provider for this host maintenance tool.\n270\t        state=$(timeout --kill-after=5s 30s incus --force-local --project default query '/1.0/instances?recursion=1') || die 'bounded native instance readback failed'\n271\t        jq -e 'type==\"array\" and all(.[]; type==\"object\" and (.name|type==\"string\"))' <<<\"$state\" >/dev/null || die 'invalid native inventory'\n272\t        assert_namespace\n273\t        printf '%s\\n' \"$state\"\n274\t    }\n275\t    incus_call() {\n276\t        local method=$1 args=$2 receipt\n277\t        assert_namespace\n278\t        receipt=$(timeout --kill-after=5s 30s \"$client\" invoke --mount \"$lungs_mount\" --expected-session \"$expected_session\" \\\n279\t            --confirm-side-effects --args \"$args\" \"plugins/incus/operations/$method/call\") || return \"$?\"\n280\t        assert_namespace\n281\t        jq -ce --arg method \"$method\" 'select(.plugin_id==\"incus\" and .method==$method) |\n282\t            .result | select(.success==true and .outcome==\"completed\" and .plugin_id==\"incus\" and .method==$method) | .result' <<<\"$receipt\"\n283\t    }\n284\t    # Label is only a local durable retry fence and display metadata. It is NOT\n285\t    # a requested native name. Preserve the exact request/caller before invoke.\n286\t    label=$SYSTEM_NAME\n287\t    umask 077\n288\t    directory=${OP_SYSTEM_PROVISION_RECEIPTS:-/var/lib/opdbus-runtime/system-provision-receipts}\n289\t    [[ $directory == /* && $(realpath -m \"$directory\") == \"$directory\" && ! -L $directory ]] || die 'unsafe system receipt directory'\n290\t    root_path \"$(dirname \"$directory\")\"\n291\t    [[ -e $directory ]] || mkdir -m 0700 \"$directory\"\n292\t    root_path \"$directory\"\n293\t    [[ -d $directory && $(stat -c %a \"$directory\") == 700 ]] || die 'system receipt directory must be private'\n294\t    intent=$directory/$label.json\n295\t    [[ ! -L $directory/$label.lock ]] || die 'unsafe system creation lock'\n296\t    exec 9>\"$directory/$label.lock\"\n297\t    flock -n 9 || die 'system creation active'\n298\t    create_args=$(jq -cn --arg op \"$OPERATION_ID\" --arg label \"$label\" --arg image \"$IMAGE\" --arg pool \"$SYSTEM_STORAGE\" \\\n299\t        '{operation_id:$op,image:$image,source_mode:\"image\",instance_type:\"container\",profiles:[],\n300\t          config:{\"user.display_name\":$label,\"security.privileged\":\"false\",\"security.nesting\":\"false\",\"boot.autostart\":\"false\"},\n301\t          devices:[{name:\"root\",device:{type:\"disk\",path:\"/\",pool:$pool}}]}')\n302\t    if [[ -e $intent || -L $intent ]]; then\n303\t        root_path \"$intent\"\n304\t        [[ -f $intent && ! -L $intent && $(stat -c %a \"$intent\") == 600 ]] || die 'unsafe system intent'\n305\t        jq -e --argjson args \"$create_args\" --arg caller \"$expected_session\" \\\n306\t            '.args==$args and .caller_session==$caller' \"$intent\" >/dev/null ||\n307\t            die 'retained label uses another operation/request/caller; reconcile it, never allocate a fresh ID'\n308\t    else\n309\t        tmp=$(mktemp \"$directory/.create.XXXXXX\")\n310\t        jq -n --argjson args \"$create_args\" --arg caller \"$expected_session\" \\\n311\t            '{version:1,phase:\"create-intent\",args:$args,caller_session:$caller}' > \"$tmp\"\n312\t        sync -f \"$tmp\"; ln \"$tmp\" \"$intent\"; rm -- \"$tmp\"; sync -f \"$directory\"\n313\t    fi\n314\t    created=$(incus_call create_instance \"$create_args\") || die \"create failed or uncertain; retain $intent and reconcile ONLY operation $OPERATION_ID\"\n315\t    jq -e --arg op \"$OPERATION_ID\" '.operation_id==$op and .phase==\"complete\" and .created==true and\n316\t        (.replayed|type==\"boolean\") and (.name|type==\"string\" and test(\"^ID-[1-9][0-9]*$\") and length<=63) and\n317\t        (.native_uuid|type==\"string\" and test(\"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\"))\n318\t    ' <<<\"$created\" >/dev/null || die 'create receipt differs'\n319\t    SYSTEM_NAME=$(jq -er .name <<<\"$created\")\n320\t    native_uuid=$(jq -er .native_uuid <<<\"$created\")\n321\t    if jq -e 'has(\"result\")' \"$intent\" >/dev/null; then\n322\t        jq -e --argjson result \"$created\" '(.result|del(.replayed))==($result|del(.replayed))' \"$intent\" >/dev/null || die 'retained native allocation changed'\n323\t    fi\n324\t    tmp=$(mktemp \"$directory/.create.XXXXXX\")\n325\t    jq --argjson result \"$created\" '.phase=\"complete\"|.result=$result' \"$intent\" > \"$tmp\"\n326\t    sync -f \"$tmp\"; mv -T \"$tmp\" \"$intent\"; sync -f \"$directory\"\n327\t    printf 'Assigned %s; receipt: %s\\n' \"$SYSTEM_NAME\" \"$intent\"\n328\t    verify_instance() {\n329\t        local status=$1 instances\n330\t        instances=$(read_instances) || return \"$?\"\n331\t        jq -e --arg name \"$SYSTEM_NAME\" --arg pool \"$SYSTEM_STORAGE\" --arg status \"$status\" --arg uuid \"$native_uuid\" --arg op \"$OPERATION_ID\" '\n332\t            [.[]|select(.name==$name)] | select(length==1) | .[0] |\n333\t            .type==\"container\" and .status==$status and .profiles==[] and\n334\t            .config[\"volatile.uuid\"]==$uuid and .config[\"user.opdbus.creation_operation\"]==$op and\n335\t            .config[\"security.privileged\"]==\"false\" and .config[\"security.nesting\"]==\"false\" and\n336\t            .config[\"boot.autostart\"]==\"false\" and\n337\t            .devices.root.type==\"disk\" and .devices.root.path==\"/\" and .devices.root.pool==$pool\n338\t        ' <<<\"$instances\" >/dev/null\n339\t    }\n340\t    instance_list=$(read_instances) || die 'assigned instance readback failed'\n341\t    state=$(jq -er --arg name \"$SYSTEM_NAME\" '[.[]|select(.name==$name)]|select(length==1)|.[0].status' <<<\"$instance_list\") || die 'assigned instance missing or ambiguous'\n342\t    case \"$state\" in\n343\t        Stopped) verify_instance Stopped || die 'created instance state differs; reconcile retained candidate' ;;\n344\t        Running)\n345\t            [[ $NO_START != true && $(jq -r .replayed <<<\"$created\") == true ]] || die 'unexpected running candidate; no lifecycle mutation performed'\n346\t            verify_instance Running || die 'replayed running instance differs'\n347\t            ;;\n348\t        *) die 'unsupported assigned instance state; reconcile retained candidate' ;;\n349\t    esac\n350\t    if [[ $NO_START != true && $state == Stopped ]]; then\n351\t        # A retained start intent is uncertain, not permission to issue another\n352\t        # start. A Running readback above can finish it without a mutation.\n353\t        jq -e '.start_requested!=true' \"$intent\" >/dev/null || die 'retained start intent is not running; inspect before explicit recovery'\n354\t        tmp=$(mktemp \"$directory/.start.XXXXXX\")\n355\t        jq '.start_requested=true' \"$intent\" > \"$tmp\"\n356\t        sync -f \"$tmp\"; mv -T \"$tmp\" \"$intent\"; sync -f \"$directory\"\n357\t        start_args=$(jq -cn --arg name \"$SYSTEM_NAME\" '{name:$name}')\n358\t        started=$(incus_call start_instance \"$start_args\") || die 'start failed or outcome uncertain; inspect existing instance before retrying'\n359\t        jq -e --arg name \"$SYSTEM_NAME\" '.name==$name and .state==\"Running\"' <<<\"$started\" >/dev/null || die 'start receipt differs'\n360\t        verify_instance Running || die 'running instance readback differs'\n361\t    fi\n362\t    printf 'Standalone container %s: mounted Incus receipts and native state verified; grants unchanged.\\n' \"$SYSTEM_NAME\"\n363\t)\n364\t\n365\tif [[ $SYSTEM_MODE == true ]]; then\n366\t    if [[ $IMAGE_OVERRIDDEN == false ]]; then IMAGE=$SYSTEM_IMAGE; fi\n367\t    provision_system_container; exit 0\n368\tfi\n369\tdie 'legacy unpartitioned provisioning is retired; use --prepare-container --operation-id UUID, then the assigned-name storage/adoption stages'"}]}
