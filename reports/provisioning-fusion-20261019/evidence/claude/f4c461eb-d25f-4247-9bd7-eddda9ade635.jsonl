stems not prepared'\n24\t# A numbered name is only a selector, never identity or allocation authority.\n25\t# The host preparation receipt and exact existing native UUID/key must agree.\n26\tjq -e --arg name \"$name\" --arg sid \"$sid\" --arg key \"$key\" '\n27\t    .version==1 and .name==$name and .session_id==$sid and\n28\t    .phase==\"container-defined\" and .identity_registered==false and .root_bound==false and\n29\t    .instance.name==$name and .instance.type==\"container\" and\n30\t    .instance.config[\"user.opdbus.session_id\"]==$sid and\n31\t    .instance.config[\"user.opdbus.wireguard_public_key\"]==$key and\n32\t    (.instance.config[\"volatile.uuid\"]|type==\"string\" and test(\"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\"))\n33\t' \"$receipt\" >/dev/null || fail 'configured chatbot preparation binding differs; reconcile existing intent'\n34\tnative_uuid=$(jq -er '.instance.config[\"volatile.uuid\"]' \"$receipt\")\n35\troot=$pool/.mounts/$name/root\n36\treplica=$pool/.mounts/$name/upgrade\n37\tview=$pool/.mounts/$name/root-view\n38\tseed_layer=$pool/.mounts/$name/seed-layer\n39\tupgrade_layer=$pool/.mounts/$name/upgrade-layer\n40\tcontainer_root=/var/lib/incus/storage-pools/identity-roots/containers/$name/rootfs\n41\timage=$pool/$name.img\n42\t[[ $(findmnt -rn -M \"$pool\" -o FSROOT) == /@3tched-leaf-pool &&\n43\t   $(jq -r .image \"$disk\") == \"$image\" && -f $image && ! -L $image &&\n44\t   $(stat -c %i \"$image\") == \"$(jq -r .image_inode \"$disk\")\" &&\n45\t   $(stat -c %s \"$image\") == \"$(jq -r .image_bytes \"$disk\")\" &&\n46\t   $(jq -r .root_mount \"$disk\") == \"$root\" &&\n47\t   $(findmnt -rn -M \"$root\" -o FSTYPE) == btrfs &&\n48\t   $(findmnt -rn -M \"$root\" -o FSROOT) == / ]] || fail 'prepared root/image pins differ'\n49\troot_source=$(findmnt -rn -M \"$root\" -o SOURCE)\n50\t[[ $(blkid -p -s UUID -o value \"$root_source\") == \"$(jq -r .root_fsid \"$disk\")\" ]] || fail 'wrong sprout filesystem'\n51\tjq -e '(.root_fsid|type)==\"st