lient\"\n243\t    lungs_mount=${OP_3TCHEDFS_MOUNT:-/run/mounts/3tchedFS}\n244\t    # Mutations use this caller's mounted identity. Native observations below\n245\t    # are explicit host-maintenance readback, not a fallback after denial.\n246\t    namespace_pin() {\n247\t        [[ $(findmnt -rn -M \"$lungs_mount\" -o FSTYPE) == fuse.3tchedFS ]] || return 1\n248\t        findmnt -rn -M \"$lungs_mount\" -o ID || return \"$?\"\n249\t        timeout --kill-after=5s 30s jq -ce 'select(.format==\"3tchedfs/1\" and .mount_identity.kind==\"host_session\" and .mount_identity.session==.session_id) |\n250\t            select(.session_id|type==\"string\" and length>0) |\n251\t            {instance_uuid,session_id,source_catalog_hash,source_catalog_generation,view_id}' \\\n252\t            \"$lungs_mount/.3tchedfs.json\"\n253\t    }\n254\t    # The client checks the typed mode as well; capture the declared host SID\n255\t    # rather than silently choosing a different principal for --system.\n256\t    expected_session=${OP_3TCHEDFS_EXPECTED_SESSION:-$(jq -er '.session_id|select(type==\"string\" and length>0)' \"$lungs_mount/.3tchedfs.json\")}\n257\t    pin=$(namespace_pin) || die 'operator namespace unavailable'\n258\t    jq -e --arg sid \"$expected_session\" '.session_id==$sid' \"$lungs_mount/.3tchedfs.json\" >/dev/null || die 'operator session differs'\n259\t    assert_namespace() {\n260\t        local current\n261\t        current=$(namespace_pin) || die 'operator namespace lost; do not retry an uncertain operation'\n262\t        [[ $current == \"$pin\" ]] || die 'operator namespace changed; reconcile before retrying'\n263\t    }\n264\t    read_instances() {\n265\t        local state\n266\t        assert_namespace\n267\t        # The declared public projection intentionally redacts names/config and\n268\t        # devices. Never widen it or invent a get/list plugin method. Read the\n269\t        # same local default-project provider for this host maintenance tool.\n270\t        state=$(timeout --kill-after=5s 30s incus --force-local --project default query '/1.0/instances?recursion=1') || die 'bounded native instance readback failed'\n271\t        jq -e 'type==\"array\" and all(.[]; type==\"object\" and (.name|type==\"string\"))' <<<\"$state\" >/dev/null || die 'invalid native inventory'\n272\t        assert_namespace\n273\t        printf '%s\\n' \"$state\"\n274\t    }\n275\t    incus_call() {\n276\t        local method=$1 args=$2 receipt\n277\t        assert_namespace\n278\t        receipt=$(timeout --kill-after=5s 30s \"$client\" invoke --mount \"$lungs_mount\" --expected-session \"$expected_session\" \\\n279\t            --confirm-side-effects --args \"$args\" \"plugins/incus/operations/$method/call\") || return \"$?\"\n280\t        assert_namespace\n281\t        jq -ce --arg method \"$method\" 'select(.plugin_id==\"incus\" and .method==$method) |\n282\t            .result | select(.success==true and .outcome==\"completed\" and .plugin_id==\"incus\" and .method==$method) | .result' <<<\"$receipt\"\n283\t    }\n284\t    # Label is only a local durable retry fence and display metadata. It is NOT\n285\t    # a requested native name. Preserve the exact request/caller before invoke.\n286\t    label=$SYSTEM_NAME\n287\t    umask 077\n288\t    directory=${OP_SYSTEM_PROVISION_RECEIPTS:-/var/lib/opdbus-runtime/system-provision-receipts}\n289\t    [[ $directory == /* && $(realpath -m \"$directory\") == \"$directory\" && ! -L $directory ]] || die 'unsafe system receipt directory'\n290\t    root_path \"$(dirname \"$directory\")\"\n291\t    [[ -e $directory ]] || mkdir -m 0700 \"$directory\"\n292\t    root_path \"$directory\"\n293\t    [[ -d $directory && $(stat -c %a \"$directory\") == 700 ]] || die 'system receipt directory must be private'\n294\t    intent=$directory/$label.json\n295\t    [[ ! -L $directory/$label.lock ]] || die 'unsafe system creation lock'\n296\t    exec 9>\"$directory/$label.lock\"\n297\t    flock -n 9 || die 'system creation active'\n298\t    create_args=$(jq -cn --arg op \"$OPERATION_ID\" --arg label \"$label\" --arg image \"$IMAGE\" --arg pool \"$SYSTEM_STORAGE\" \\\n299\t        '{operation_id:$op,image:$image,source_mode:\"image\",instance_type:\"container\",profiles:[],\n300\t          config:{\"user.display_name\":$label,\"security.privileged\":\"false\",\"security.nesting\":\"false\",\"boot.autostart\":\"false\"},\n301\t          devices:[{name:\"root\",device:{type:\"disk\",path:\"/\",pool:$pool}}]}')\n302\t    if [[ -e $intent || -L $intent ]]; then\n303\t        root_path \"$intent\"\n304\t        [[ -f $intent && ! -L $intent && $(stat -c %a \"$intent\") == 600 ]] || die 'unsafe system intent'\n305\t        jq -e --argjson args \"$create_args\" --arg caller \"$expected_session\" \\\n306\t            '.args==$args and .caller_session==$caller' \"$intent\" >/dev/null ||\n307\t            die 'retained label uses another operation/request/caller; reconcile it, never allocate a fresh ID'\n308\t    else\n309\t        tmp=$(mktemp \"$directory/.create.XXXXXX\")\n310\t        jq -n --argjson args \"$create_args\" --arg caller \"$expected_session\" \\\n311\t            '{version:1,phase:\"create-intent\",args:$args,caller_session:$caller}' > \"$tmp\"\n312\t        sync -f \"$tmp\"; ln \"$tmp\" \"$intent\"; rm -- \"$tmp\"; sync -f \"$directory\"\n313\t    fi\n314\t    created=$(incus_call create_instance \"$create_args\") || die \"create failed or uncertain; retain $intent and reconcile ONLY operation $OPERATION_ID\"\n315\t    jq -e --arg op \"$OPERATION_ID\" '.operation_id==$op and .phase==\"complete\" and .created==true and\n316\t        (.replayed|type==\"boolean\") and (.name|type==\"string\" and test(\"^ID-[1-9][0-9]*$\") and length<=63) and\n317\t        (.native_uuid|type==\"string\" and test(\"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$\"))\n318\t    ' <<<\"$created\" >/dev/null || die 'create receipt differs'\n319\t    SYSTEM_NAME=$(jq -er .name <<<\"$created\")\n320\t    native_uuid=$(jq -er .native_uuid <<<\"$created\")\n321\t    if jq -e 'has(\"result\")' \"$intent\" >/dev/null; then\n322\t        jq -e --argjson result \"$created\" '(.result|del(.replayed))==($result|del(.replayed))' \"$intent\" >/dev/null || die 'retained native allocation changed'\n323\t    fi\n324\t    tmp=$(mktemp \"$directory/.create.XXXXXX\")\n325\t    jq --argjson result \"$created\" '.phase=\"complete\"|.result=$result' \"$intent\" > \"$tmp\"\n326\t    sync -f \"$tmp\"; mv -T \"$tmp\" \"$intent\"; sync -f \"$directory\"\n327\t    printf 'Assigned %s; receipt: %s\\n' \"$SYSTEM_NAME\" \"$intent\"\n328\t    verify_instance() {\n329\t        local status=$1 instances\n330\t        instances=$(read_instances) || return \"$?\"\n331\t        jq -e --arg name \"$SYSTEM_NAME\" --arg pool \"$SYSTEM_STORAGE\" --arg status \"$status\" --arg uuid \"$native_uuid\" --arg op \"$OPERATION_ID\" '\n332\t            [.[]|select(.name==$name)] | select(length==1) | .[0] |\n333\t            .type==\"container\" and .status==$status and .profiles==[] and\n334\t            .config[\"volatile.uuid\"]==$uuid and .config[\"user.opdbus.creation_operation\"]==$op and\n335\t            .config[\"security.privileged\"]==\"false\" and .config[\"security.nesting\"]==\"false\" and\n336\t            .config[\"boot.autostart\"]==\"false\" and\n337\t            .devices.root.type==\"disk\" and .devices.root.path==\"/\" and .devices.root.pool==$pool\n338\t        ' <<<\"$instances\" >/dev/null\n339\t    }\n340\t    instance_list=$(read_instances) || die 'assigned instance readback failed'\n341\t    state=$(jq -er --arg name \"$SYSTEM_NAME\" '[.[]|select(.name==$name)]|select(length==1)|.[0].status' <<<\"$instance_list\") || die 'assigned instance missing or ambiguous'\n342\t    case \"$state\" in\n343\t        Stopped) verify_instance Stopped || die 'created instance state differs; reconcile retained candidate' ;;\n344\t        Running)\n345\t            [[ $NO_START != true && $(jq -r .replayed <<<\"$created\") == true ]] || die 'unexpected running candidate; no lifecycle mutation performed'\n346\t            verify_instance Running || die 'replayed running instance differs'\n347\t            ;;\n348\t        *) die 'unsupported assigned instance state; reconcile retained candidate' ;;\n349\t    esac\n350\t    if [[ $NO_START != true && $state == Stopped ]]; then\n351\t        # A retained start intent is uncertain, not permission to issue another\n352\t        # start. A Running readback above can finish it without a mutation.\n353\t        jq -e '.start_requested!=true' \"$intent\" >/dev/null || die 'retained start intent is not running; inspect before explicit recovery'\n354\t        tmp=$(mktemp \"$directory/.start.XXXXXX\")\n355\t        jq '.start_requested=true' \"$intent\" > \"$tmp\"\n356\t        sync -f \"$tmp\"; mv -T \"$tmp\" \"$intent\"; sync -f \"$directory\"\n357\t        start_args=$(jq -cn --arg name \"$SYSTEM_NAME\" '{name:$name}')\n358\t        started=$(incus_call start_instance \"$start_args\") || die 'start failed or outcome uncertain; inspect existing instance before retrying'\n359\t        jq -e --arg name \"$SYSTEM_NAME\" '.name==$name and .state==\"Running\"' <<<\"$started\" >/dev/null || die 'start receipt differs'\n360\t        verify_instance Running || die 'running instance readback differs'\n361\t    fi\n362\t    printf 'Standalone container %s: mounted Incus receipts and native state verified; grants unchanged.\\n' \"$SYSTEM_NAME\"\n363\t)\n364\t\n365\tif [[ $SYSTEM_MODE == true ]]; then\n366\t    if [[ $IMAGE_OVERRIDDEN == false ]]; then IMAGE=$SYSTEM_IMAGE; fi\n367\t    provision_system_container; exit 0\n368\tfi\n369\tdie 'legacy unpartitioned provisioning is retired; use --prepare-container --operation-id UUID, then the assigned-name storage/adoption stages'"}]}
