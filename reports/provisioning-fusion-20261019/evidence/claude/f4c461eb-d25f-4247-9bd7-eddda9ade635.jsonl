77\t    # Incus public_state deliberately omits names/config/devices; mounted\n78\t    # value.json cannot verify this private binding and no get/list is declared.\n79\t    # Keep the existing explicit host-maintenance observation. After a mutation\n80\t    # it runs only after invoke succeeds: never an admission-denial fallback.\n81\t    verify_control_mount\n82\t    instance=$(timeout --kill-after=5s 30s incus --force-local --project default query \"/1.0/instances/$name\") || fail 'bounded host-maintenance instance readback failed'\n83\t    verify_control_mount\n84\t    jq -e --arg name \"$name\" --arg sid \"$sid\" --arg key \"$key\" --arg uuid \"$native_uuid\" '\n85\t       .name==$name and .type==\"container\" and .status==\"Stopped\" and\n86\t       .status_code==102 and .config[\"user.opdbus.session_id\"]==$sid and\n87\t       .config[\"user.opdbus.wireguard_public_key\"]==$key and .config[\"volatile.uuid\"]==$uuid and\n88\t       .config[\"security.privileged\"]==\"false\" and .config[\"security.protection.shift\"]==\"true\" and\n89\t       .devices.root.pool==\"identity-roots\" and .profiles==[\"3tched-lungs\"] and\n90\t       (.devices|type)==\"object\" and (.expanded_devices|type)==\"object\"' <<<\"$instance\" >/dev/null || fail 'stopped container binding differs'\n91\t}\n92\tread_instance\n93\t# Canonical preparation creates the exact guest FUSE device. Do not\n94\t# route drift through generic mutations: the lifecycle guard intentionally\n95\t# denies pre-adoption device/config changes for identity candidates.\n96\tif [[ $name == ID-* || $name == 3tchedCtlChatbot ]]; then\n97\t    jq -e 'all(.devices,.expanded_devices;\n98\t        .fuse=={type:\"unix-char\",source:\"/dev/fuse\",path:\"/dev/fuse\"} and\n99\t        (has(\"3tchedfs\")|not) and (has(\"system-bus\")|not))' <<<\"$instance\" >/dev/null ||\n100\t        fail 'canonical device definition drifted; no device mutation fallback'\n101\tfi\n102\tidmap=$(jq -er '.config[\"volatile.idmap.current\"]' <<