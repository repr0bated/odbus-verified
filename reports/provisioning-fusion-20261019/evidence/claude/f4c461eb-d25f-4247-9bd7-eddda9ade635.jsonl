plit($4, options, \",\")\n130\t                if (n!=6) bad=1\n131\t                for (i=1; i<=n; i++) {\n132\t                    if (options[i] !~ /^(noauto|rw|nosuid|nodev|noexec|noatime)$/ || seen[options[i]]++) bad=1\n133\t                }\n134\t            }\n135\t            if (mode==\"filter\") print\n136\t        }\n137\t        END { if (bad || count!=1) exit 1 }\n138\t    ' \"$file\" || fail \"guest fstab must retain one supported FUSE entry and no active host storage: $file\"\n139\t}\n140\tguest_fstab filter \"$root/@/etc/fstab\" >/dev/null\n141\t# An upgrade fstab takes precedence over the sprout. Never edit the received\n142\t# upgrade baseline to hide drift; the merged view is checked again below.\n143\tif [[ -e $replica/@/etc/fstab || -L $replica/@/etc/fstab ]]; then\n144\t    guest_fstab verify \"$replica/@/etc/fstab\"\n145\tfi\n146\tfor member in memory rules shared skills soul user; do\n147\t    [[ -d $root/@/agent/$member && ! -L $root/@/agent/$member &&\n148\t       -d $root/@agent_$member && ! -L $root/@agent_$member ]] || fail 'missing ordinary mountpoint or sibling'\n149\t    btrfs subvolume show \"$root/@agent_$member\" >/dev/null\n150\tdone\n151\t# Keep the Incus empty-root scaffolding underneath the bind; never delete it.\n152\tfor backup in \"$pool/.provisioning/$name.before-root.json\" \"$pool/.provisioning/$name.fstab.before\"; do\n153\t    [[ ! -e $backup && ! -L $backup ]] || fail 'retained root backup requires reconciliation'\n154\tdone\n155\tprintf '%s\\n' \"$instance\" > \"$pool/.provisioning/$name.before-root.json\"\n156\tcp -a \"$root/@/etc/fstab\" \"$pool/.provisioning/$name.fstab.before\"\n157\tsync -f \"$pool/.provisioning/$name.fstab.before\"\n158\twork=$(mktemp -d \"$pool/.provisioning/$name.bind.XXXXXX\")\n159\tprintf 'Private root-binding evidence: %s\\n' \"$work\"\n160\tmutate_device() {\n161\t    local method=$1 device=$2 args=$3\n162\t    [[ $name != ID-* && $name != 3tchedCtlChatbot ]] || fail 'canonical candidate