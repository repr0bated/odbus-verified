{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-chat-profile/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "principal_id", "display_name", "deployment_targets"],
  "properties": {
    "format": { "type": "string", "const": "identity-chat-profile/1", "maxLength": 32 },
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "expected_session_id": { "type": "string", "maxLength": 128 },
    "session_mode": { "type": "string", "maxLength": 32 },
    "deployment_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "mount_paths"],
        "properties": {
          "kind": { "type": "string", "enum": ["identity_container", "host_dashboard"] },
          "mount_paths": {
            "type": "object",
            "additionalProperties": false,
            "required": ["3tched", "threetched"],
            "properties": {
              "3tched": { "type": "string", "maxLength": 256, "pattern": "^/" },
              "threetched": { "type": "string", "maxLength": 256, "pattern": "^/" }
            }
          }
        }
      }
    }
  }
}
