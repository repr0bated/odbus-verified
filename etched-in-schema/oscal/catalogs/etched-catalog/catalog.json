   {
    "id": "etched-ac-1",
    "title": "Least privilege with named refusals",
    "links": [
     {
      "href": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final",
      "rel": "reference",
      "text": "NIST SP 800-53 Rev 5, AC family (access control)"
     }
    ],
    "parts": [
     {
      "id": "etched-ac-1_smt",
      "name": "statement",
      "prose": "CMS roles compile into capability grants. Requests outside the grants are refused with the exact missing capability; root-level actions need two different human approvals."
     },
     {
      "id": "etched-ac-1_gdn",
      "name": "guidance",
      "prose": "CMS behaviour: profile compiles to grants and budgets; the team-chat adapter holds no grants and never calls plugins directly. Refusals and approval requests render as first-class results."
     },
     {
      "id": "etched-ac-1_asm",
      "name": "assessment",
      "prose": "Evidence: refusal receipt naming the missing capability and rule; approval record (1 of 2, 2 of 2). Proven: bridge refuses with exact capability name. Planned: two-person rule (elevation ticket is single-use today)."
     }
    ],
