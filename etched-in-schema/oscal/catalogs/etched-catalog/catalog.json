    "title": "Scheduled retention and expiry",
    "links": [
     {
      "href": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final",
      "rel": "reference",
      "text": "NIST SP 800-53 Rev 5, SI-12 (information handling and retention)"
     }
    ],
    "parts": [
     {
      "id": "etched-si-1_smt",
      "name": "statement",
      "prose": "Published CMS content carries a retention schedule; expiry archives or deletes on time, automatically."
     },
     {
      "id": "etched-si-1_gdn",
      "name": "guidance",
      "prose": "CMS behaviour: each publish sets expires_at; the scheduler runs the archive operation. No silent retention."
     },
     {
      "id": "etched-si-1_asm",
      "name": "assessment",
      "prose": "Evidence: scheduled-operation receipt (operation_id, event_hash) plus the archived artefact reference. Planned."
     }
