    "links": [
     {
      "href": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final",
      "rel": "reference",
      "text": "NIST SP 800-53 Rev 5, AU family (audit)"
     }
    ],
    "parts": [
     {
      "id": "etched-au-1_smt",
      "name": "statement",
      "prose": "Every CMS create, edit, and publish action is attributable: who did it, under what capability, and when."
     },
     {
      "id": "etched-au-1_gdn",
      "name": "guidance",
      "prose": "CMS behaviour: all mutations run through the subsidiary identity's 3tchedFS call files; the bridge checks the exact capability and commits via MutationEngine."
     },
     {
      "id": "etched-au-1_asm",
      "name": "assessment",
      "prose": "Evidence: receipt chain per action (required_capability, operation_id, event_id, event_hash, outcome). Proven: bridge issues these fields on every admitted call."
     }
