   {
    "id": "etched-in-1",
    "title": "Hash-anchored integrity",
    "links": [
     {
      "href": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final",
      "rel": "reference",
      "text": "NIST SP 800-53 Rev 5, SI-7 (information integrity)"
     }
    ],
    "parts": [
     {
      "id": "etched-in-1_smt",
      "name": "statement",
      "prose": "Published CMS versions are hash-anchored so anyone can verify what was published, by whom, and under what authority, without trusting the agent or operator."
     },
     {
      "id": "etched-in-1_gdn",
      "name": "guidance",
      "prose": "CMS behaviour: publish hashes the versioned artefact; the Web3 index entry references the authorising receipt (operation_id, event_hash); the Merkle root is anchored on-chain."
     },
     {
      "id": "etched-in-1_asm",
      "name": "assessment",
      "prose": "Evidence: index entry (schema/index-entry.schema.json) plus on-chain anchor a judge can check. Planned; receipt fields it cites are proven."
     }
    ],
