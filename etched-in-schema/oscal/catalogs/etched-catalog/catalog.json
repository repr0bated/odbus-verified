   {
    "id": "etched-pt-1",
    "title": "PII redaction on publish",
    "links": [
     {
      "href": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final",
      "rel": "reference",
      "text": "NIST SP 800-53 Rev 5, PT family (privacy)"
     }
    ],
    "parts": [
     {
      "id": "etched-pt-1_smt",
      "name": "statement",
      "prose": "The CMS redacts PII automatically on publish. The original is kept only in the owner's private scope; every other surface receives the redacted form."
     },
     {
      "id": "etched-pt-1_gdn",
      "name": "guidance",
      "prose": "CMS behaviour: publish path runs the redaction policy (name, email, phone) before rendering to web or team chat. A redaction notice names what was redacted and which policy did it."
     },
     {
      "id": "etched-pt-1_asm",
      "name": "assessment",
      "prose": "Evidence: redaction operation receipt naming the triggering policy (operation_id, event_hash). Planned: receipt recorded as OSCAL assessment result and anchored on-chain."
     }
    ],
