# THREETCHED_CONFIG_DIR=
# THREETCHED_CAPTURE_DIR=
# THREETCHED_TLS_CERT_FILE=/etc/op-dbus/tls/tonic-svc0.crt
# THREETCHED_TLS_KEY_FILE=/etc/op-dbus/tls/tonic-svc0.key
