# Existing base-chain policy remains authoritative; no parallel accept chain.
insert rule inet filter input tcp dport 2223 counter accept comment "op-warp-ssh/listener"
insert rule inet filter input iifname "masque-ssh" ip saddr { 10.0.0.0/24, 192.168.254.2, 192.168.255.2 } counter accept comment "op-warp-ssh/private-input"
