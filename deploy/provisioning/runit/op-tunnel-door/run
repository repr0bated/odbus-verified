#!/bin/sh
set -eu
exec 2>&1
control=/run/opdbus/tunnel/tunnel.sock
lungs=/run/opdbus/lungs/lungs.sock
[ -S "$lungs" ] || lungs=/run/mounts/opdbus/lungs/lungs.sock
if [ -S "$control" ]; then
  mountpoint -q /run/mounts/threetchedFS || { sleep 3; exit 1; }
  exec /usr/local/libexec/op-dbus/bin/op-tunnel-door --socket "$control" --door 10.0.0.2:8090
elif [ -r /agent/user/OP_UI_LISTEN ]; then
  IFS= read -r OP_UI_LISTEN </agent/user/OP_UI_LISTEN
  [ "$OP_UI_LISTEN" = 127.0.0.1:8443 ] || { echo 'UI door must remain 127.0.0.1:8443'; exit 1; }
  [ -S "$lungs" ] || { echo 'identity lungs unavailable'; exit 1; }
  exec /usr/local/libexec/op-dbus/bin/op-tunnel-door --lungs-socket "$lungs" --door 127.0.0.1:8443
fi
echo 'no tunnel device; idle'
exec sleep infinity
