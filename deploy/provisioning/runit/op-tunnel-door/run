#!/bin/sh
set -eu
exec 2>&1
control=/run/opdbus/tunnel/tunnel.sock
browser=/run/opdbus/tunnel-browser/browser.sock
# The LXD template need not have the Incus /run/opdbus tmpfiles symlink.
[ -S "$browser" ] || browser=/run/mounts/opdbus/tunnel-browser/browser.sock
if [ -S "$control" ]; then
  [ ! -S "$browser" ] || { echo 'conflicting tunnel devices'; exit 1; }
  mountpoint -q /run/mounts/threetchedFS || { sleep 3; exit 1; }
  exec /usr/local/libexec/op-dbus/bin/op-tunnel-door --socket "$control" --door 10.0.0.2:8090
elif [ -S "$browser" ]; then
  IFS= read -r OP_UI_LISTEN </agent/user/OP_UI_LISTEN
  exec /usr/local/libexec/op-dbus/bin/op-tunnel-door --socket "$browser" --door "${OP_UI_LISTEN:?}"
fi
echo 'no tunnel device; idle'
exec sleep infinity
