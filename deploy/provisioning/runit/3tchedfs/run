#!/bin/sh
# 3tchedFS view (surface 3tched) over the HOST lungs socket, catalog read-only.
exec 2>&1
B=/usr/local/libexec/op-dbus/bin/3tched-fs
CAT=/dev/shm/opdbus/plugin-blobs; ST=/dev/shm/opdbus/state; MP=/run/mounts/3tchedFS
[ -r "$CAT/.manifest.json" ] || { echo "catalog $CAT absent (catalog device missing?)"; sleep 10; exit 1; }
[ -S /run/opdbus/lungs/lungs.sock ] || { echo "host lungs socket absent (lungs device missing?)"; sleep 10; exit 1; }
install -d -m 0700 /run/3tchedfs-3tchedFS; install -d -m 0755 "$MP"
mountpoint -q "$MP" && fusermount3 -u "$MP" 2>/dev/null || true
"$B" capture --store /run/3tchedfs-3tchedFS --schema-only --catalog "$CAT" --state "$ST" --exclude-plugin threetched || { sleep 5; exit 1; }
exec "$B" mount --store /run/3tchedfs-3tchedFS --fs-name 3tchedFS --surface 3tched --catalog "$CAT" --state "$ST" \
  --allow-other --auto-unmount --lungs-socket /run/opdbus/lungs/lungs.sock "$MP"
