[Unit]
Description=Xray router (3tched/op-dbus)
After=network-pre.target
Before=network.target

[Service]
Type=simple
# eth0 is the OVS uplink and carries no address. Tonic 10.0.0.2 is on rtly-lungs.
ExecStart=/usr/local/bin/xray run -config /dev/shm/xray_config.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
