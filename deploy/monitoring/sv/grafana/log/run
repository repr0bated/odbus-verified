#!/bin/sh
exec 2>&1
logdir=/var/log/monitoring/grafana
u=svlog
id -u "$u" >/dev/null 2>&1 || u=_runit-log
g=$(id -gn "$u")
install -d -m 0755 /var/log/monitoring
install -d -m 0700 -o "$u" -g "$g" "$logdir"
printf '%s\n' 's4000000' 'n10' 't86400' >"$logdir/config"
chown "$u:$g" "$logdir/config"
exec chpst -u "$u" svlogd -tt "$logdir"
