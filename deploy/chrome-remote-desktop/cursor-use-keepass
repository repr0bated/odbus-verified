#!/bin/sh
#
# Point Cursor's Electron safeStorage at KeePassXC for the Chrome Remote
# Desktop Plasma session.
#
# On KDE, Cursor otherwise selects KWallet. Inside this session that store is
# ksecretd, so the login key never lands in KeePass. gnome-libsecret talks to
# org.freedesktop.secrets. This script makes KeePassXC that provider and
# stops ksecretd from claiming the name on the next login.
#
# Usage: cursor-use-keepass <home> <user> <group>
# The database group KeePassXC exposes is stored inside the kdbx. This script
# does not open the database and does not migrate existing KWallet entries.

set -eu

if [ "$#" -ne 3 ]; then
    echo "usage: ${0##*/} <home> <user> <group>" >&2
    exit 2
fi

CRD_HOME=$1
CRD_USER=$2
CRD_GROUP=$3

# Never follow a desktop user's paths with the launcher's root privileges.
if [ "$(id -u)" -eq 0 ] || [ "$(id -u)" != "$(id -u "$CRD_USER")" ] ||
   [ "$(id -gn)" != "$CRD_GROUP" ]; then
    echo "cursor-use-keepass: run as the desktop user and group, never root" >&2
    exit 1
fi

if [ ! -d "$CRD_HOME" ]; then
    echo "cursor-use-keepass: no home directory: $CRD_HOME" >&2
    exit 1
fi

KEEPASSXC=$(command -v keepassxc || true)
if [ -z "$KEEPASSXC" ]; then
    echo "cursor-use-keepass: keepassxc is not installed; Cursor stays on the desktop default" >&2
    exit 0
fi

ensure_dir() {
    mkdir -p "$1"
}

# Set KEY=VALUE inside [SECTION], preserving every other line.
ini_set() {
    file=$1
    section=$2
    key=$3
    value=$4
    ensure_dir "$(dirname "$file")"
    if [ ! -f "$file" ]; then
        printf '[%s]\n%s=%s\n' "$section" "$key" "$value" > "$file"
        return
    fi
    tmp=$(mktemp "${file}.XXXXXX")
    awk -v section="$section" -v key="$key" -v value="$value" '
        BEGIN { in_section = 0; found = 0; wrote = 0 }
        {
            line = $0
            if (line ~ /^\[/) {
                if (in_section && !wrote) {
                    print key "=" value
                    wrote = 1
                }
                name = line
                sub(/^\[/, "", name)
                sub(/\].*$/, "", name)
                gsub(/^[ \t]+|[ \t]+$/, "", name)
                in_section = (name == section)
                if (in_section) found = 1
            }
            if (in_section) {
                keyline = line
                sub(/^[ \t]+/, "", keyline)
                split_key = keyline
                sub(/[ \t]*=.*/, "", split_key)
                if (split_key == key) {
                    print key "=" value
                    wrote = 1
                    next
                }
            }
            print
        }
        END {
            if (!found) {
                print ""
                print "[" section "]"
                print key "=" value
            } else if (!wrote) {
                print key "=" value
            }
        }
    ' "$file" > "$tmp"
    mv "$tmp" "$file"
}

set_cursor_password_store() {
    file=$1
    ensure_dir "$(dirname "$file")"
    if [ ! -f "$file" ]; then
        cat > "$file" <<'EOF'
// gnome-libsecret: Cursor safeStorage uses org.freedesktop.secrets (KeePassXC).
{
	"password-store": "gnome-libsecret"
}
EOF
        return
    fi
    tmp=$(mktemp "${file}.XXXXXX")
    # Tokenize JSONC before editing: braces and keys inside comments or strings
    # are data. Preserve the file and comments, changing only a top-level value.
    if ! awk '
        function fail() {
            print "cursor-use-keepass: unsupported or malformed argv.json; left unchanged" > "/dev/stderr"
            exit 1
        }
        { text = text $0 "\n" }
        END {
            phase = "key"
            for (i = 1; i <= length(text); i++) {
                c = substr(text, i, 1)
                pair = substr(text, i, 2)
                if (pair == "//" || pair == "/*") {
                    start = i
                    if (pair == "//") {
                        while (i <= length(text) && substr(text, i, 1) != "\n") i++
                    } else {
                        i += 2
                        while (i <= length(text) && substr(text, i, 2) != "*/") i++
                        if (i > length(text)) fail()
                        i++
                    }
                    out = out substr(text, start, i - start + 1)
                    continue
                }
                if (c == "\"") {
                    start = i++
                    while (i <= length(text)) {
                        c = substr(text, i, 1)
                        if (c == "\\") i += 2
                        else if (c == "\"") break
                        else if (c == "\n") fail()
                        else i++
                    }
                    if (i > length(text)) fail()
                    token = substr(text, start, i - start + 1)
                    if (depth == 1 && phase == "key") {
                        # Escaped keys need JSON decoding; fail without rewriting
                        # rather than introducing a duplicate equivalent key.
                        if (index(token, "\\")) fail()
                        key = token
                        properties++
                        phase = "colon"
                    } else if (depth == 1 && phase == "value") {
                        if (key == "\"password-store\"") {
                            token = "\"gnome-libsecret\""
                            found = 1
                        }
                        phase = "comma"
                    } else if (depth <= 1) fail()
                    out = out token
                    continue
                }
                if (c ~ /[ \t\r\n]/) { out = out c; continue }
                if (c == "{" || c == "[") {
                    if (!depth) {
                        if (root || c != "{") fail()
                        root = length(out) + 1
                    } else if (depth == 1) {
                        if (phase != "value" || key == "\"password-store\"") fail()
                        phase = "comma"
                    }
                    closes[++depth] = (c == "{" ? "}" : "]")
                } else if (c == "}" || c == "]") {
                    if (!depth || c != closes[depth]) fail()
                    if (depth == 1 && phase != "key" && phase != "comma") fail()
                    depth--
                } else if (depth == 1 && c == ":" && phase == "colon") {
                    phase = "value"
                } else if (depth == 1 && c == "," && phase == "comma") {
                    phase = "key"
                } else if (depth == 1 && phase == "value") {
                    if (key == "\"password-store\"") fail()
                    start = i
                    while (i <= length(text) && substr(text, i, 1) ~ /[A-Za-z0-9.+-]/) i++
                    token = substr(text, start, i - start)
                    if (token !~ /^(true|false|null|-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?)$/) fail()
                    i--
                    out = out token
                    phase = "comma"
                    continue
                } else if (depth <= 1) fail()
                out = out c
            }
            if (!root || depth) fail()
            if (!found) {
                out = substr(out, 1, root) "\n\t\"password-store\": \"gnome-libsecret\"" \
                    (properties ? "," : "") substr(out, root + 1)
            }
            printf "%s", out
        }
    ' "$file" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$file"
}

set_cursor_password_store "$CRD_HOME/.cursor/argv.json"

# Plasma 6: kwalletd stays as the KWallet API proxy. ksecretd must not own
# org.freedesktop.secrets, or KeePassXC will refuse the integration.
ini_set "$CRD_HOME/.config/kwalletrc" KSecretD Enabled false

# KeePassXC reads FdoSecrets/Enabled from the roaming config. The exposed
# group itself stays in the database.
ini_set "$CRD_HOME/.config/keepassxc/keepassxc.ini" FdoSecrets Enabled true
ini_set "$CRD_HOME/.config/keepassxc/keepassxc.ini" GUI LaunchAtStartup true

ensure_dir "$CRD_HOME/.local/share/dbus-1/services"
cat > "$CRD_HOME/.local/share/dbus-1/services/org.freedesktop.secrets.service" <<EOF
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=$KEEPASSXC
EOF

ensure_dir "$CRD_HOME/.config/autostart"
cat > "$CRD_HOME/.config/autostart/org.keepassxc.KeePassXC.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=KeePassXC
Comment=Secret service for this Plasma session
Exec=$KEEPASSXC
TryExec=$KEEPASSXC
Terminal=false
StartupNotify=false
X-GNOME-Autostart-enabled=true
EOF

echo "cursor-use-keepass: Cursor will use KeePassXC ($KEEPASSXC) on the next login" >&2
