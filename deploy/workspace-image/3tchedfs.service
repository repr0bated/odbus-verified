[Unit]
Description=3tchedFS sealed plugin mount for this identity
After=local-fs.target systemd-tmpfiles-setup.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/local/libexec/3tched/3tchedfs-mount-preflight
ExecStart=/usr/local/bin/threetched-fs --store /usr/share/op-dbus/lungs-view mount --state /usr/share/op-dbus/lungs-empty-state --catalog /usr/share/op-dbus/lungs-catalog --lungs-socket /run/opdbus/lungs/lungs.sock --allow-other --auto-unmount /run/mount/3tchedFS
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
