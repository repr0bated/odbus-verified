#!/bin/sh
# Human identity 3tchedFS: production store, single bridge lungs socket.
exec 2>&1

wait_dep() {
    sv start "$1" >/dev/null 2>&1 || true
    i=0
    until sv check "$1" >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -ge 90 ] && { echo "dependency $1 not ready after 90s" >&2; exit 1; }
        sleep 1
    done
}

THREETCHED=/opt/op-dbus/current/bin/threetched-fs
RUNIT_READY=/usr/local/libexec/3tched/runit-ready-signal
[ -x "$THREETCHED" ] || THREETCHED=/usr/local/sbin/threetched-fs
[ -x "$RUNIT_READY" ] || RUNIT_READY=/usr/local/libexec/3tched/runit-ready-signal

session_file=/etc/op-dbus/human-lungs-session
[ -r "$session_file" ] || { echo "missing $session_file" >&2; exit 1; }
session=$(tr -d '[:space:]' <"$session_file")
case "$session" in
    ????????-????-????-????-????????????) ;;
    *) echo "invalid human lungs session in $session_file" >&2; exit 1 ;;
esac

mountpoint=/run/mount/3tchedFS
store=/dev/shm/3tchedfs
catalog=/dev/shm/opdbus/plugin-blobs
state=/dev/shm/opdbus/state
lungs=/run/opdbus/lungs/lungs.sock

wait_dep opdbus-rundirs
wait_dep op-session-bus
wait_dep op-grpc-bridge

i=0
until [ -S "$lungs" ]; do
    i=$((i + 1))
    [ "$i" -ge 90 ] && { echo "$lungs not ready after 90s" >&2; exit 1; }
    sleep 1
done

install -d -m 0755 "$mountpoint"

i=0
until [ -n "$(ls -A "$catalog" 2>/dev/null)" ] && [ -n "$(ls -A "$state" 2>/dev/null)" ]; do
    i=$((i + 1))
    [ "$i" -ge 90 ] && { echo "blob catalog or state dir still empty after 90s" >&2; exit 1; }
    sleep 1
done

"$THREETCHED" --store "$store" capture --catalog "$catalog" --state "$state" >/dev/null

"$RUNIT_READY" threetched-fs
exec "$THREETCHED" --store "$store" mount \
    --allow-other \
    --auto-unmount \
    --state "$state" \
    --lungs-socket "$lungs" \
    --lungs-session "$session" \
    "$mountpoint"
