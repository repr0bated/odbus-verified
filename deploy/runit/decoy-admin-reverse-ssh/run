#!/bin/sh
# Internal reverse endpoint:
# decoy 127.0.0.1:2222 -> this host 127.0.0.1:22.
# The decoy's op-main-ssh-wg.socket publishes that endpoint only on
# 10.0.0.1%wg0:2222. It replaces Netmaker for administration and never
# establishes OIA1 application identity.
exec 2>&1

# A previous tunnel can keep 127.0.0.1:2222 after this host reboots.
# Until that listen is gone, ExitOnForwardFailure makes runit crash-loop.
chpst -u jeremy:jeremy /usr/bin/ssh \
  -i /home/jeremy/.ssh/vps_key \
  -o BatchMode=yes \
  -o ConnectTimeout=10 \
  -o StrictHostKeyChecking=yes \
  ubuntu@129.80.64.127 \
  'line=$(sudo ss -H -tlnp src 127.0.0.1 sport = :2222 2>/dev/null || true); pid=$(printf "%s\n" "$line" | sed -n "s/.*pid=\([0-9][0-9]*\).*/\1/p" | head -n 1); if [ -n "$pid" ]; then comm=$(ps -o comm= -p "$pid" 2>/dev/null || true); case "$comm" in sshd) kill "$pid" || sudo kill "$pid";; esac; fi' \
  || true
sleep 1

exec chpst -u jeremy:jeremy /usr/bin/ssh -NT \
  -i /home/jeremy/.ssh/vps_key \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -R 127.0.0.1:2222:127.0.0.1:22 \
  ubuntu@129.80.64.127
