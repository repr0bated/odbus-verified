#!/bin/sh
# op-dbus-release: application
set -eu
exec 2>&1

i=0
until sv check dbus >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 90 ] || { echo 'unified-execution: system bus not ready' >&2; exit 1; }
    sleep 1
done
id jeremy >/dev/null 2>&1 || { echo 'unified-execution: jeremy user missing' >&2; exit 78; }
exec chpst -u jeremy:jeremy env HOME=/home/jeremy USER=jeremy \
    PATH=/opt/op-dbus/execution-python/bin:/usr/local/libexec/op-dbus/bin:/home/jeremy/.cargo/bin:/home/jeremy/.local/bin:/usr/local/bin:/usr/bin:/bin \
    CXXFLAGS="-include cstdint" /usr/local/libexec/op-dbus/bin/dbus-agent --system --unified-execution
