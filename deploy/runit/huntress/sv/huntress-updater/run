#!/bin/sh
# runit translation of the huntress-updater.service unit that `huntress-updater install` would write
# (Type=simple, User=root, WorkingDirectory=-/run/huntress, Restart=always).
# On non-systemd hosts Huntress's service library (kardianos/service) falls back
# to SysV and controls the service via `service huntress-updater start|stop|status`, so this
# script keeps /etc/init.d/huntress-updater pointed at the sv-backed wrapper.
exec 2>&1
BIN=/usr/share/huntress/huntress-updater
SV=/etc/sv/huntress-updater
# ConditionFileIsExecutable: idle instead of spinning when uninstalled.
if [ ! -x "$BIN" ]; then echo "$BIN missing; idle"; sleep 300; exit 0; fi
cmp -s "$SV/initd" /etc/init.d/huntress-updater 2>/dev/null || install -m 0755 "$SV/initd" /etc/init.d/huntress-updater
# An update may have reinstalled the stock SysV script and started an
# unsupervised copy; stop it so only the supervised one runs.
P=/var/run/huntress-updater.pid
if [ -f "$P" ]; then
	pid=$(cat "$P" 2>/dev/null)
	case "$(readlink "/proc/$pid/exe" 2>/dev/null)" in
	"$BIN"*) echo "stopping unsupervised huntress-updater pid $pid"; kill "$pid"
		i=0; while [ -d "/proc/$pid" ] && [ "$i" -lt 15 ]; do sleep 1; i=$((i + 1)); done ;;
	esac
	rm -f "$P"
fi
install -d -m 0755 /run/huntress
cd /run/huntress || cd /
# Opted in to the private systemd1-compat bus (go-systemd health checks of
# huntress-* units); see deploy/runit/systemd1-compat/README.md.
W=/usr/local/libexec/systemd1-compat/with-bus
[ -x "$W" ] && [ -d "$SV/env" ] && exec "$W" "$SV/env" "$BIN"
exec "$BIN"
