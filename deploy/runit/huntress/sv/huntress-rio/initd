#!/bin/sh
### BEGIN INIT INFO
# Provides:          huntress-rio
# Required-Start:
# Required-Stop:
# Default-Start:
# Default-Stop:
# Short-Description: Huntress service control mapped to runit sv
### END INIT INFO
# huntress-runit-initd: kardianos/service (SysV mode) calls
# `service <name> start|stop|restart|status`; map that to runit. Status output
# must start with Running/Stopped (that is what kardianos parses).
name=$(basename "$(readlink -f "$0")")
svc=/etc/service/$name
case "$1" in
start) sv -w 15 start "$svc" >/dev/null 2>&1; echo "Starting $name" ;;
stop) sv -w 15 stop "$svc" >/dev/null 2>&1; echo "Stopped" ;;
restart | force-reload) sv -w 15 restart "$svc" >/dev/null 2>&1; echo "Starting $name" ;;
status)
	if sv status "$svc" 2>/dev/null | grep -q '^run:'; then echo "Running"; else echo "Stopped"; exit 1; fi ;;
*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
