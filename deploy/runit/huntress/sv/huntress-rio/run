#!/bin/sh
# runit translation of the huntress-rio service (Rio EDR, eBPF) that the
# Huntress updater installs. On this host kardianos/service picks SysV, so the
# updater writes /etc/init.d/huntress-rio (cwd /run/huntress/rio, no args) and
# starts an unsupervised copy; this script swaps in the sv-backed wrapper,
# stops that copy, and runs Rio under runit.
exec 2>&1
BIN=/usr/share/huntress/rio/rio
SV=/etc/sv/huntress-rio
if [ ! -x "$BIN" ]; then echo "$BIN missing; idle"; sleep 300; exit 0; fi
cmp -s "$SV/initd" /etc/init.d/huntress-rio 2>/dev/null || install -m 0755 "$SV/initd" /etc/init.d/huntress-rio
P=/var/run/huntress-rio.pid
if [ -f "$P" ]; then
	pid=$(cat "$P" 2>/dev/null)
	case "$(readlink "/proc/$pid/exe" 2>/dev/null)" in
	"$BIN"*) echo "stopping unsupervised huntress-rio pid $pid"; kill "$pid"
		i=0; while [ -d "/proc/$pid" ] && [ "$i" -lt 15 ]; do sleep 1; i=$((i + 1)); done ;;
	esac
	rm -f "$P"
fi
install -d -m 0700 /run/huntress/rio
cd /run/huntress/rio || exit 1
# Opted in to the private systemd1-compat bus (go-systemd health checks of
# huntress-* units); see deploy/runit/systemd1-compat/README.md.
W=/usr/local/libexec/systemd1-compat/with-bus
[ -x "$W" ] && [ -d "$SV/env" ] && exec "$W" "$SV/env" "$BIN"
exec "$BIN"
