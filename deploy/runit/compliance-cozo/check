#!/bin/sh
# The API must answer on loopback. A live process without /api/health is not ready.
set -eu
status=$(curl --noproxy '*' --silent --show-error \
    --connect-timeout 1 --max-time 3 \
    --output /dev/null --write-out '%{http_code}' \
    http://127.0.0.1:8787/api/health) || exit 1
[ "$status" = 200 ]
