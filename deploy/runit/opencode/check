#!/bin/sh
set -eu
RUNTIME=/etc/op-dbus/opencode-runtime.json
port=$(jq -er '.port | select(type == "number" and floor == .)' "$RUNTIME")
username=$(jq -er '.username' "$RUNTIME")
password_file=$(jq -er '.password_file' "$RUNTIME")
version=$(jq -er '.version' "$RUNTIME")
[ -f "$password_file" ] || exit 1
password=$(cat "$password_file")
health=$(printf 'user = "%s:%s"\n' "$username" "$password" | \
    curl --fail --silent --show-error --max-time 2 --config - \
        "http://127.0.0.1:$port/global/health") || exit 1
printf '%s' "$health" | jq -e --arg version "$version" \
    '.healthy == true and .version == $version' >/dev/null
