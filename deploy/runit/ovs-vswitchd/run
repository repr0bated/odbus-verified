#!/bin/sh
# ovs-vswitchd — seeds the topology, then starts the datapath.
#
# 2026-10 rebuild: op-ovsbr0-setup --seed-only writes ovsbr0 + the enslaved
# physical uplink + pub0 into OVSDB in ONE transaction, run from here, right
# before vswitchd starts. vswitchd's first read of OVSDB then sees the
# finished topology and brings the datapath up once — no second service,
# no boot race. This replaces the old ovsbr0-seed / setup-ovsbr0-atomic.sh /
# setup-ovs-bridge-native.sh scripts (three competing, none actually wired
# in) and the ovsbr0-uplink/-eth0 chain. See deploy/config/network.conf for
# the current topology (no tun port, no "3tched" port — only pub0 + the
# bridge's own MQTT alias, applied later by ovsbr0-cutover).
#
# Topology changes still go through this one seed step, not hand edits to
# conf.db and not a shell repair step bolted onto this script.
exec 2>&1
wait_dep() {
    sv start "$1" >/dev/null 2>&1 || true
    i=0
    until sv check "$1" >/dev/null 2>&1; do
        i=$((i+1))
        [ "$i" -ge 90 ] && { echo "dependency $1 not ready after 90s" >&2; exit 1; }
        sleep 1
    done
}
wait_dep ovsdb-server
wait_dep uplink-dhcp

modprobe openvswitch 2>/dev/null || true
set -a; [ -r /etc/op-dbus/network.conf ] && . /etc/op-dbus/network.conf; set +a
export OVSDB_SOCKET="${OVSDB_SOCKET:-/run/openvswitch/db.sock}"
export BRIDGE="${BRIDGE:-ovsbr0}"
export UPLINK="${UPLINK_PHYS:-eth0}"
export PUBLIC_PORT="${PUBLIC_PORT:-pub0}"
export INTERNAL_PORTS="${INTERNAL_PORTS:-}"
export FAIL_MODE="${FAIL_MODE:-standalone}"

/usr/local/bin/op-ovsbr0-setup --seed-only \
    || { echo "ovs-vswitchd: op-ovsbr0-setup --seed-only failed — refusing to start vswitchd blind" >&2; exit 1; }

/usr/local/libexec/3tched/runit-ready-signal ovs-vswitchd
exec ovs-vswitchd "unix:${OVSDB_SOCKET}"
