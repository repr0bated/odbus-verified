#!/bin/sh
# op-dbus-release: application
# Release activation persists this catalog; our opblob stage-shm publishes it.
# This declaration connects the implicit compiled staging input to its owner.
# op-dbus-consumes: /usr/share/op-dbus/plugin-blobs
exec 2>&1
wait_dep() {
    sv start "$1" >/dev/null 2>&1 || true
    i=0
    until sv check "$1" >/dev/null 2>&1; do
        i=$((i+1))
        [ "$i" -ge 90 ] && { echo "dependency $1 not ready after 90s" >&2; exit 1; }
        sleep 1
    done
}
/usr/local/libexec/op-dbus/helpers/opdbus-rundirs-up
[ ! -L /run/opdbus/lungs ] || { echo "lungs directory must not be a symlink" >&2; exit 1; }
if [ -e /run/opdbus/lungs ]; then
    [ -d /run/opdbus/lungs ] && [ "$(stat -c '%u:%a' /run/opdbus/lungs)" = 0:755 ] || {
        echo "existing lungs directory ownership or mode conflicts" >&2; exit 1;
    }
fi
install -d -o root -g root -m 0755 /run/opdbus/lungs
[ "$(realpath -e /run/opdbus/lungs)" = /run/opdbus/lungs ] &&
    [ "$(stat -c '%u:%a' /run/opdbus/lungs)" = 0:755 ] || {
    echo "unsafe dedicated lungs directory" >&2; exit 1;
}
install -d -m 0755 /run/opdbus/runit-ready
touch /run/opdbus/runit-ready/opdbus-rundirs
exec sleep infinity
