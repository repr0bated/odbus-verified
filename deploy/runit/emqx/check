#!/bin/sh
set -eu
# runit's check runner may close stdout; awk still closes its output at exit.
exec >/dev/null
ss -H -lnt 2>/dev/null | awk '
    $4 == "127.0.0.1:1883" { mqtt = 1 }
    $4 == "127.0.0.1:18083" { api = 1 }
    $4 == "127.0.0.1:8085" { wake = 1 }
    END { exit(mqtt && api && wake ? 0 : 1) }
'
install -d -m 0755 /run/opdbus/runit-ready
touch /run/opdbus/runit-ready/emqx
