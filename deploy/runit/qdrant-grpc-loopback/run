#!/bin/sh
set -eu

# Qdrant is reached over TCP only. The retired /var/lib/opdbus-runtime sockets
# are no longer used; the qdrant-recovered proxy binds 127.0.0.1:6333/6334.
# This service only keeps the supervised readiness signal for the gRPC port.
exec 2>&1

HOST=${QDRANT_GRPC_HOST:-127.0.0.1}
PORT=${QDRANT_GRPC_PORT:-6334}

until (exec 3<>"/dev/tcp/${HOST}/${PORT}") 2>/dev/null; do
    echo "qdrant-grpc-loopback: waiting for ${HOST}:${PORT}"
    sleep 2
done

echo "qdrant-grpc-loopback: ${HOST}:${PORT} reachable"
while sleep 30; do
    (exec 3<>"/dev/tcp/${HOST}/${PORT}") 2>/dev/null || echo "qdrant-grpc-loopback: ${HOST}:${PORT} unreachable"
done
