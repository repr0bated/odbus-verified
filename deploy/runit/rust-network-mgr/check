#!/bin/sh
# Readiness: process up, lungs socket present, local HTTP control answering.
set -eu
[ -f /run/opdbus/runit-ready/rust-network-mgr ] || exit 1
sv check op-grpc-bridge >/dev/null 2>&1 || exit 1
[ -S /run/opdbus/lungs/lungs.sock ] || [ -S /run/3tched-lungs.socket ] || exit 1
curl -fsS --max-time 1 http://127.0.0.1:9100/health >/dev/null
