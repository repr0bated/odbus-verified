#!/bin/sh
exec 2>&1
# The Devuan openvswitch-switch package owns and monitors both OVS daemons.
# This runit dependency observes that owner; stopping it must not stop OVS,
# change its database, or rerun the retired uplink/topology bootstrap chain.
set -eu
pidfile=/run/openvswitch/ovsdb-server.pid
[ -f "$pidfile" ] && [ ! -L "$pidfile" ] || exit 1
pid=$(cat "$pidfile")
case "$pid" in ''|*[!0-9]*) exit 1 ;; esac
[ "$(readlink -f "/proc/$pid/exe")" = /usr/sbin/ovsdb-server ] || exit 1
[ -S /run/openvswitch/db.sock ] || exit 1
# pidwait uses pidfd notification rather than polling. If the package monitor
# replaces the daemon, runit starts a new observer for its new PID.
exec /usr/bin/pidwait -F "$pidfile"
