#!/bin/sh
# Private dbus-daemon for the systemd1-compat responder. Not the system bus.
exec 2>&1
d=/run/systemd1-compat
g=root; mode=0700
# Optional: grant a group socket access (also add a bus.d policy for it).
if [ -s /etc/systemd1-compat/socket-group ]; then
	g=$(head -n1 /etc/systemd1-compat/socket-group); mode=0750
fi
install -d -o root -g "$g" -m "$mode" "$d"
chgrp "$g" "$d"; chmod "$mode" "$d"
rm -f "$d/system_bus_socket"
exec dbus-daemon --nofork --nopidfile --nosyslog --config-file=/etc/systemd1-compat/bus.conf
