#!/bin/sh
# Read-only org.freedesktop.systemd1 responder, on the private bus only.
exec 2>&1
sock=/run/systemd1-compat/system_bus_socket
[ -S "$sock" ] || { echo "waiting for $sock"; sleep 2; exit 1; }
export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$sock"
exec /usr/local/libexec/systemd1-compat/systemd1-compat-shim
