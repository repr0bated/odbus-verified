#!/bin/sh
# Usage (last line of a runit run script):
#   exec /usr/local/libexec/systemd1-compat/with-bus <envdir> <program> [args...]
# <envdir>/DBUS_SYSTEM_BUS_ADDRESS opts the program in to the systemd1-compat
# bus. Waits up to 15s for the socket, then execs via `chpst -e` either way
# (a missing bus must not keep the program from running).
envdir=$1; shift
addr=$(head -n1 "$envdir/DBUS_SYSTEM_BUS_ADDRESS" 2>/dev/null)
sock=${addr#unix:path=}
i=0
while [ -n "$sock" ] && [ ! -S "$sock" ] && [ "$i" -lt 15 ]; do sleep 1; i=$((i + 1)); done
[ -S "$sock" ] || echo "systemd1-compat: $sock not ready; starting anyway" >&2
exec chpst -e "$envdir" "$@"
