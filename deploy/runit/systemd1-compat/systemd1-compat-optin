#!/bin/sh
# systemd1-compat-optin <runit-service> [unit ...]
# Opts /etc/sv/<runit-service> in to the private systemd1-compat bus and adds
# the given units (e.g. foo.service or "foo.service othersvc") to the allowlist.
# Then make the service's run script end with:
#   exec /usr/local/libexec/systemd1-compat/with-bus /etc/sv/<svc>/env <program>
set -eu
[ $# -ge 1 ] || { echo "usage: $0 <runit-service> [unit ...]" >&2; exit 2; }
svc=$1; shift
[ -d "/etc/sv/$svc" ] || { echo "no /etc/sv/$svc" >&2; exit 1; }
install -d -m 0755 "/etc/sv/$svc/env"
echo "unix:path=/run/systemd1-compat/system_bus_socket" >"/etc/sv/$svc/env/DBUS_SYSTEM_BUS_ADDRESS"
for u in "$@"; do
	grep -qE "^${u%% *}([[:space:]]|\$)" /etc/systemd1-compat/units 2>/dev/null || echo "$u" >>/etc/systemd1-compat/units
done
echo "opted in: /etc/sv/$svc/env/DBUS_SYSTEM_BUS_ADDRESS"
grep -q "systemd1-compat/with-bus" "/etc/sv/$svc/run" ||
	echo "NOTE: run script does not use with-bus yet: exec /usr/local/libexec/systemd1-compat/with-bus /etc/sv/$svc/env <program>"
