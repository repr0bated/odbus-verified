#!/bin/sh
# Readiness requires the application endpoint and the authenticated TLS door,
# not just a process, a pre-exec marker, or an unrelated listener on this port.
set -eu
[ -f /run/opdbus/runit-ready/op-web ] || exit 1

set -a
[ -r /etc/op-dbus/environment ] && . /etc/op-dbus/environment
set +a
PORT="${PORT:-8080}"

sv check op-grpc-bridge >/dev/null 2>&1 || exit 1

# Match every configured HTTP bind, including IPv6 literals. Never consult an
# egress proxy when checking the local application endpoint.
set -f
IFS=', 	
'
for address in ${OP_WEB_BIND_ADDR:-10.0.0.2}; do
    case "$address" in
        *:*) address="[$address]" ;;
    esac
    status=$(curl --noproxy '*' --silent --show-error \
        --connect-timeout 1 --max-time 3 \
        --output /dev/null --write-out '%{http_code}' \
        "http://$address:$PORT/api/health") || exit 1
    [ "$status" = 200 ] || exit 1
done
