#!/bin/sh
set -eu
exec 2>&1
object=/usr/local/libexec/op-dbus/bpf/browser_ingress.bpf.o
loader=/usr/local/libexec/op-dbus/bin/browser-ingress-bpf
cgroup=/sys/fs/cgroup
pins=/sys/fs/bpf/opdbus/browser-ingress
[ -r "$object" ]
[ -x "$loader" ]
[ -d "$cgroup" ]
# Pinned maps need bpffs; this host does not mount it at boot.
mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf
install -d -m 0700 /sys/fs/bpf/opdbus "$pins"
exec "$loader" "$object" "$cgroup" "$pins"
