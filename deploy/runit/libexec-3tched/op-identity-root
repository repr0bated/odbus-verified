        .version == 1 and .name == $name and .phase == "ready" and
        (keys | sort) == (["version","name","session","phase","seed_fsid","seed_generation","leaf","leaf_inode","leaf_size","sprout_fsid","instance_uuid","root","seed_loop","leaf_loop","boot_id"] | sort)
