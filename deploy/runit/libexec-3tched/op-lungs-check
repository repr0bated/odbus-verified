#!/bin/sh
# op-lungs-check — prove an identity breathes through its lungs (OD-86).
# Installed by the release at /usr/local/libexec/3tched/op-lungs-check.
# Read-only apart from the calls it makes, which the chain records.
#
# Checks each link in order and stops at the first that fails:
#   1) the bridge serves the shared lungs socket,
#   2) its lungs are mounted, in socket mode,
#   3) its container is running,
#   4) a call written from inside the identity comes back with a result,
#   5) the chain records that call under the identity's session.
#
# The test call is any method the identity is granted (LUNGS_CHECK_CALL, with
# LUNGS_CHECK_ARGS as its JSON input, default {}). Step 5 reads the durable
# chain blocks as host root, so the identity needs no chain-wide read grant.
#
# Usage:
#   sudo LUNGS_CHECK_CALL=plugin.method op-lungs-check [<session>]
#                                     # default session: the control-plane chatbot
set -u

SESSION=${1:-${OP_CONTROL_PLANE_CHATBOT_SESSION_ID:-b0c777e3-0955-cd8b-3d01-ca12998cae28}}
LUNGS_SOCKET=${LUNGS_SOCKET:-/run/opdbus/lungs.sock}
LUNGS_RUN=${LUNGS_RUN:-/run/opdbus-lungs}
TIMING=${OPDBUS_SNOWBALL_PATH:-/var/lib/opdbus/snowball}/timing
LUNGS_CHECK_CALL=${LUNGS_CHECK_CALL:?set LUNGS_CHECK_CALL=plugin.method to a method this identity is granted}
LUNGS_CHECK_ARGS=${LUNGS_CHECK_ARGS:-\{\}}

pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; exit 1; }

printf '%s' "$SESSION" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' ||
    fail "'$SESSION' is not a session id"
printf 'identity %s\n' "$SESSION"

socket=$LUNGS_SOCKET
[ -S "$socket" ] || fail "bridge lungs socket $socket is missing (bridge release?)"
pass "bridge serves the shared lungs socket $socket"

mountpoint -q "$LUNGS_RUN/$SESSION" || fail "lungs are not mounted at $LUNGS_RUN/$SESSION (op-identity-root up $SESSION)"
socket_mode=0
for cmdline in /proc/[0-9]*/cmdline; do
    tr '\0' ' ' <"$cmdline" 2>/dev/null | grep -q -- "--lungs-socket $socket --lungs-session $SESSION" && socket_mode=1 && break
done
[ "$socket_mode" -eq 1 ] || fail "lungs are mounted but not over the socket (still --lungs-credential?)"
pass "lungs mounted over the socket"

incus list "$SESSION" -c s -f csv 2>/dev/null | grep -q '^RUNNING$' || fail "container $SESSION is not running"
pass "container running"

# Write from inside the identity, as the identity would. The error file is
# cleared on success and filled on refusal, so it decides the outcome; the
# write's own exit status can be lost when the refusal comes at close().
plugin=${LUNGS_CHECK_CALL%%.*}
method=${LUNGS_CHECK_CALL#*.}
dir=/opt/run-mounts/3tched/plugins/$plugin/operations/$method
before=$(ls "$TIMING" | grep -c '^block-.*\.json$')
outcome=$(incus exec "$SESSION" -- sh -c '
    printf "%s" "$1" >"$2/call" 2>/dev/null
    if [ -s "$2/error" ]; then printf "ERROR "; cat "$2/error"; else cat "$2/result"; fi' \
    sh "$LUNGS_CHECK_ARGS" "$dir" 2>&1)
case $outcome in
ERROR*) fail "$LUNGS_CHECK_CALL refused: ${outcome#ERROR }
      (pick a method this identity is granted with LUNGS_CHECK_CALL=plugin.method)" ;;
"") fail "$LUNGS_CHECK_CALL returned nothing" ;;
esac
pass "$LUNGS_CHECK_CALL through the lungs returned a result"

# Read the chain as host root, from the durable blocks the bridge writes:
# the newest blocks must hold this call, stamped with this identity's session.
event=$(ls "$TIMING" | grep '^block-.*\.json$' | sort | tail -n +$((before + 1)) |
    while read -r block; do jq -c --arg s "$SESSION" --arg m "$method" \
        'select(.data.metadata.session_id == $s and .data.metadata.method_name == $m)
        | .data.metadata' "$TIMING/$block"; done | tail -n 1)
[ -n "$event" ] || fail "no new chain block records $LUNGS_CHECK_CALL for session $SESSION"
pass "chain event $(printf '%s' "$event" | jq -r '.event_id') names actor $(printf '%s' "$event" | jq -r '.actor_id') for session $SESSION"
