#!/bin/sh
# Attach the SSH-TUN netdev to ovsbr0 after the tunnel endpoint exists.
# OVSDB is authoritative; this persists the port in /etc/openvswitch/conf.db.
set -eu
export PATH="/usr/local/bin:/usr/bin:/usr/sbin:${PATH:-}"
set -a
[ -r /etc/op-dbus/network.conf ] && . /etc/op-dbus/network.conf
[ -r /etc/op-dbus/warp-ssh.env ] && . /etc/op-dbus/warp-ssh.env
set +a

BRIDGE="${BRIDGE:-ovsbr0}"
TUN_PORT="${OVS_TUN_PORT:-tun5}"
TRANSPORT="${OVS_TUN_TRANSPORT_SERVICE:-op-warp-ssh-host}"
OVSDB_PORT="${OVSDB_PORT_HELPER:-/usr/local/libexec/3tched/ovsdb-port}"

sv start "$TRANSPORT" >/dev/null 2>&1 || true

i=0
until [ -d "/sys/class/net/$TUN_PORT" ]; do
    i=$((i + 1))
    [ "$i" -ge 120 ] && {
        echo "ovsbr0-tun5: $TUN_PORT did not appear after 120s (transport=$TRANSPORT)" >&2
        exit 1
    }
    sv start "$TRANSPORT" >/dev/null 2>&1 || true
    sleep 1
done

i=0
until [ -d "/sys/class/net/$BRIDGE" ]; do
    i=$((i + 1))
    [ "$i" -ge 60 ] && {
        echo "ovsbr0-tun5: bridge $BRIDGE missing after 60s" >&2
        exit 1
    }
    sleep 1
done

cur=$("$OVSDB_PORT" port-to-br "$TUN_PORT" 2>/dev/null) || cur=
if [ "$cur" = "$BRIDGE" ]; then
    echo "ovsbr0-tun5: $TUN_PORT already on $BRIDGE"
    exit 0
fi

# add-port stamps BRIDGE_MTU. The tunnel keeps the MTU it had when it appeared.
tun_mtu=$(cat "/sys/class/net/$TUN_PORT/mtu")
"$OVSDB_PORT" add-port "$BRIDGE" "$TUN_PORT"
"$OVSDB_PORT" set-mtu "$TUN_PORT" "$tun_mtu"
ip link set dev "$TUN_PORT" up 2>/dev/null || true
echo "ovsbr0-tun5: attached $TUN_PORT to $BRIDGE (mtu $tun_mtu)"
