#!/bin/sh
exec 2>&1
set -eu

# Authenticated MQTT wakes trigger chat-route only inside the already bound
# responder container. The relay never runs chat-route on the host.

wait_dep() {
    sv start "$1" >/dev/null 2>&1 || true
    i=0
    until sv check "$1" >/dev/null 2>&1; do
        i=$((i+1))
        [ "$i" -ge 90 ] && { echo "dependency $1 not ready after 90s" >&2; exit 1; }
        sleep 1
    done
}

# These owners must already have their existing identity/container and broker
# state ready. This service does not create storage, identities or grants.
wait_dep op-grpc-bridge
wait_dep emqx
wait_dep chatbot-identity

# Match the bridge's singleton identity derivation. Settings come from the
# existing per-setting store; no hard-coded principal or ambient human identity.
. /etc/profile.d/op-dbus-env.sh
: "${OP_CHATBOT_WIREGUARD_PUBKEY:?set /etc/op-dbus/env/op-chatbot-wireguard-pubkey}"
set -- $(/usr/local/bin/op-identity-accept derive --pubkey "$OP_CHATBOT_WIREGUARD_PUBKEY")
[ "$#" -eq 2 ] || { echo "unable to derive configured responder identity" >&2; exit 1; }
OP_CONTROL_PLANE_CHATBOT_SESSION_ID=$1
RESPONDER_PRINCIPAL_ID=$2
OP_CONTROL_PLANE_CHATBOT_WIREGUARD_PUBKEY=$OP_CHATBOT_WIREGUARD_PUBKEY
export OP_CONTROL_PLANE_CHATBOT_SESSION_ID RESPONDER_PRINCIPAL_ID
export OP_CONTROL_PLANE_CHATBOT_WIREGUARD_PUBKEY
set --

# The Rust relay refuses remote credential destinations and reads the exact
# existing authored SID1 itself; no credential enters argv or shell output.
MQTT_HOST="${OP_CHAT_RESPONDER_MQTT_HOST:-127.0.0.1}"
MQTT_PORT="${OP_CHAT_RESPONDER_MQTT_PORT:-1883}"
export MQTT_HOST MQTT_PORT
export RUST_LOG="${OP_CHAT_RESPONDER_LOG:-info}"

exec /usr/local/bin/op-chat-responder
