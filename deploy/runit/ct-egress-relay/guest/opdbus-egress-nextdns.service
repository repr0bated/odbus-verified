[Unit]
Description=Loopback TLS carrier for identity-bound NextDNS
Before=nextdns.service

[Service]
ExecStart=/usr/bin/socat TCP4-LISTEN:443,bind=127.0.0.3,reuseaddr,fork UNIX-CONNECT:/run/opdbus-egress/nextdns.sock
Restart=always
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
