#!/bin/sh
# op-dbus-release: application
# The controller publishes these shipped bytes to the canonical SHM catalog.
# The fresh runtime consumes this sealed catalog without resealing at startup.
# op-dbus-consumes: /usr/share/op-dbus/plugin-blobs
set -eu
exec 2>&1

startup_phase() {
    printf 'op-grpc-bridge startup phase=%s pid=%s\n' "$1" "$$"
}
startup_phase identity-selector

# Explicit root-owned initialization selector; absent during normal boot.
identity_init=/etc/op-dbus/initialize-local-human
unset OP_LOCAL_HUMAN_INITIALIZE_SESSION
if [ -e "$identity_init" ] || [ -L "$identity_init" ]; then
    [ ! -L "$identity_init" ] && [ -f "$identity_init" ] &&
        [ "$(stat -c %u:%g:%a "$identity_init")" = 0:0:600 ] &&
        [ "$(stat -c %s "$identity_init")" -le 37 ] || exit 1
    OP_LOCAL_HUMAN_INITIALIZE_SESSION=$(cat "$identity_init")
    export OP_LOCAL_HUMAN_INITIALIZE_SESSION
fi

# Operator-assigned NextDNS context for this exact WireGuard identity. This is
# sealed by MutationEngine, never supplied by the browser or inferred from DNS.
# An explicit [] enables legacy-only minting for a compatibility rollout.
if [ "${OP_IDENTITY_NEXTDNS_BINDINGS+x}" != x ]; then
    OP_IDENTITY_NEXTDNS_BINDINGS='[{"wireguard_pubkey":"0I5FNCuHAu62VctaNgOlJ7RgfejJpYe9Qd0VdPGesX8=","profile_id":"689ec7","device_name":"Ghostbridge-Incus"}]'
fi
export OP_IDENTITY_NEXTDNS_BINDINGS

DEFAULT_READY_PATH=/run/opdbus/runit-ready/op-grpc-bridge
rm -f -- "$DEFAULT_READY_PATH"

wait_dep() {
    startup_phase "dependency:$1"
    sv start "$1" >/dev/null 2>&1 || true
    i=0
    until sv check "$1" >/dev/null 2>&1; do
        i=$((i+1))
        [ "$i" -ge 90 ] && { echo "dependency $1 not ready after 90s" >&2; exit 1; }
        sleep 1
    done
    startup_phase "dependency-ready:$1"
}

# Nothing in the boot path calls back into this service: ovs-vswitchd
# materializes the topology from conf.db and the ovsbr0-* units use plain `ip`.
# That absence of a back-edge is what keeps this list cycle-free — check it with
# deploy/runit/check-dep-cycles.py before any reboot.
# Optional owners: waited for only when enabled in this host's runsvdir, so a
# host that does not ship one (e.g. antix1 runs threetched-gateway instead of
# the threetched daemon) still starts. identity-roots is deprecated.
wait_dep_if_enabled() {
    if [ -e "/etc/service/$1" ]; then wait_dep "$1"; else startup_phase "dependency-absent:$1"; fi
}
wait_dep opdbus-grants
wait_dep dbus
wait_dep ovsdb-server
wait_dep_if_enabled opdbus-rundirs
wait_dep_if_enabled unified-execution
wait_dep_if_enabled op-runit-systemctl
wait_dep_if_enabled op-session-bus
wait_dep_if_enabled threetched
wait_dep_if_enabled threetched-gateway
# Identity storage restoration is owned independently by identity-roots. The
# bridge waits for the storage owner's readiness before restoring active
# service identities. The storage owner never depends on this bridge.
# Qdrant is optional here. The bridge initializes its semantic shuttle
# best-effort and must still open :8090 for D-Bus and gRPC when vector search
# is unavailable.

startup_phase configuration
set -a
[ -r /etc/op-dbus/environment ] && . /etc/op-dbus/environment
[ -r /etc/op-dbus/decoy-network-client.env ] && . /etc/op-dbus/decoy-network-client.env
set +a

# A dedicated directory can be mounted through Incus without exposing the
# bridge's other runtime sockets. The bridge authenticates host callers or
# derives guest identity from kernel peer credentials and native Incus state.
export OPDBUS_LUNGS_SOCKET=/run/opdbus/lungs/lungs.sock
# The chatbot may own the listener while this runtime retains kernel admission.
lungs_owner=/etc/op-dbus/env/OPDBUS_LUNGS_OWNER
if [ -e "$lungs_owner" ] || [ -L "$lungs_owner" ]; then
    [ -f "$lungs_owner" ] && [ ! -L "$lungs_owner" ] &&
        [ "$(stat -c %u:%g:%a "$lungs_owner")" = 0:0:600 ] || exit 78
    OPDBUS_LUNGS_OWNER=$(cat "$lungs_owner")
    export OPDBUS_LUNGS_OWNER
fi
# The shared raw browser entry (spec ui-networking-authoritative-2026-11-27):
# accepted sockets go, unread, to the identity container waiting on lungs.
ingress_listen=/etc/op-dbus/env/OP_BROWSER_INGRESS_LISTEN
if [ -e "$ingress_listen" ] || [ -L "$ingress_listen" ]; then
    [ -f "$ingress_listen" ] && [ ! -L "$ingress_listen" ] &&
        [ "$(stat -c %u:%g:%a "$ingress_listen")" = 0:0:600 ] || exit 78
    OP_BROWSER_INGRESS_LISTEN=$(cat "$ingress_listen")
    export OP_BROWSER_INGRESS_LISTEN
fi

# The native router's provider-only generation protocol requires a real paired
# subject. Consume the operator-provisioned token from a root-only file; never
# accept the secret itself from the broad environment file.
export THREETCHED_RUNTIME_ENDPOINT="${THREETCHED_RUNTIME_ENDPOINT:-http://127.0.0.1:8084}"
export THREETCHED_RUNTIME_AGENT="${THREETCHED_RUNTIME_AGENT:-dashboard}"
# Door selection is not limited to OpenCode profiles.
export THREETCHED_REQUIRE_OPENCODE=0
startup_phase runtime-token
THREETCHED_RUNTIME_TOKEN_FILE=${THREETCHED_RUNTIME_TOKEN_FILE:-/etc/op-dbus/secrets/threetched-runtime-token}
unset THREETCHED_RUNTIME_TOKEN
if [ ! -f "$THREETCHED_RUNTIME_TOKEN_FILE" ] || [ -L "$THREETCHED_RUNTIME_TOKEN_FILE" ]; then
    echo "protected threetched runtime token file is missing or not a regular file" >&2
    exit 78
fi
set -- $(stat -Lc '%u %a' "$THREETCHED_RUNTIME_TOKEN_FILE")
[ "$1" -eq 0 ] && { [ "$2" = 400 ] || [ "$2" = 600 ]; } || {
    echo "threetched runtime token file must be root-owned with mode 0400 or 0600" >&2
    exit 78
}
THREETCHED_RUNTIME_TOKEN=$(cat "$THREETCHED_RUNTIME_TOKEN_FILE")
case "$THREETCHED_RUNTIME_TOKEN" in
    ''|*[!A-Za-z0-9._~-]*)
        echo "threetched runtime token file has an invalid token" >&2
        exit 78
        ;;
esac
[ "${#THREETCHED_RUNTIME_TOKEN}" -le 8192 ] || {
    echo "threetched runtime token exceeds its transport bound" >&2
    exit 78
}
export THREETCHED_RUNTIME_TOKEN
export OPDBUS_READY_PATH="${OPDBUS_READY_PATH:-$DEFAULT_READY_PATH}"
rm -f -- "$OPDBUS_READY_PATH"

# Exact browser origins allowed to reach gRPC-Web on this door. The historical
# setting name is retained for deployed configuration, not an MCP endpoint.
# No wildcard, reflected origin, or plaintext fallback is permitted.
export OP_MCP_ALLOWED_ORIGINS="${OP_MCP_ALLOWED_ORIGINS:-http://127.0.0.1:8080,http://localhost:8080,http://10.0.0.1:8080,http://10.0.0.2:8080,http://10.0.0.3:8080,http://10.0.0.4:8080,http://dashboard.ghostbridge.tech:8080,http://127.0.0.1:5173,http://localhost:5173}"


has_local_ipv4() {
    address=$1
    ip -4 -o addr show 2>/dev/null | awk -v wanted="$address" '
        {
            split($4, parts, "/")
            if (parts[1] == wanted) found = 1
        }
        END { if (found) exit 0; exit 1 }
    '
}


# The base-network owner supplies the private host endpoint. Application
# startup observes that address, not the transport or interface that delivers
# remote traffic to it. It must never create an interface, route or fallback
# public listener. Certificate filenames retain their tonic-svc0 names.
startup_phase private-addresses
elapsed=0
until has_local_ipv4 10.0.0.2; do
    elapsed=$((elapsed + 1))
    if [ "$elapsed" -ge "${OP_GRPC_3TCHED_WAIT_SECS:-90}" ]; then
        echo "private host door address 10.0.0.2 is not assigned; base-network owner must provision it" >&2
        exit 1
    fi
    sleep 1
done
startup_phase private-door-address-ready

# The door belongs to the door-owning container (the control-plane chatbot):
# its own tonic door ends TLS. This bridge owns the door tunnel (sealed plugin
# `tunnel`): 10.0.0.2:8090 is spliced over /run/opdbus/tunnel/tunnel.sock into
# that container. The host bridge's own tonic listens on loopback only, for
# host-local callers. Filesystem callers use OPDBUS_LUNGS_SOCKET.
# OP_TUNNEL_DOOR is what makes this bridge the tunnel owner
# (crates/op-grpc-bridge/src/runtime_tunnel.rs owns_tunnel_from_env); container
# bridges leave it unset and never start the tunnel owner.
FABRIC_BIND="127.0.0.1:8090"
export OP_GRPC_BRIDGE_LISTEN="$FABRIC_BIND"
export OP_TUNNEL_DOOR="10.0.0.2:8090"
export OP_TUNNEL_SOCKET=/run/opdbus/tunnel/tunnel.sock
# Comma-separated: every identity browser port is bound on each address
# (10.0.0.2 on ovsbr0, 100.96.0.5 the WARP address), over tonic to the
# identity's container through the shared browser socket. No socat.
export OP_BROWSER_DOOR=10.0.0.2,100.96.0.5
# Socketless bridge-hosted FUSE mounts (spec fusefs-socketless-dispatch):
# container:3tched_mount:threetched_mount:call_owner_uid[:store_root], ';'-separated.
# Optional override/disable knob only: unset or empty = auto-enumerate every
# committed identity (active+anchored sled, Running container) under
# /run/mounts/by-container/<native-name>/{3tchedFS,threetched}; an explicit
# entry wins over the auto spec for that same container; the value
# off/none/disabled turns bridge-hosted mounts off entirely. Never point an
# entry at /run/mounts/3tchedFS or /run/mounts/threetchedFS (standalone-owned).
export OP_FUSE_LOCAL_MOUNTS="${OP_FUSE_LOCAL_MOUNTS:-}"
unset OP_DBUS_GRPC_LISTEN THREETCHED_BIND_ADDR GRPC_BIND THREETCHED_UNIX_SOCKET
export THREETCHED_TLS_CERT_FILE="${THREETCHED_TLS_CERT_FILE:-/etc/op-dbus/tls/tonic-svc0.crt}"
export THREETCHED_TLS_KEY_FILE="${THREETCHED_TLS_KEY_FILE:-/etc/op-dbus/tls/tonic-svc0.key}"
unset THREETCHED_BROWSER_TLS_BIND_ADDR THREETCHED_BROWSER_TLS_CERT_FILE THREETCHED_BROWSER_TLS_KEY_FILE
# Legacy EMQX deployments may opt in to the authenticated private listener.
if [ -r /etc/op-dbus/env/op-emqx-exhook-enable ]; then
    OP_EMQX_EXHOOK_ENABLE=$(cat /etc/op-dbus/env/op-emqx-exhook-enable)
fi
export OP_EMQX_EXHOOK_ENABLE="${OP_EMQX_EXHOOK_ENABLE:-0}"
if [ "$OP_EMQX_EXHOOK_ENABLE" = 1 ]; then
    startup_phase emqx-prepare
    if [ -x /usr/local/libexec/op-dbus/helpers/emqx-prepare ]; then
        /usr/local/libexec/op-dbus/helpers/emqx-prepare
    fi
    export OP_EMQX_EXHOOK_BIND_ADDR=127.0.0.1:9000
    export OP_EMQX_EXHOOK_SERVER_CERT_FILE="${THREETCHED_TLS_CERT_FILE}"
    export OP_EMQX_EXHOOK_SERVER_KEY_FILE="${THREETCHED_TLS_KEY_FILE}"
    export OP_EMQX_EXHOOK_CLIENT_CA_FILE=/etc/emqx/certs/opdbus-ca.crt
    export OP_EMQX_EXHOOK_CLIENT_CERT_FILE=/etc/emqx/certs/emqx-exhook-client.crt
fi
# The bridge opens this append-only journal with mode 0600 and syncs every
# accepted nonce before dispatch. Keeping it outside tmpfs preserves replay
# rejection across service/process restarts.
export OP_AUTH_REPLAY_DB_PATH="${OP_AUTH_REPLAY_DB_PATH:-/var/lib/op-dbus/auth-replay.db}"
# The decoy endpoint and its certificate name are deployment inputs loaded
# above. All kernel WireGuard effects stay on that authenticated decoy owner.
export OP_DECOY_NATIVE_CA_FILE="${OP_DECOY_NATIVE_CA_FILE:-/etc/op-dbus/decoy-native/ca.pem}"
export OP_DECOY_NATIVE_CERT_FILE="${OP_DECOY_NATIVE_CERT_FILE:-/etc/op-dbus/decoy-native/bridge.pem}"
export OP_DECOY_NATIVE_KEY_FILE="${OP_DECOY_NATIVE_KEY_FILE:-/etc/op-dbus/decoy-native/bridge-key.pem}"
# The private Cozo root is a sibling of containers. Cozo enforces 0700 on its
# root, while Incus requires 0711 on the parent of unprivileged instances.
export IDENTITY_SLED_COZO_DB_PATH="${IDENTITY_SLED_COZO_DB_PATH:-/var/lib/incus/storage-pools/3tched-pool/identity-cozo}"
export OPDBUS_SNOWBALL_PATH="${OPDBUS_SNOWBALL_PATH:-/var/lib/opdbus/snowball}"
export OP_DBUS_CACHE_DIR="${OP_DBUS_CACHE_DIR:-/var/lib/opdbus/cache}"
export OPDBUS_CACHE_PLACEMENT="${OPDBUS_CACHE_PLACEMENT:-local}"
export OPDBUS_CACHE_MEMORY_POLICY="${OPDBUS_CACHE_MEMORY_POLICY:-default}"
export OPDBUS_NUMA_POLICY="${OPDBUS_NUMA_POLICY:-localalloc}"
export OP_IDENTITY_PROJECTION_GROUP="${OP_IDENTITY_PROJECTION_GROUP:-secrets}"
# jacob-bd nlm lives on the base system (deploy/notebooklm/install-base.sh), not in
# the release. Never put NOTEBOOKLM_COOKIES in this
# environment — those vars freeze stale auth over the on-disk profile.
unset NOTEBOOKLM_COOKIES NOTEBOOKLM_CSRF_TOKEN NOTEBOOKLM_SESSION_ID NOTEBOOKLM_COOKIE
export OP_NLM_BIN=/usr/local/lib/opdbus-notebooklm/bin/nlm
NLM_READY_DIR=/run/opdbus/runit-ready
install -d -m 0755 "$NLM_READY_DIR"
if [ -x "$OP_NLM_BIN" ]; then
    touch -- "$NLM_READY_DIR/notebooklm-mcp"
else
    rm -f -- "$NLM_READY_DIR/notebooklm-mcp"
fi
# The singleton control-plane chatbot's service identity: its key is the decoy
# WireGuard server key, kept once in the variable store. Session and
# principal ids are derived from the key, never configured separately.
. /etc/profile.d/op-dbus-env.sh
: "${OP_CHATBOT_WIREGUARD_PUBKEY:?set /etc/op-dbus/env/op-chatbot-wireguard-pubkey}"
export OP_CONTROL_PLANE_CHATBOT_WIREGUARD_PUBKEY="$OP_CHATBOT_WIREGUARD_PUBKEY"
set -- $(/usr/local/bin/op-identity-accept derive --pubkey "$OP_CHATBOT_WIREGUARD_PUBKEY")
export OP_CONTROL_PLANE_CHATBOT_SESSION_ID="$1" OP_CONTROL_PLANE_CHATBOT_PRINCIPAL_ID="$2"
set --
# Provider credential-slot maintenance writes this host-owned configuration.
# It must not point into the read-only release target.
export OP_MODEL_PROVIDERS_PATH="${OP_MODEL_PROVIDERS_PATH:-/etc/op-dbus/model-providers.toml}"
# Owner-selected browser transport peer. The receiver requires a fresh signed
# Oracle proof from this exact public key before selecting the existing
# chatbot identity; this is not the chatbot's key or a browser credential.
export OP_BROWSER_CONTROL_PLANE_PEER_KEY="${OP_BROWSER_CONTROL_PLANE_PEER_KEY:-4V4Wob4v8YxCcQ4nz95Jt3b/aQcAInLq+ABIvvS7/Qg=}"
# Local interactive clients, including Codex, authenticate as the existing
# human WireGuard principal. The MutationEngine mints SID1 into this same sled;
# there is deliberately no Codex-specific service identity.
export OP_LOCAL_HUMAN_WIREGUARD_PUBKEY="${OP_LOCAL_HUMAN_WIREGUARD_PUBKEY:-0I5FNCuHAu62VctaNgOlJ7RgfejJpYe9Qd0VdPGesX8=}"
human_binding=$(/usr/local/bin/op-identity-accept derive --pubkey "$OP_LOCAL_HUMAN_WIREGUARD_PUBKEY")
set -- $human_binding
export OP_LOCAL_HUMAN_SESSION_ID="$1" OP_LOCAL_HUMAN_PRINCIPAL_ID="$2"
unset human_binding
set --
export OP_LOCAL_HUMAN_DISPLAY_ALIAS="${OP_LOCAL_HUMAN_DISPLAY_ALIAS:-jeremy-wg-f036}"
# Transport source addresses do not prove the originating human peer.
# Bind OIA1 to the trusted decoy signature, short lifetime, one-time nonce, and
# registered human key rather than TCP-source equality.
export OP_ORACLE_ASSERTION_SOURCE_BINDING="${OP_ORACLE_ASSERTION_SOURCE_BINDING:-trusted-decoy-signature}"
export RUST_LOG="${GRPC_RUST_LOG:-info}"
# FUSE callers enter through the authenticated lungs socket above. These URLs
# select the bridge's native Qdrant backend: HTTP for the qdrant plugin and
# gRPC for the cognitive shuttle. They are not client-facing lungs addresses.
export QDRANT_HTTP_URL="${QDRANT_HTTP_URL:-http://127.0.0.1:6333}"
export QDRANT_GRPC_URL="${QDRANT_GRPC_URL:-http://127.0.0.1:6334}"
export COGNITIVE_QDRANT_URL="${COGNITIVE_QDRANT_URL:-$QDRANT_GRPC_URL}"
# The clean baseline uses source indexed through cognitive.code_index.
# Historical bulk collections are retained for recovery; their Gridstore
# payload reads currently fail, so they must not stall normal context calls.
export COGNITIVE_RAG_COLLECTION="${COGNITIVE_RAG_COLLECTION:-opdbus_baseline_code_v1}"
export COGNITIVE_COMPLETION_COLLECTIONS="${COGNITIVE_COMPLETION_COLLECTIONS:-$COGNITIVE_RAG_COLLECTION}"
export COGNITIVE_SEARCH_COLLECTIONS="${COGNITIVE_SEARCH_COLLECTIONS:-$COGNITIVE_RAG_COLLECTION}"
[ -r /etc/op-dbus/secrets/voyage-api-key ] && export VOYAGE_API_KEY="$(cat /etc/op-dbus/secrets/voyage-api-key)"
# Phase 2: tool dispatch is in-process ToolRegistry — no HTTP MCP loopback URL.

# Compliance SPA + Cozo proxy on the door Axum stack (/compliance, /compliance/api).
export CC_COMPLIANCE_STATIC_DIR="${CC_COMPLIANCE_STATIC_DIR:-/usr/local/share/op-dbus/dashboard/compliance}"
export CC_COZO_UPSTREAM="${CC_COZO_UPSTREAM:-http://127.0.0.1:8787}"

# These are runtime requirements, not merely build-host packages. Fail with a
# precise error on a received golden image instead of silently dropping the
# Btrfs/NUMA path when a target is missing a dependency.
startup_phase storage-preflight
for command_name in btrfs findmnt numactl taskset; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "required runtime command is missing: $command_name" >&2
        exit 127
    fi
done

# Owner 2026-11-19: snowball is sled-backed, not Btrfs, and op-cache uses a
# plain directory on non-Btrfs storage; no shared-Btrfs storage gate here.

case "$OPDBUS_NUMA_POLICY" in
    localalloc|interleave|default|disabled|none) ;;
    *)
        echo "unsupported OPDBUS_NUMA_POLICY: $OPDBUS_NUMA_POLICY" >&2
        exit 64
        ;;
esac

umask 0077

startup_phase "exec:$OPDBUS_NUMA_POLICY"
case "$OPDBUS_NUMA_POLICY" in
    localalloc)
        exec numactl --localalloc /usr/local/libexec/op-dbus/bin/op-grpc-bridge
        ;;
    interleave)
        exec numactl --interleave=all /usr/local/libexec/op-dbus/bin/op-grpc-bridge
        ;;
    default|disabled|none)
        exec /usr/local/libexec/op-dbus/bin/op-grpc-bridge
        ;;
esac
