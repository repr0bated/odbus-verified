# Residential proxy credentials for `decoy-egress proxy` (IPRoyal geo endpoint).
# Install as /etc/xray/egress-proxy.env on the decoy, root-owned, mode 0600.
# The geo (country[,country] and optional city) is appended to the PASSWORD by
# the toggle; PROXY_COUNTRY/PROXY_CITY are the defaults when none are given on
# the command line.
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USER=<iproyal-username>
PROXY_PASS=<iproyal-password>
PROXY_COUNTRY=us
PROXY_CITY=fortlauderdale
