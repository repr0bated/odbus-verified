# Staged host iptables. SSH administration enters through loopback or the
# existing private TUN at 10.0.0.2; direct public SSH remains blocked.
# Live path: /etc/iptables/iptables.rules (iptables-nft restores this on boot).
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -p tcp -m tcp --dport 22 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment ssh-est -j ACCEPT
-A INPUT -i lo -p tcp -m tcp --dport 22 -m comment --comment ssh-lo -j ACCEPT
-A INPUT -i tun5 -s 10.0.0.0/24 -d 10.0.0.2/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment op-warp-ssh/private-ssh -j ACCEPT
-A INPUT -i tun5 -s 192.168.254.2/32 -d 10.0.0.2/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment op-warp-ssh/private-ssh -j ACCEPT
-A INPUT -i tun5 -s 192.168.255.2/32 -d 10.0.0.2/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment op-warp-ssh/private-ssh -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -m comment --comment ssh-public -j DROP
-A INPUT -p tcp -m tcp --dport 8444 -m comment --comment decoy-xhttp -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
COMMIT
