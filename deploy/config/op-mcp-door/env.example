# One variable per file under /etc/op-dbus/env/<NAME> (file content = value).
# Example only; nothing here is live. No secret values belong in this file.
OP_MCP_DOOR_LISTEN=127.0.0.1:8091
# Falls back to THREETCHED_TLS_CERT_FILE / THREETCHED_TLS_KEY_FILE, then the door defaults.
OP_MCP_DOOR_TLS_CERT_FILE=/var/lib/op-dbus/door-tls/door.crt
OP_MCP_DOOR_TLS_KEY_FILE=/var/lib/op-dbus/door-tls/door.key
OP_MCP_DOOR_CONFIG_DIR=/etc/opdbus/mcp-door
OP_MCP_DOOR_STATE_DIR=/dev/shm/opdbus/mcp-door
OP_MCP_DOOR_GRANTS_DOCUMENT=/dev/shm/opdbus/capability-grants.json
OP_MCP_TOOLSETS_PATH=/etc/opdbus/mcp-toolsets.json
OP_MCP_DOOR_ALLOWED_ORIGINS=
OP_MCP_DOOR_PUBLIC_RATE=60
OP_MCP_DOOR_MAX_BODY=2097152
# Vector readiness of the hot coding/knowledge tools (read-only probe).
# Qdrant REST (not the 6334 gRPC port); http:// only.
OP_MCP_QDRANT_REST_URL=http://127.0.0.1:6333
# Optional: path to a file holding the Qdrant API key (the key never goes here).
OP_MCP_QDRANT_API_KEY_FILE=
# Optional comma-separated override of the coding collections.
OP_MCP_CODING_COLLECTIONS=
# Use the same private footprint index path as the receive hook.
OPDBUS_FOOTPRINT_COZO_PATH=/var/lib/opdbus/snowball-footprint-index
