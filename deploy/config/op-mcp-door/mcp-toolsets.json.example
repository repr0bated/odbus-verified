    {
      "id": "plugin:adc",
      "title": "Every adc operation",
      "temperature": "cold",
      "tools": [
        "adc.get_status"
      ]
    },
    {
      "id": "plugin:agent_config",
      "title": "Every agent_config operation",
      "temperature": "cold",
      "tools": [
        "agent_config.get_config",
        "agent_config.list_tools",
        "agent_config.register_tool",
        "agent_config.reset_config",
        "agent_config.update_config"
      ]
    },
    {
      "id": "plugin:antigravity",
      "title": "Every antigravity operation",
      "temperature": "cold",
      "tools": [
        "antigravity.configure_safety",
        "antigravity.get_auth_status",
        "antigravity.get_usage_report"
      ]
    },
    {
      "id": "plugin:antigravity_chat",
      "title": "Every antigravity_chat operation",
      "temperature": "cold",
      "tools": [
        "antigravity_chat.configure",
        "antigravity_chat.get_bridge_status",
        "antigravity_chat.refresh_token"
      ]
    },
    {
      "id": "plugin:btrfs",
      "title": "Every btrfs operation",
      "temperature": "cold",
      "tools": [
        "btrfs.balance_start",
        "btrfs.balance_status",
        "btrfs.create_subvolume",
        "btrfs.delete_subvolume",
        "btrfs.device_add",
        "btrfs.device_remove",
        "btrfs.filesystem_df",
        "btrfs.filesystem_usage",
        "btrfs.list_subvolumes",
        "btrfs.scrub_start",
        "btrfs.scrub_status",
        "btrfs.snapshot"
      ]
    },
    {
      "id": "plugin:chat_response",
      "title": "Every chat_response operation",
      "temperature": "cold",
      "tools": [
        "chat_response.cannot_perform",
        "chat_response.get_conversation",
        "chat_response.get_turn_response",
        "chat_response.list_conversations",
        "chat_response.list_pending_turns",
        "chat_response.request_clarification",
        "chat_response.respond_to_user",
        "chat_response.start_conversation",
        "chat_response.submit_turn"
      ]
    },
    {
      "id": "plugin:chat_router",
      "title": "Every chat_router operation",
      "temperature": "cold",
      "tools": [
        "chat_router.Chat",
        "chat_router.GetConfig",
        "chat_router.GetMcpConfig",
        "chat_router.GetModelRoutes",
        "chat_router.GetRouter",
        "chat_router.GetState",
        "chat_router.GetStructuredOutput",
        "chat_router.GetTools",
        "chat_router.ListModels",
        "chat_router.ListProviders",
        "chat_router.ListUiSurfaces",
        "chat_router.PatchConfig",
        "chat_router.ResolveRoute",
        "chat_router.SetCozoRetrievalModel",
        "chat_router.SetModel",
        "chat_router.SetObfuscationModel",
        "chat_router.SetOvsRoutingModel",
        "chat_router.SetProvider",
        "chat_router.SetQdrantRetrievalModel",
        "chat_router.SetSelection",
        "chat_router.SetVectorizationModel",
        "chat_router.apply_catalog_model_binding",
        "chat_router.cancel_generation",
        "chat_router.config_get",
        "chat_router.config_init",
        "chat_router.config_list",
        "chat_router.config_migrate",
        "chat_router.config_patch",
        "chat_router.config_set",
        "chat_router.delete_generation_job",
        "chat_router.get_generation_job",
        "chat_router.get_generation_jobs",
        "chat_router.get_own_agent_route",
        "chat_router.recover_generation_jobs",
        "chat_router.resolve_catalog_model_binding",
        "chat_router.start_generation"
      ]
    },
    {
