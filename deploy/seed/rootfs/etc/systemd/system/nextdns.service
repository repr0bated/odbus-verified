[Unit]
Description=NextDNS client (profile and device from the sealed identity, NDN1)
# The context comes only from the read-only identity sled at /agent/user and
# the decoy trust store; nothing is configured from the network or the host.
ConditionPathExists=/agent/user/issued_identity.iid1
ConditionPathExists=/etc/op-dbus/decoy-trust.json
After=opdbus-lo.service
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
ExecStart=/usr/local/libexec/op-dbus/nextdns-run
Restart=always
RestartSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
