[Unit]
Description=3tchedFS sealed plugin mount
After=local-fs.target systemd-tmpfiles-setup.service dbus.service
Before=network-pre.target op-grpc-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=3tchedfs-3tchedFS
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0755 /run/mounts/3tchedFS
ExecStartPre=/usr/local/libexec/op-dbus/bin/3tched-fs capture --store /run/3tchedfs-3tchedFS --schema-only --catalog /var/lib/opdbus/plugin-blobs --state /dev/shm/opdbus/state
ExecStart=/usr/local/libexec/op-dbus/bin/3tched-fs mount --store /run/3tchedfs-3tchedFS --fs-name 3tchedFS --surface 3tched --catalog /var/lib/opdbus/plugin-blobs --state /dev/shm/opdbus/state --allow-other --auto-unmount --lungs-socket /run/opdbus/lungs/lungs.sock /run/mounts/3tchedFS
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
