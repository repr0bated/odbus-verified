[Unit]
Description=Identity owner door (op-grpc-bridge) on 10.0.0.2:8090
After=opdbus-lo.service 3tchedfs.service threetchedfs.service door-tls-init.service
Requires=opdbus-lo.service 3tchedfs.service threetchedfs.service door-tls-init.service

[Service]
Type=simple
EnvironmentFile=/etc/op-dbus/bridge.env
RuntimeDirectory=op-grpc-bridge
ExecStart=/usr/local/libexec/op-dbus/bin/op-grpc-bridge
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
