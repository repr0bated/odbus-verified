#!/bin/sh
### BEGIN INIT INFO
# Provides:          op-release-startup-finish
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: Resume the parked release install before services start
### END INIT INFO
# rcS S11, after mountall and before op-release-activate mounts the committed slot.
case "${1:-start}" in
    start)
        /srv/git/odbus-verified/deploy/release/startup-finish.sh install || true
        ;;
    stop|restart|force-reload) ;;
    *) printf '%s\n' 'usage: op-release-startup-finish {start|stop|restart|force-reload}' >&2; exit 2 ;;
esac
exit 0
