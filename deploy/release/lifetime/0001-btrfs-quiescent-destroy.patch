+static void btrfs_close_orphan_root(struct btrfs_root *root)
+{
+	spin_lock(&root->fs_info->fs_roots_radix_lock);
+	if (!test_and_set_bit(BTRFS_ROOT_QUIESCING, &root->state))
+		list_add_tail(&root->quiesce_list, &root->fs_info->quiescing_roots);
+	spin_unlock(&root->fs_info->fs_roots_radix_lock);
+}
+
+/*
+ * The caller holds the parent and victim inode locks and subvol_sem.
+ * On success quiesce_sem remains write-locked until the unlink completes.
+ *
+ * Counts are a census of inode objects, not opens. An inode remains counted
+ * while any mount, dentry, file, mapping or deferred file transfer retains it,
+ * including objects no longer present in root->inodes. New publication and
+ * cached btrfs_iget acquisitions cannot cross the write side of this gate.
+ */
+static int btrfs_quiesce_subvolume(struct dentry *dentry, bool *was_hashed)
+{
+	struct inode *inode = d_inode(dentry);
+	struct btrfs_root *root = BTRFS_I(inode)->root;
+	struct btrfs_root *other;
+	bool exclusive;
+	int ret = -EBUSY;
+
+	if (!down_write_trylock(&root->quiesce_sem))
+		return -EBUSY;
+	spin_lock(&root->fs_info->fs_roots_radix_lock);
+	if (test_bit(BTRFS_ROOT_QUIESCING, &root->state)) {
+		ret = -ESTALE;
+		goto unlock_registry;
+	}
+	/*
+	 * Reject a preexisting duplicate or unfinished constructor. New root
+	 * allocations inherit closure under this same registry lock; they
+	 * cannot subsequently publish a stale pre-unlink root-item copy.
+	 */
+	list_for_each_entry(other, &root->fs_info->lifetime_roots, lifetime_list) {
+		if (other != root && other->lifetime_id == root->lifetime_id &&
+		    refcount_read(&other->refs) != 0)
+			goto unlock_registry;
+	}
+	set_bit(BTRFS_ROOT_QUIESCING, &root->state);
+	list_add_tail(&root->quiesce_list, &root->fs_info->quiescing_roots);
+	spin_unlock(&root->fs_info->fs_roots_radix_lock);
+
+	/*
+	 * Do not invalidate: that would detach someone else's mounted tree.
+	 * Unhash only, then drain pre-unhash RCU path walks before interpreting
+	 * dentry reference counts. The parent inode lock excludes a replacement
+	 * lookup/rename, so failure can rehash this exact dentry for its holders.
+	 */
+	*was_hashed = !d_unhashed(dentry);
+	d_drop(dentry);
+	synchronize_rcu();
+	shrink_dcache_parent(dentry);
+	btrfs_prune_dentries(root);
+
+	if (atomic_long_read_acquire(&root->live_inodes) != 1)
+		goto busy;
+
+	/*
+	 * The deletion's own root is the only allowed object. It must have no
+	 * independently retained inode or dentry alias. Test both counts under
+	 * their locks together: separate samples could miss a reference being
+	 * transferred from a dentry to its inode. Unhashed + drained RCU + the
+	 * publication gate means no new external owner can appear after this.
+	 */
+	spin_lock(&inode->i_lock);
+	spin_lock(&dentry->d_lock);
+	exclusive = icount_read(inode) == 1 &&
+		    dentry->d_lockref.count == 1 && d_unhashed(dentry);
+	spin_unlock(&dentry->d_lock);
+	spin_unlock(&inode->i_lock);
+	if (exclusive)
+		return 0;
+busy:
+	if (*was_hashed)
+		d_rehash(dentry);
+	btrfs_reopen_root(root);
+	up_write(&root->quiesce_sem);
+	return ret;
+unlock_registry:
+	spin_unlock(&root->fs_info->fs_roots_radix_lock);
+	up_write(&root->quiesce_sem);
+	return ret;
+}
