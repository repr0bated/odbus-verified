+static int btrfs_ioctl_snap_destroy_quiescent(struct file *file, void __user *arg)
+{
+	struct btrfs_fs_info *fs_info = inode_to_fs_info(file_inode(file));
+	struct btrfs_ioctl_quiescent_destroy_args expected;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&expected, arg, sizeof(expected)))
+		return -EFAULT;
+	if (expected.flags || memchr_inv(expected.reserved, 0, sizeof(expected.reserved)))
+		return -EINVAL;
+	if (expected.subvolid < BTRFS_FIRST_FREE_OBJECTID ||
+	    expected.subvolid > BTRFS_LAST_FREE_OBJECTID)
+		return -EINVAL;
+	if (memcmp(fs_info->fs_devices->fsid, expected.fsid, BTRFS_FSID_SIZE))
+		return -ESTALE;
+	if (BTRFS_FS_ERROR(fs_info))
+		return -EIO;
+	ret = btrfs_ioctl_snap_destroy(file, NULL, true, &expected);
+	if (ret == -ENOENT)
+		ret = btrfs_quiesce_absent_subvolume(fs_info, &expected);
+	if (ret && BTRFS_FS_ERROR(fs_info))
+		ret = -EIO;
+	return ret;
+}
