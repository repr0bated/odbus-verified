+		struct btrfs_root *next = NULL;
+		struct list_head *pos;
+		bool ready = false;
+
+		/*
+		 * Pin the cursor across sleeping cache eviction. Final removal
+		 * takes this lock, and grab_root cannot revive a zero refcount.
+		 * A zero-ref object has no live inode: each inode owns a root ref
+		 * until after its census decrement and irreversible teardown.
+		 */
+		spin_lock(&fs_info->fs_roots_radix_lock);
+		for (pos = cursor->next; pos != &fs_info->lifetime_roots;
+		     pos = pos->next) {
+			struct btrfs_root *candidate;
+
+			candidate = list_entry(pos, struct btrfs_root, lifetime_list);
+			if (candidate->lifetime_id != args->subvolid)
+				continue;
+			next = btrfs_grab_root(candidate);
+			if (next) {
+				ready = test_bit(BTRFS_ROOT_LIFETIME_READY, &next->state);
+				break;
+			}
+		}
+		/* This final census and reopening constructors are one event. */
+		if (!next)
+			fs_info->absent_quiesce_id = 0;
+		spin_unlock(&fs_info->fs_roots_radix_lock);
+		btrfs_put_root(root);
+		root = next;
+		if (!root)
+			break;
+		cursor = &root->lifetime_list;
+		/* Root-item identity is not stable until canonical publication. */
+		if (!ready) {
+			ret = -EBUSY;
+			goto out;
+		}
+
+		if (btrfs_root_refs(&root->root_item) != 0 ||
+		    memcmp(root->root_item.uuid, args->uuid, BTRFS_UUID_SIZE) ||
+		    memcmp(root->root_item.received_uuid, args->received_uuid,
+			   BTRFS_UUID_SIZE)) {
+			ret = -ESTALE;
+			goto out;
+		}
+		if (!btrfs_root_readonly(root)) {
+			ret = -EROFS;
+			goto out;
+		}
+		if (!down_write_trylock(&root->quiesce_sem)) {
+			ret = -EBUSY;
+			goto out;
+		}
+		/*
+		 * Orphans cannot be rolled back into linked subvolumes. Keep
+		 * admission closed even on EBUSY, allowing existing owners to
+		 * drain without permitting new inode publication.
+		 */
+		btrfs_close_orphan_root(root);
+		btrfs_prune_dentries(root);
+		ret = atomic_long_read_acquire(&root->live_inodes) ? -EBUSY : -ENOENT;
+		up_write(&root->quiesce_sem);
+		if (ret != -ENOENT)
+			goto out;
+	}
+	/*
+	 * Surviving objects stay closed. After their final put, a new canonical
+	 * reader can see only an orphan or no root item (check_ref rejects both).
+	 * Temporary commit-root readers cannot publish inodes without READY.
+	 */
+	if (BTRFS_FS_ERROR(fs_info))
+		ret = -EIO;
+out:
+	spin_lock(&fs_info->fs_roots_radix_lock);
+	fs_info->absent_quiesce_id = 0;
+	spin_unlock(&fs_info->fs_roots_radix_lock);
+	btrfs_put_root(root);
+	btrfs_put_root(cached);
+	up_write(&fs_info->subvol_sem);
+	btrfs_free_path(path);
+	return ret;
+}
