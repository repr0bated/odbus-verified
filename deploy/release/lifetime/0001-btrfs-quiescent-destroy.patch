+int btrfs_quiesce_absent_subvolume(struct btrfs_fs_info *fs_info,
+				  const struct btrfs_ioctl_quiescent_destroy_args *args)
+{
+	struct btrfs_root *root = NULL;
+	struct btrfs_root *cached = NULL;
