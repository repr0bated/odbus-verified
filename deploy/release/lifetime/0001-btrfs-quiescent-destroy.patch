+/*
+ * Do not wait behind quiescent deletion: callers can already hold filesystem
+ * transaction/inode locks. A successful admission stays held until the inode
+ * is accounted and its reference has been handed to the caller.
+ */
+static int btrfs_inode_admit(struct btrfs_root *root)
+{
+	if (!down_read_trylock(&root->quiesce_sem))
+		return -EBUSY;
+	if (test_bit(BTRFS_ROOT_QUIESCING, &root->state) ||
+	    (btrfs_is_fstree(root->lifetime_id) &&
+	     !test_bit(BTRFS_ROOT_LIFETIME_READY, &root->state))) {
+		up_read(&root->quiesce_sem);
+		return -ESTALE;
+	}
+	return 0;
+}
