# Paste these into the Claude cloud environment variable form.
# They are build settings, not credentials. Do not add host .env files,
# identity keys, grants, or live service endpoints.
CXXFLAGS=-include cstdint
RUSTUP_TOOLCHAIN=1.97.1
CARGO_HOME=/usr/local/cargo
RUSTUP_HOME=/usr/local/rustup
CARGO_BUILD_JOBS=2
CARGO_TERM_COLOR=never
RUST_BACKTRACE=1
