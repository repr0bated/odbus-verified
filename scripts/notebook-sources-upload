#!/bin/sh
# Compatibility push entry point for the explicit mounted per-model sync.
# The former series state is preserved; it is never adopted by this wrapper.
set -eu
if [ "$#" -ne 0 ]; then
    echo 'notebook-sources-upload: no options supported; legacy -n dry run is retired (no remote calls made)' >&2
    exit 1
fi
SCRIPT_PATH=$(readlink -f -- "$0")
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
exec "$SCRIPT_DIR/notebook-sources-sync-up"
