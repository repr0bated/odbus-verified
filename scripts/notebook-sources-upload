#!/bin/sh
# notebook-sources-upload — send the session sources to a tagged series of
# NotebookLM notebooks, replacing only what changed.
#
# notebook-sources-cleanup leaves each LLM folder with:
#   <llm>/_live.md          the live feed: replaced here when its content changes
#   <llm>/_bundle_NNN.md    frozen history: uploaded once, never replaced
# Nothing else (archived sessions, legacy bundles) is ever a source.
#
# The notebooks form a series tagged $SERIES_TAG. When the current notebook
# would pass $MAX_SOURCES it is retired (tagged "retired", never written
# again, its last live feeds frozen with it) and the next notebook starts,
# with the live feeds re-added there. Search the whole series with the
# notebooklm plugin's cross_notebook_query and tags=$SERIES_TAG.
#
# State: $ROOT/.upload-state.json. Usage: notebook-sources-upload [-n]  (-n: dry run)
set -eu

ROOT=${NOTEBOOKLM_SOURCES_DIR:-/home/jeremy/.notebooklm-sources}
STATE=$ROOT/.upload-state.json
SERIES_TAG=${NLM_SERIES_TAG:-llm-sessions}
TITLE=${NOTEBOOK_TITLE:-3tched LLM Sessions}
MAX_SOURCES=${NLM_MAX_SOURCES:-300}
NLM=${NLM:-nlm}
DRY=0
[ "${1:-}" = -n ] && DRY=1

log() { printf 'notebook-sources-upload: %s\n' "$*"; }
run() { if [ "$DRY" = 1 ]; then log "would run: $*"; return 0; fi; "$@"; }
hash_of() { sha256sum "$1" | cut -c1-16; }
state() { jq -r "$@" "$STATE"; }
set_state() {
    [ "$DRY" = 1 ] && return 0
    jq "$@" "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

[ -f "$STATE" ] || printf '{"current":null,"series":[],"live":{},"frozen":{}}\n' >"$STATE"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

# Upload one file under a readable title (<llm>-live.md, <llm>-bundle-001.md)
# and print its source id.
add_source() {
    notebook=$1 path=$2 title=$3
    if [ "$DRY" = 1 ]; then printf 'dry-%s' "$title"; return 0; fi
    cp "$path" "$STAGE/$title"
    "$NLM" source add "$notebook" --file "$STAGE/$title" --json | jq -er '.source_id'
}

new_notebook() {
    n=$(($(state '.series | length') + 1))
    if [ "$DRY" = 1 ]; then printf 'dry-notebook-%s' "$n"; return 0; fi
    id=$("$NLM" notebook create "$TITLE #$n" --json | jq -er '.notebook_id')
    "$NLM" tag add "$id" --tags "$SERIES_TAG" >/dev/null
    printf '%s' "$id"
}

current=$(state '.current // empty')
if [ -z "$current" ]; then
    current=${OP_NOTEBOOK_ID:-}
    if [ -n "$current" ]; then
        run "$NLM" tag add "$current" --tags "$SERIES_TAG" >/dev/null
    else
        current=$(new_notebook)
    fi
    set_state --arg id "$current" '.current = $id | .series += [{id: $id, retired: false}]'
    log "series starts with notebook $current"
fi

# What this cycle adds: frozen bundles not yet uploaded, and live feeds not
# yet in the current notebook. A changed live feed is a replace (net zero).
new_frozen=$(for f in "$ROOT"/*/_bundle_[0-9]*.md; do
    [ -f "$f" ] || continue
    key=${f#"$ROOT"/}
    [ "$(state --arg k "$key" '.frozen[$k] // empty')" ] || printf '%s\n' "$key"
done)
new_live=$(for f in "$ROOT"/*/_live.md; do
    [ -f "$f" ] || continue
    key=${f#"$ROOT"/}
    [ "$(state --arg k "$key" '.live[$k].source_id // empty')" ] || printf '%s\n' "$key"
done)
adding=$(printf '%s\n%s\n' "$new_frozen" "$new_live" | grep -c . || true)

if [ "$DRY" = 1 ] && [ "${current#dry-}" != "$current" ]; then
    count=0
else
    count=$("$NLM" notebook get "$current" --json | jq -er '.source_count')
fi
if [ $((count + adding)) -gt "$MAX_SOURCES" ]; then
    # Retire: the old notebook keeps everything it holds, including its last
    # live feeds, and is never written again.
    run "$NLM" tag add "$current" --tags "$SERIES_TAG,retired" >/dev/null
    old=$current
    current=$(new_notebook)
    set_state --arg old "$old" --arg id "$current" \
        '.series |= map(if .id == $old then .retired = true else . end)
         | .series += [{id: $id, retired: false}] | .current = $id | .live = {}'
    log "retired $old at $count sources; now writing to $current"
    new_live=$(for f in "$ROOT"/*/_live.md; do [ -f "$f" ] && printf '%s\n' "${f#"$ROOT"/}"; done)
fi

for key in $new_frozen; do
    llm=${key%%/*} base=${key##*/}
    title="$llm-${base#_}"; title=$(printf '%s' "$title" | tr '_' '-')
    id=$(add_source "$current" "$ROOT/$key" "$title")
    set_state --arg k "$key" --arg id "$id" --arg nb "$current" '.frozen[$k] = {source_id: $id, notebook: $nb}'
    log "froze $key as $id"
done

for f in "$ROOT"/*/_live.md; do
    [ -f "$f" ] || continue
    key=${f#"$ROOT"/} llm=${key%%/*}
    hash=$(hash_of "$f")
    old_id=$(state --arg k "$key" '.live[$k].source_id // empty')
    [ -n "$old_id" ] && [ "$(state --arg k "$key" '.live[$k].hash')" = "$hash" ] && continue
    # Add the new copy before removing the old one, so the feed is never absent.
    id=$(add_source "$current" "$f" "$llm-live.md")
    [ -n "$old_id" ] && run "$NLM" source delete "$old_id" --confirm --json >/dev/null
    set_state --arg k "$key" --arg id "$id" --arg h "$hash" '.live[$k] = {source_id: $id, hash: $h}'
    if [ -n "$old_id" ]; then log "replaced $key: $old_id -> $id"; else log "added $key as $id"; fi
done
log "done; current notebook $current"
