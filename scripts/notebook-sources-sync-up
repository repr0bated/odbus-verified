#!/bin/sh
# One explicit per-model capture/sync cycle; failure is a failed cycle.
set -eu
SCRIPT_PATH=$(readlink -f -- "$0")
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
if [ "${OPDBUS_NOTEBOOK_SYNC_MODE:-}" != per-model ]; then
    echo 'notebook-sources-sync: OPDBUS_NOTEBOOK_SYNC_MODE=per-model is required' >&2
    exit 1
fi
: "${NOTEBOOKLM_SOURCES_DIR:?NOTEBOOKLM_SOURCES_DIR is required}"
: "${OPDBUS_NOTEBOOK_PROJECT_ROOT:?OPDBUS_NOTEBOOK_PROJECT_ROOT is required}"
: "${OPDBUS_NOTEBOOK_FS_ROOT:?OPDBUS_NOTEBOOK_FS_ROOT is required}"
: "${OPDBUS_NOTEBOOK_SESSION_ID:?OPDBUS_NOTEBOOK_SESSION_ID is required}"
exec "$SCRIPT_DIR/notebook-sync" ingest
